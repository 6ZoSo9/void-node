        }catch(e){ res.json({ ok:false, error:String(e) }); }
      });

      console.log("[diag] attached /dev/blocks/:n/txs/persisted");
    })();
  }catch(e){ console.warn("[diag] persisted txs attach failed:", e); }
})();
