// ---------------- [ADD] /blocks/latest/number.json (JSON mirror) ----------------
(function installLatestNumberJson(){
  try{
    const g:any = globalThis as any;
    let tries = 0;
    (function arm(){
      const app:any = g.__void_http_app || g.app;
