        const candidatesInternal= ["propose","tick","tickNow","sealNext"];

        let any = false;
        for (const k of candidatesReturn)   any = wrapReturnBlock(n,k) || any;
        for (const k of candidatesInternal) any = wrapInternalBuild(n,k) || any;

