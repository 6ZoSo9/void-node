        if (!/^[0-9a-f]{64}$/.test(hash)) return res.json({ ok: false, error: "bad hash" });
        const shards = (((globalThis as any).__void_node || (globalThis as any).node) as any).txIndex.listShards().sort((a: any, b: any) => b.from - a.from);
