    try {
      const r =
        ( (((globalThis as any).__void_node || (globalThis as any).node) as any).receipts?.gc?.(keepLast) ) ??
        ({ ok: true, keepLast, removed: 0, kept: 0 } as any);
      res.json(r);
    } catch (e: any) {
      res.status(500).json({ ok: false, error: String(e?.message || e) });
