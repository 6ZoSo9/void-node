          `void_lastmile_last_seen_block ${lm.last_seen_block||0}`,
          "# HELP void_lastmile_errors_total Background worker errors/timeouts",
          "# TYPE void_lastmile_errors_total counter",
          `void_lastmile_errors_total ${lm.errors_total||0}`,
          ""
        ].join("\n"));
      }catch{
        res.type("text/plain").send(`# HELP void_uptime_ms Process uptime (ms)
# TYPE void_uptime_ms gauge
void_uptime_ms ${Math.max(0,(process.uptime?.()||0)*1000)|0}
`);
      }
    });

    // NEW JSON path
    a.get("/__void/about2", async (_req:any,res:any)=>{
