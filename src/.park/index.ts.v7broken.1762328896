            injectedBlocks: state.injectedBlocks,
            injectedTxs: state.injectedTxs,
            lastMethod: state.lastMethod,
            lastCount: state.lastCount,
            pendingLen: Array.isArray(n?.pendingTxs)? n.pendingTxs.length : null
          });
