        res.json({
          hasStore: !!s,
          protoKeys: out,
          ownKeys: Object.keys(s || {}),
          typeofAppend: s ? typeof s.append : null
        });
      });

      app.get("/node/diag", (_:any, res:any)=>{
        const keys = n ? Object.keys(n) : [];
        const fns = keys.filter(k=> typeof (n as any)[k]==="function");
        res.json({
          nodeKeys: keys,
          fnKeys: fns.slice().sort(),
