            if (added>0){
              state.injectedBlocks++; state.injectedTxs += added;
              state.lastBlock = Number(b.number ?? -1); state.lastCount = added;
              // Clean picked from sources so they don’t linger in queues
              drainFrom(sources, b.txs.slice(-added));
