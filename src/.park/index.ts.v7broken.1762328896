// ---- console-filter exporter (additive, safe) ----
;(function ConsoleFilterExporterV1(){
  const TICK=300;
  function getApp(){ return (globalThis as any).__void_http_app || (globalThis as any).app; }
  function mount(){
    try{
      const app:any=getApp();
      if(!app||typeof app.get!=="function") return setTimeout(mount,TICK);
      if(app.__void_console_filter_exporter_v1) return; app.__void_console_filter_exporter_v1=true;

      // Prom text at /__void/metrics/console_filter.prom
      app.get("/__void/metrics/console_filter.prom", (_req:any, res:any)=>{
        const g:any = globalThis as any;
        const ok = g && g.__void_console_filter_v0 ? 1 : 0;
        res.type("text/plain; version=0.0.4; charset=utf-8").send([
          "# HELP void_console_filter_ok 1 when console filter is loaded",
          "# TYPE void_console_filter_ok gauge",
          `void_console_filter_ok ${ok}`,
          "# HELP void_console_filter_info Info line",
          "# TYPE void_console_filter_info gauge",
          `void_console_filter_info{state="${ok? "installed":"missing"}"} 1`,
        ].join("\n")+"\n");
      });
      console.error("[console-filter.exporter] mounted");
    }catch{ setTimeout(mount,TICK); }
  }
  mount();
})();

// ---- WAL v1 poller (additive, no core edits) ----
;(function WalV1Poller(){
  const TICK=1000;
  const MAX_ERRORS=50;
  const g:any = globalThis as any;

  // helpers
  function getApp(){ return (g).__void_http_app || (g).app; }
  async function getJSON(u:string){ const r=await fetch(u); if(!r.ok) throw new Error(`fetch ${u} ${r.status}`); return r.json(); }
// [fix-await-nonasync]   function join(...p:string[]){ return (await import("node:path")).default.join(...p); }
  async function join(...p:string[]){ const m = await import("node:path"); return m.default.join(...p); }
  async function ensureDir(p:string){ const fs = await import("node:fs/promises"); await fs.mkdir(p,{recursive:true}); }
  async function appendAtomic(file:string, line:string){
    const fs = await import("node:fs/promises");
    const f = await fs.open(file, 'a');
    try { await f.appendFile(line+"\n"); await f.sync(); } finally { await f.close(); }
  }

  let last=-1, errors=0, lastErr="";
  let walPath = "";

  async function initPath(){
    const p = await import("node:path");
    const dataDir = process.env.DATA_DIR || process.env.VOID_DATA_DIR || "data";
    const dir = p.default.join(dataDir, "wal_v1");
    await ensureDir(dir);
    walPath = p.default.join(dir, "wal.jsonl");
  }

  async function tick(){
    try{
      if(!walPath) await initPath();
      // Try both endpoints we expose in our codebase
      let n:number|undefined;
      try { n = Number(await (await getJSON("http://127.0.0.1:"+ (process.env.HTTP_PORT||"4100") +"/blocks/latest/number2.json")).number); }
      catch { n = Number(await (await getJSON("http://127.0.0.1:"+ (process.env.HTTP_PORT||"4100") +"/blocks/latest/number")).number); }
      if(!Number.isFinite(n)) throw new Error("bad latest number");
      if(n>last){
        // fetch header3 for txRoot + tx count (fallback to header2->3 redirect)
        const h = await getJSON(`http://127.0.0.1:${process.env.HTTP_PORT||"4100"}/blocks/${n}/header3`);
        const entry = {
          ts: Date.now(),
          number: n,
          txCount: h?.txCount ?? null,
          txRoot: h?.txRoot ?? null,
        };
        await appendAtomic(walPath, JSON.stringify(entry));
        last = n;
      }
      lastErr = ""; errors = Math.max(0, errors-1);
    }catch(e:any){
      lastErr = String(e?.message||e); errors++;
      if(errors>MAX_ERRORS) errors=MAX_ERRORS;
    }finally{
      setTimeout(tick, TICK);
    }
  }

  // Exporter
  function mount(){
    const app:any = getApp();
    if(!app || typeof app.get!=="function") return setTimeout(mount, 300);
    if(app.__void_wal_v1_exporter) return; app.__void_wal_v1_exporter = true;
    app.get("/__void/metrics/wal_v1.prom", async (_req:any,res:any)=>{
      res.type("text/plain; version=0.0.4; charset=utf-8").send(
        [
          "# HELP void_wal_last_number Last block appended to WAL v1",
          "# TYPE void_wal_last_number gauge",
          `void_wal_last_number ${Number.isFinite(last)&&last>=0? last : -1}`,
          "# HELP void_wal_errors_total Recent error counter (capped)",
          "# TYPE void_wal_errors_total counter",
          `void_wal_errors_total ${errors}`,
          "# HELP void_wal_info Info line",
          "# TYPE void_wal_info gauge",
          `void_wal_info{path="${walPath||""}",state="${last>=0?"ok":"init"}",last_error="${(lastErr||"").replace(/"/g,'\\"') }"} 1`,
        ].join("\n")+"\n"
      );
    });
    console.error("[wal.v1] poller mounted ->", process.env.DATA_DIR||"data", "/wal_v1/wal.jsonl");
  }

  mount();
  tick();
})();

// ----- console filter: ignore forensics ESM complaint (additive, safe) -----
(function consoleFilterForensicsESM(){
  const TICK=400;
  function attach(){
    const anyG = globalThis;
    const filt = anyG.__void_console_filter;
    if (!filt || typeof filt.add !== "function") return setTimeout(attach, TICK);
    try {
      filt.add(/txroot\/forensics.*require is not defined/i);
      // diag
      if (typeof console !== "undefined" && console.log) console.log("[console-filter] drop forensics require() ESM noise");
    } catch {}
  }
  attach();
})();


// -------- quiet txroot "number=undefined" chatter (follower-only, narrow) --------
(function quietTxrootUndefinedWarn(){
  try {
    if ((process.env.VOID_ROLE || "").toLowerCase() !== "follower") return;
    const origWarn = console.warn.bind(console);
    console.warn = (...args:any[]) => {
      try {
        const s = args.map(a => (typeof a === "string" ? a : JSON.stringify(a))).join(" ");
        // Only suppress txroot-core mismatch lines that carry "number=undefined"
        if (s.includes("[txroot-core] mismatch") && s.includes("number=undefined")) return;
      } catch { /* no-op */ }
      origWarn(...args);
    };
  } catch { /* no-op */ }
})();

// ---------------- TXROOT GAP EXPORTER (additive, no core edits) ----------------
(function txrootGapExporterV1(){
  const TICK = 2000;
  const STATE: any = {
    enabled: (process.env.VOID_TXROOT_GAP === "1" || process.env.TXROOT_GAP === "1"),
    last: { saves_total: 0, set_total: 0, ts: 0, gap: 0, rate1m: 0 },
    hist: [] as Array<{ts:number,gap:number}>
  };

  function getApp(){ return (globalThis as any).__void_http_app || (globalThis as any).app; }

  async function fetchJson(url: string){
    const r = await fetch(url);
    if(!r.ok) throw new Error(`GET ${url} => ${r.status}`);
    return r.json();
  }

  async function poll(){
    try{
      if(!STATE.enabled) return;
      // Core counters JSON was added earlier: /__void/metrics/txroot4/core2.json
      const core:any = await fetchJson(`http://127.0.0.1:${process.env.HTTP_PORT||"4100"}/__void/metrics/txroot4/core2.json`);
      const saves = Number(core?.counters?.saves_total ?? 0);
      const setts = Number(core?.counters?.set_total ?? 0);
      const now   = Date.now();
      const gap   = Math.max(0, saves - setts);

      // keep 60s window for a crude 1m rate
      STATE.hist.push({ts: now, gap});
      const cutoff = now - 60000;
      while(STATE.hist.length && STATE.hist[0].ts < cutoff) STATE.hist.shift();

      const first = STATE.hist[0]?.gap ?? gap;
      const rate1m = (gap - first) / 60; // blocks/sec equivalent (can be negative -> clamp)
      STATE.last = { saves_total: saves, set_total: setts, ts: now, gap, rate1m: Math.max(0, rate1m) };
    }catch(e){ /* silent */ }
  }

  function mount(){
    const app:any = getApp();
    if(!app || typeof app.get!=="function") return setTimeout(mount, TICK);

    if ((app as any).__void_txroot_gap_v1) return;
    (app as any).__void_txroot_gap_v1 = true;

    app.get("/__void/metrics/txroot4/gap.prom", (_req:any, res:any)=>{
      const L = STATE.last;
      const b:string[] = [];
      b.push("# HELP void_txroot_gap_blocks Backlog between saves_total and header set_total (blocks)");
      b.push("# TYPE void_txroot_gap_blocks gauge");
      b.push(`void_txroot_gap_blocks ${L.gap}`);

      b.push("# HELP void_txroot_gap_rate1m Approx change in gap over 60s (blocks/sec, >=0)");
      b.push("# TYPE void_txroot_gap_rate1m gauge");
      b.push(`void_txroot_gap_rate1m ${L.rate1m}`);

      b.push("# HELP void_txroot_gap_ts_ms Exporter sample timestamp (ms)");
      b.push("# TYPE void_txroot_gap_ts_ms gauge");
      b.push(`void_txroot_gap_ts_ms ${L.ts||0}`);

      res.type("text/plain").send(b.join("\n")+"\n");
    });

    // poller (enabled only if env set)
    setInterval(poll, 2000);
    setTimeout(poll, 500);
  }

  // defer until app is ready
  let tries=0; (function wait(){ tries++; mount(); if(tries<120) setTimeout(wait, TICK); })();
})();
// ---------------- Genesis manifest loader + Prom exporter (additive, safe) ---------------
(function GenesisManifestExporter(){
  const TICK = 400;
  let mounted = false;
  function getApp(){ return (globalThis as any).__void_http_app || (globalThis as any).app; }

  async function loadGenesis() {
    try {
      const fs = await import('node:fs/promises');
      const { createHash } = await import('node:crypto');
      const path = process.env.GENESIS_PATH || (process.cwd() + '/genesis/void.genesis.json');
      const raw = await fs.readFile(path, 'utf8');
      const hash = createHash('sha256').update(raw).digest('hex');
      const j = JSON.parse(raw);

      const now = Date.now();
      const gtime = Date.parse(j.genesisTime || '');
      const ageSec = isNaN(gtime) ? NaN : Math.max(0, Math.floor((now - gtime)/1000));

      const expectedChain = Number(process.env.VOID_CHAIN_ID || process.env.CHAIN_ID || 2050);
      const manifestChain = Number(j.chainId);
      const chainMatch = (manifestChain === expectedChain);

      const seedHttp = Array.isArray(j?.seedPeers?.http) ? j.seedPeers.http : [];
      const seedP2P  = Array.isArray(j?.seedPeers?.p2p)  ? j.seedPeers.p2p  : [];
      const seedsOk = seedHttp.length > 0 || seedP2P.length > 0;

      const ok = !!manifestChain && !Number.isNaN(manifestChain) && !!gtime && !Number.isNaN(gtime) && seedsOk;

      return {
        ok, hash, path, manifest: j,
        chain: { expected: expectedChain, manifest: manifestChain, match: chainMatch },
        seeds: { http: seedHttp, p2p: seedP2P, count: seedHttp.length + seedP2P.length },
        time: { genesisMs: gtime, ageSec }
      };
    } catch (e:any) {
      return { ok:false, error: String(e && e.message || e), hash:'', path: process.env.GENESIS_PATH || '' };
    }
  }

  async function mount(){
    const app:any = getApp();
    if (!app || typeof app.get !== 'function') return setTimeout(mount, TICK);
    if (mounted) return; mounted = true;

    // status JSON
    app.get('/genesis/status', async (_req:any, res:any)=>{
      const s = await loadGenesis();
      res.setHeader('Content-Type','application/json');
      res.end(JSON.stringify(s, null, 2));
    });

    // prometheus text exporter
    app.get('/__void/metrics/genesis.prom', async (_req:any, res:any)=>{
      const s = await loadGenesis();
      res.setHeader('Content-Type','text/plain; version=0.0.4');
      const lines:string[] = [];
      const labelHash = s.hash ? `{hash="${s.hash}"}` : '';
      const chainId = (s as any)?.chain?.manifest ?? NaN;
      const match = (s as any)?.chain?.match ? 1 : 0;
      const ok = s.ok ? 1 : 0;
      const seeds = (s as any)?.seeds?.count ?? 0;
      const age = (s as any)?.time?.ageSec ?? NaN;

      lines.push('# HELP void_genesis_chain_id chain id from manifest');
      lines.push('# TYPE void_genesis_chain_id gauge');
      lines.push(`void_genesis_chain_id${labelHash} ${Number.isFinite(chainId)? chainId : 'NaN'}`);

      lines.push('# HELP void_genesis_ok manifest present & minimally valid');
      lines.push('# TYPE void_genesis_ok gauge');
      lines.push(`void_genesis_ok${labelHash} ${ok}`);

      lines.push('# HELP void_genesis_mismatch 1 if expected chainId != manifest chainId');
      lines.push('# TYPE void_genesis_mismatch gauge');
      lines.push(`void_genesis_mismatch${labelHash} ${match ? 0 : 1}`);

      lines.push('# HELP void_genesis_seed_peers total seed peers (http+p2p)');
      lines.push('# TYPE void_genesis_seed_peers gauge');
      lines.push(`void_genesis_seed_peers${labelHash} ${seeds}`);

      lines.push('# HELP void_genesis_age_seconds seconds since manifest.genesisTime');
      lines.push('# TYPE void_genesis_age_seconds gauge');
      lines.push(`void_genesis_age_seconds${labelHash} ${Number.isFinite(age)? age : 'NaN'}`);

      res.end(lines.join('\n')+'\n');
    });
  }
  mount();
})();

// ---------- SegStore saveBlock Guard v1 (additive, ESM-safe, reentrancy-safe) ----------
(function SaveBlockGuardV1(){
  const TICK=400;
  const SYM_ORIG = Symbol.for('void.segstore.saveBlock.orig');
  const SYM_WRAP = Symbol.for('void.segstore.saveBlock.wrapped');
  const SYM_BUSY = Symbol.for('void.segstore.saveBlock.busy');
  const state = { patched:false, calls:0, last_ms:0, last_number:-1, last_result:"" };
  const skip = String(process.env.VOID_TXROOT_FORENSICS||"").trim()==="0" ? true : false;

  function numOf(x:any):number{
    try{
      if (!x) return -1;
      if (typeof x.number === "number") return x.number;
      if (x.header && typeof x.header.number === "number") return x.header.number;
      if (x.block && typeof x.block.number === "number") return x.block.number;
      if (x.block?.header && typeof x.block.header.number === "number") return x.block.header.number;
    }catch{}
    return -1;
  }

  function tryPatch(){
    try{
      // ESM-safe global reach
      const S:any = (globalThis as any).SegStore || (typeof SegStore!=="undefined"? (SegStore as any) : undefined);
      if (!S || !S.prototype) return false;

      const proto:any = S.prototype;
      if (proto[SYM_WRAP]) return (state.patched=true);

      const original = (proto[SYM_ORIG] ||= proto.saveBlock);
      if (typeof original !== "function") return false;

      // Reentrancy guard per-instance
      const wrapped = async function wrappedSaveBlock(this:any, ...args:any[]){
        if (this && this[SYM_BUSY]) {
          // If some other shim caused recursion, bail to original without nesting again
          return original.apply(this, args);
        }
        const t0 = Date.now();
        try{
          if (this) this[SYM_BUSY] = true;
          const out = await original.apply(this, args);
          state.last_number = numOf(args[0]) ?? numOf(out);
          state.last_result = "ok";
          return out;
        } catch(e:any){
          state.last_result = "error:" + String(e?.message||e);
          throw e;
        } finally {
          state.calls++; state.last_ms = Date.now()-t0;
          if (this) try{ delete this[SYM_BUSY]; }catch{}
        }
      };

      // Flag + install
      Object.defineProperty(wrapped, 'name', { value: 'wrappedSaveBlockV1' });
      (wrapped as any)[SYM_WRAP] = true;
      Object.defineProperty(proto, "saveBlock", { value: wrapped, configurable: true, writable: true });
      state.patched = true;
      return true;
    }catch{ return false; }
  }

  function tryUnpatch(){
    try{
      const S:any = (globalThis as any).SegStore || (typeof SegStore!=="undefined"? (SegStore as any) : undefined);
      if (!S || !S.prototype) return false;
      const proto:any = S.prototype;
      const orig = proto[SYM_ORIG];
      if (typeof orig === "function") {
        Object.defineProperty(proto, "saveBlock", { value: orig, configurable: true, writable: true });
        delete proto[SYM_WRAP];
        state.patched = false;
        return true;
      }
      return false;
    }catch{ return false; }
  }

  function getApp(){ return (globalThis as any).__void_http_app || (globalThis as any).app; }
  function mount(){
    const app:any = getApp(); if (!app || typeof app.get!=="function") return setTimeout(mount, TICK);

    // Status
    app.get("/__void/ops/saveBlock/status", (_req:any, res:any)=>{
      try{
        const S:any = (globalThis as any).SegStore || (typeof SegStore!=="undefined"? (SegStore as any) : undefined);
        const proto = S?.prototype;
        const hasWrap = !!(proto && proto[SYM_WRAP]);
        const hasOrig = !!(proto && typeof proto[SYM_ORIG]==="function");
        res.json({ ok:true, skip, patched:state.patched, hasWrap, hasOrig, state });
      }catch(e:any){
        res.status(500).json({ ok:false, error:String(e) });
      }
    });

    // Unpatch (restore original)
    app.post("/__void/ops/saveBlock/unpatch", (_req:any, res:any)=>{
      const ok = tryUnpatch();
      res.json({ ok, action:"unpatch", state });
    });

    // Patch (idempotent)
    app.post("/__void/ops/saveBlock/patch", (_req:any, res:any)=>{
      const ok = tryPatch();
      res.json({ ok, action:"patch", state });
    });

    // Prom exporter
    app.get("/__void/metrics/saveblock.guard.prom", (_req:any, res:any)=>{
      res.type("text/plain; version=0.0.4; charset=utf-8");
      const p = state.patched ? 1 : 0;
      res.end(
        "# HELP void_saveblock_guard_patched 1 if guard is active\n" +
        "# TYPE void_saveblock_guard_patched gauge\n" +
        `void_saveblock_guard_patched ${p}\n` +
        "# HELP void_saveblock_guard_calls total calls that flowed through guard\n" +
        "# TYPE void_saveblock_guard_calls counter\n" +
        `void_saveblock_guard_calls ${state.calls}\n` +
        "# HELP void_saveblock_guard_last_ms last call duration ms\n" +
        "# TYPE void_saveblock_guard_last_ms gauge\n" +
        `void_saveblock_guard_last_ms ${state.last_ms}\n` +
        "# HELP void_saveblock_guard_last_number last observed block number\n" +
        "# TYPE void_saveblock_guard_last_number gauge\n" +
        `void_saveblock_guard_last_number ${Math.max(-1, Number(state.last_number)||-1)}\n`
      );
    });
  }

  // Activate unless explicitly disabled
  if (!skip) {
    let tries=0;
    (function boot(){
      const ok = tryPatch();
      if (!ok && ++tries<200) setTimeout(boot, TICK);
    })();
  }
  mount();
})();

// ---------------- v7 safety prebind (additive, no deletions) -----------------
(function v7SafetyPrebind(){
  try {
    const TICK = 300;
    const FLAG5 = "__void_trampoline_v5";
    const FLAG6 = "__void_trampoline_v6";
    const FLAG7 = "__void_trampoline_v7";
    const DONE  = "__void_v7_safety_prebound__";

    function once(fn){let d=false;return (...a)=>{ if(d) return; d=true; try{ return fn(...a);}finally{ d=true;} } }

    const install = once(function install(){
      const g = globalThis;
      // Prefer existing SegStore if present, else lazy-retry until it appears
      const Seg = g.SegStore;
      if (!Seg || !Seg.prototype) { setTimeout(install, TICK); return; }

      const proto = Seg.prototype;
      if (proto[DONE]) return; // already safe

      const current = proto.saveBlock;
      if (typeof current !== "function") { proto[DONE] = true; return; }

      // Wrap in a pass-through that carries ALL known flags so trampolines back off.
      const stable = function(...args){ return current.apply(this, args); };
      try { Object.defineProperty(stable, FLAG7, { value: "prebound" }); } catch {}
      try { Object.defineProperty(stable, FLAG6, { value: true }); } catch {}
      try { Object.defineProperty(stable, FLAG5, { value: true }); } catch {}

      // If someone already installed a flagged fn, keep it; else swap in our flagged pass-through.
      const hasV7 = current && current[FLAG7];
      const hasV6 = current && current[FLAG6];
      const hasV5 = current && current[FLAG5];

      if (!hasV7 && !hasV6 && !hasV5) {
        try {
          // Assign once; later v7/v6 setters will see the flags and *not* rewrap.
          Seg.prototype.saveBlock = stable;
        } catch { /* non-fatal */ }
      }

      // Mark as done so we don’t spam.
      try { Object.defineProperty(proto, DONE, { value: true, configurable: true }); } catch { proto[DONE] = true; }
      // Optional: tiny inspector so we can verify quickly
      const app = (g as any).__void_http_app || (g as any).app;
      if (app && typeof app.get === "function" && !app.__void_v7_safety_probe){
        app.__void_v7_safety_probe = true;
        app.get("/__void/dev/inspect/v7-safety", (_req:any, res:any) => {
          const live = (g as any).SegStore?.prototype?.saveBlock;
          res.json({
            ok: true,
            proto_safety_done: !!proto[DONE],
            live_has_v7: !!(live && live[FLAG7]),
            live_has_v6: !!(live && live[FLAG6]),
            live_has_v5: !!(live && live[FLAG5]),
            summary: (function(){
              try {
                const s = Function.prototype.toString.call(live||(()=>{}));
                return s.slice(0,120).replace(/\s+/g,' ');
              } catch { return "[uninspectable]"; }
            })()
          });
        });
      }
    });

    install();
  } catch(_) {}
})();
