          `void_uptime_ms ${Math.max(0,(process.uptime?.()||0)*1000)|0}`,
          "# HELP void_lastmile_block_txs_total Total txs persisted by lastmile v4b",
          "# TYPE void_lastmile_block_txs_total counter",
