        if ((impl as any)[WRAP_SYM]) return impl;
        const wrapped = async function(b:any){
          const out = await impl(b);
          try{
            const n = (b?.txs?.length)||0;
            const c = (globalThis as any).__txroot_counters;
            if (c){ c.blocks += 1; c.txs += n; }
          }catch{}
