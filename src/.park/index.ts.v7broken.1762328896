  })();
// [txroot-log-fix]           console.log(`[txroot] sealed #${n} txs=${len} txRoot=${r}`);
        } catch {}

        return res;
      };
      (store as any).__txroot_wrapped = true;

      // Extend /metrics output with our two counters (non-invasive)
      try {
