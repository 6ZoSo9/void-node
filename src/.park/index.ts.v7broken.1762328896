    const C = (globalThis as any).__void_txroot_v4 ||= { ok:0, mismatch:0, errors:0 };

    // GET /__void/txroot/v4/verify2/:n   (JSON)
    app.get("/__void/txroot/v4/verify2/:n", async (req:any, res:any) => {
      const n = String(req.params.n ?? "").trim();
