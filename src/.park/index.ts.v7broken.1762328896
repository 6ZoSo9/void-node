  /* ===================== MEMPOOL / TX SUBMIT ===================== */
  app.get("/mempool/count", (_req, res) => {
    try {
      const txs = (((globalThis as any).__void_node || (globalThis as any).node) as any).mempool?.peekAll?.() ?? [];
      res.json({ ok: true, count: Array.isArray(txs) ? txs.length : 0 });
    } catch (e: any) {
