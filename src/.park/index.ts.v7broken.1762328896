        if (app && typeof app.get === "function") {
          app.get("/metrics/txroot", (_req:any, res:any)=>{
            const snap = node?.metrics?.sealedSnapshot ? node.metrics.sealedSnapshot() : {sealed_blocks_total:0, sealed_txs_total:0};
