// -------- noop-setter:v3g (count empties by tx count) --------
(function noopSetterV3g(){
  const TICK=400;
  function getStore(){ return (globalThis as any).__void_store; }
  function getApp(){ return (globalThis as any).__void_http_app || (globalThis as any).app; }
