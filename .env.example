# Core
DATA_DIR=data
HTTP_HOST=127.0.0.1
HTTP_PORT=4100
P2P_HOST=127.0.0.1
P2P_PORT=4700
PUBLIC_HTTP_BASE=http://localhost:4100

# Features
ALLOW_EMPTY_BLOCKS=0
MAX_BLOB_MB=8

# P2P
# Set one or more trusted reachable host:port peers, separated by commas.
# The public clone default is intentionally empty; 127.0.0.1 requires another local node.
BOOTSTRAP_ADDRS=

# Keys
# This is a node identity path, not a wallet or validator-stake signer.
NODE_PRIVKEY_PATH=.nodekey

# Optional public participant earning.
# Obtain these exact public values from the trusted Public Earn coordinator.
VOID_PARTICIPANT_EARN_MODE=no-node
VOID_PARTICIPANT_ACCOUNT=
VOID_PUBLIC_EARN_COORDINATOR_BASE=
VOID_PUBLIC_EARN_COORDINATOR_NODE_ID=
VOID_PUBLIC_EARN_TICKET_FILE=

# Optional validator-candidate preparation.
# Never put a private key, seed phrase, mnemonic, or wallet file here.
VOID_CHAIN_RPC=
VOID_VALIDATOR_CANDIDATE_REGISTRY=
VOID_VALIDATOR_OWNER=
VOID_VALIDATOR_REWARD=
VOID_VALIDATOR_NODE_ID=
VOID_VALIDATOR_CONSENSUS_KEY_HASH=
VOID_VALIDATOR_PUBLIC_ENDPOINT=
VOID_VALIDATOR_P2P_MULTIADDR=
