{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/authenticated-paid-work-runtime-listener-cgroup-binding-v1.schema.json",
  "title": "Authenticated paid-work runtime listener cgroup binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "listeners",
    "marker",
    "network_namespace",
    "observation",
    "ownership",
    "protocol",
    "receipt_id",
    "safety",
    "service",
    "source",
    "status",
    "target",
    "version"
  ],
  "properties": {
    "marker": {
      "const": "VOID_AUTHENTICATED_PAID_WORK_RUNTIME_LISTENER_CGROUP_BINDING_V1"
    },
    "protocol": {
      "const": "void-authenticated-paid-work-runtime-listener-cgroup-binding/1"
    },
    "version": {
      "const": 1
    },
    "status": {
      "const": "sanitized_listener_binding_not_runtime_authority"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^voidapwrlcb1_[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "reviewed_source_main",
        "runtime_revalidation_contract_merge_commit"
      ],
      "properties": {
        "repository": {
          "const": "6ZoSo9/void-node"
        },
        "reviewed_source_main": {
          "const": "68e3ef3a7c15cf5b3623555979766fadf8b670fe"
        },
        "runtime_revalidation_contract_merge_commit": {
          "const": "d12b4620cb5a6e199a6a59f21dfae6dd434c550a"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "listener_address_family",
        "listener_host",
        "listener_port",
        "listener_protocol",
        "manager_scope",
        "service"
      ],
      "properties": {
        "host": {
          "const": "zoso-Precision-Tower-7810"
        },
        "manager_scope": {
          "const": "systemd_user"
