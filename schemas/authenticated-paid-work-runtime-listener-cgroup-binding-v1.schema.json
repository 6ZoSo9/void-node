            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 2,
                "maximum": 4194304
              },
              "proc_cgroup_path_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "start_time_ticks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    "network_namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listener_network_namespace_inode",
