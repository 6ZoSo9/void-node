          "minimum": 1,
          "maximum": 9007199254740991
        },
        "network_namespace_binding_verified": {
          "const": true
        }
      }
    },
    "listeners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
