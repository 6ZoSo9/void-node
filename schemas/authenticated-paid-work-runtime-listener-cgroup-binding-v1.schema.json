        "properties": {
          "protocol": {
            "const": "tcp"
          },
          "address_family": {
            "const": "ipv4"
          },
          "local_address": {
            "const": "127.0.0.1"
          },
          "local_port": {
            "const": 4187
          },
          "state": {
            "const": "LISTEN"
          },
          "socket_inode": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "owner_pid": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4194304
          },
          "owner_start_time_ticks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "owner_proc_cgroup_path_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "network_namespace_inode": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
