        "cgroup_member_processes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pid",
              "proc_cgroup_path_sha256",
              "start_time_ticks"
