      "properties": {
        "service_mutation_performed": {
          "const": false
        },
        "credential_access_performed": {
          "const": false
        },
        "raw_token_read": {
          "const": false
        },
        "private_path_disclosed": {
          "const": false
        },
        "network_request_performed": {
          "const": false
        },
        "producer_authentication_established": {
          "const": false
        },
        "live_authentication_performed": {
          "const": false
        },
        "paid_work_submission_performed": {
          "const": false
        },
        "quote_acceptance_performed": {
          "const": false
        },
        "payment_execution_performed": {
          "const": false
        },
        "work_dispatch_performed": {
          "const": false
        },
        "work_credit_write_performed": {
          "const": false
        },
        "wallet_or_signer_access_performed": {
          "const": false
        },
        "signing_performed": {
          "const": false
        },
        "transaction_construction_performed": {
          "const": false
        },
        "transaction_broadcast_performed": {
          "const": false
        },
        "fund_movement_performed": {
          "const": false
