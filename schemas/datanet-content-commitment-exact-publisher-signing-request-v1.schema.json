{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-exact-publisher-signing-request-v1.schema.json",
  "title":"VOID DataNet Content Commitment Exact Publisher Signing Request v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id","authorization_id",
    "authorization_verification_id","consumption_record_id",
    "final_signing_review_preflight_id",
    "unsigned_transaction_candidate_fingerprint_sha256",
    "publisher_address","unsigned_transaction_candidate","transaction_summary",
    "canonical_state_store_realpath_sha256",
    "external_signing_idempotency_key_sha256",
    "issued_at_utc","expires_at_utc","request_constructed_at_utc",
    "external_signer_contract","authority","next_gate","signing_request_id",
    "signing_request_constructed","filesystem_mutation_performed",
    "sovereign_private_key_access_performed",
    "transaction_signer_access_performed","wallet_access_performed",
    "transaction_signing_performed","transaction_broadcast_performed",
    "chain2050_write_performed","authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_EXACT_PUBLISHER_SIGNING_REQUEST_V1"
    },
    "version":{"const":1},
    "status":{
      "const":"exact_consumed_transaction_ready_for_external_signing_request"
    },
    "chain_id":{"const":"2050"},
    "authorization_id":{"type":"string","pattern":"^voiddccsta1_[0-9a-f]{64}$"},
    "authorization_verification_id":{
      "type":"string","pattern":"^voiddccstav1_[0-9a-f]{64}$"
    },
    "consumption_record_id":{
      "type":"string","pattern":"^voiddccstac1_[0-9a-f]{64}$"
    },
    "final_signing_review_preflight_id":{
      "type":"string","pattern":"^voiddccfsrp1_[0-9a-f]{64}$"
    },
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "publisher_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "unsigned_transaction_candidate":{"type":"object"},
    "transaction_summary":{"type":"object"},
    "canonical_state_store_realpath_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "external_signing_idempotency_key_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "issued_at_utc":{"type":"string"},
    "expires_at_utc":{"type":"string"},
    "request_constructed_at_utc":{"type":"string"},
    "external_signer_contract":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "prepare_once_required","inspect_prepared_required",
        "signer_address_must_equal_publisher",
        "exact_unsigned_transaction_fingerprint_required",
        "external_runtime_expiry_recheck_required","opaque_custody_required",
        "raw_signed_transaction_application_input",
        "raw_signed_transaction_application_output",
        "raw_signed_transaction_application_persistence",
        "signed_transaction_hash_output_permitted",
        "custody_handle_fingerprint_output_permitted",
        "transaction_broadcast_authorized"
      ],
      "properties":{
        "prepare_once_required":{"const":true},
        "inspect_prepared_required":{"const":true},
        "signer_address_must_equal_publisher":{"const":true},
        "exact_unsigned_transaction_fingerprint_required":{"const":true},
        "external_runtime_expiry_recheck_required":{"const":true},
        "opaque_custody_required":{"const":true},
        "raw_signed_transaction_application_input":{"const":false},
        "raw_signed_transaction_application_output":{"const":false},
        "raw_signed_transaction_application_persistence":{"const":false},
        "signed_transaction_hash_output_permitted":{"const":true},
        "custody_handle_fingerprint_output_permitted":{"const":true},
        "transaction_broadcast_authorized":{"const":false}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "signing_request_only",
        "sovereign_exact_transaction_signing_authorization_verified",
        "durable_authorization_consumption_verified",
        "application_private_key_access_performed",
        "application_wallet_access_performed","transaction_signer_access_performed",
        "transaction_signing_performed","transaction_broadcast_authorized",
        "transaction_broadcast_performed","chain2050_write_authorized",
        "chain2050_write_performed","filesystem_mutation_performed",
        "validator_mutation_authorized","governance_mutation_authorized",
        "work_credit_mutation_authorized","service_action_authorized",
        "funds_action_authorized","automatic_retry_authorized"
      ],
      "properties":{
        "signing_request_only":{"const":true},
        "sovereign_exact_transaction_signing_authorization_verified":{"const":true},
        "durable_authorization_consumption_verified":{"const":true},
        "application_private_key_access_performed":{"const":false},
        "application_wallet_access_performed":{"const":false},
        "transaction_signer_access_performed":{"const":false},
        "transaction_signing_performed":{"const":false},
        "transaction_broadcast_authorized":{"const":false},
        "transaction_broadcast_performed":{"const":false},
        "chain2050_write_authorized":{"const":false},
        "chain2050_write_performed":{"const":false},
        "filesystem_mutation_performed":{"const":false},
        "validator_mutation_authorized":{"const":false},
        "governance_mutation_authorized":{"const":false},
        "work_credit_mutation_authorized":{"const":false},
        "service_action_authorized":{"const":false},
        "funds_action_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false}
      }
    },
    "next_gate":{
      "const":"external_opaque_signer_execution_and_signed_receipt_verification_outside_application_v1"
    },
    "signing_request_id":{
      "type":"string","pattern":"^voiddccpsreq1_[0-9a-f]{64}$"
    },
    "signing_request_constructed":{"const":true},
    "filesystem_mutation_performed":{"const":false},
    "sovereign_private_key_access_performed":{"const":false},
    "transaction_signer_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "transaction_broadcast_performed":{"const":false},
    "chain2050_write_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
