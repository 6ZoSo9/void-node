{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-reconciled-broadcast-receipt-verification-v1.schema.json",
  "title":"VOID DataNet Content Commitment Reconciled Broadcast Receipt Verification v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "broadcast_authorization_id","broadcast_consumption_record_id",
    "submission_intent_id","submission_idempotency_key_sha256",
    "signed_transaction_hash","publisher_address",
    "unsigned_transaction_candidate_fingerprint_sha256",
    "canonical_state_store_realpath_sha256","reconciliation_status",
    "reconciled_at_utc","receipt_observed_at_utc",
    "receipt","verification","authority","next_gate",
    "receipt_observer_invoked","submit_method_invoked",
    "transaction_submission_authorized","automatic_retry_allowed",
    "receipt_verified","finality_verified",
    "raw_signed_transaction_accessed","opaque_custody_handle_accessed",
    "filesystem_mutation_performed","sovereign_private_key_access_performed",
    "wallet_access_performed","transaction_signing_performed",
    "direct_rpc_call_performed","direct_network_call_performed",
    "chain2050_write_direct_performed","authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_RECONCILED_BROADCAST_RECEIPT_VERIFICATION_V1"
    },
    "version":{"const":1},
    "status":{"const":"reconciled_broadcast_receipt_verified_finality_pending"},
    "chain_id":{"const":"2050"},
    "broadcast_authorization_id":{
      "type":"string","pattern":"^voiddccba1_[0-9a-f]{64}$"
    },
    "broadcast_consumption_record_id":{
      "type":"string","pattern":"^voiddccbac1_[0-9a-f]{64}$"
    },
    "submission_intent_id":{
      "type":"string","pattern":"^voiddccbasi1_[0-9a-f]{64}$"
    },
    "submission_idempotency_key_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "signed_transaction_hash":{
      "type":"string","pattern":"^0x[0-9a-f]{64}$"
    },
    "publisher_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "canonical_state_store_realpath_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "reconciliation_status":{"enum":["confirmed","reverted"]},
    "reconciled_at_utc":{"type":"string"},
    "receipt_observed_at_utc":{"type":"string"},
    "receipt":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "status","transaction_status","transaction_hash",
        "block_number","block_hash","current_block_number",
        "confirmation_count","from_address","provider_observation_id"
      ],
      "properties":{
        "status":{"enum":["confirmed","reverted"]},
        "transaction_status":{"enum":["0","1"]},
        "transaction_hash":{"type":"string","pattern":"^0x[0-9a-f]{64}$"},
        "block_number":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
        "block_hash":{"type":"string","pattern":"^0x[0-9a-f]{64}$"},
        "current_block_number":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
        "confirmation_count":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
        "from_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
        "provider_observation_id":{"type":"string","maxLength":200}
      }
    },
    "verification":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "exact_transaction_hash_verified","exact_publisher_verified",
        "terminal_status_consistent","receipt_block_hash_present",
        "confirmation_arithmetic_verified",
        "minimum_confirmation_threshold_applied",
        "accepted_checkpoint_membership_verified","chain_finality_verified"
      ],
      "properties":{
        "exact_transaction_hash_verified":{"const":true},
        "exact_publisher_verified":{"const":true},
        "terminal_status_consistent":{"const":true},
        "receipt_block_hash_present":{"const":true},
        "confirmation_arithmetic_verified":{"const":true},
        "minimum_confirmation_threshold_applied":{"const":false},
        "accepted_checkpoint_membership_verified":{"const":false},
        "chain_finality_verified":{"const":false}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "terminal_reconciliation_verified",
        "durable_consumption_record_verified",
        "durable_submission_intent_verified",
        "canonical_state_store_verified","metadata_only_receipt_request",
        "receipt_observer_invoked","submit_method_invoked",
        "transaction_submission_authorized","automatic_retry_authorized",
        "filesystem_mutation_performed","sovereign_private_key_access_performed",
        "wallet_access_performed","transaction_signing_performed",
        "direct_rpc_call_performed","direct_network_call_performed",
        "chain2050_write_direct_performed"
      ],
      "properties":{
        "terminal_reconciliation_verified":{"const":true},
        "durable_consumption_record_verified":{"const":true},
        "durable_submission_intent_verified":{"const":true},
        "canonical_state_store_verified":{"const":true},
        "metadata_only_receipt_request":{"const":true},
        "receipt_observer_invoked":{"const":true},
        "submit_method_invoked":{"const":false},
        "transaction_submission_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false},
        "filesystem_mutation_performed":{"const":false},
        "sovereign_private_key_access_performed":{"const":false},
        "wallet_access_performed":{"const":false},
        "transaction_signing_performed":{"const":false},
        "direct_rpc_call_performed":{"const":false},
        "direct_network_call_performed":{"const":false},
        "chain2050_write_direct_performed":{"const":false}
      }
    },
    "next_gate":{"const":"chain2050_reconciled_receipt_finality_v1"},
    "receipt_observer_invoked":{"const":true},
    "submit_method_invoked":{"const":false},
    "transaction_submission_authorized":{"const":false},
    "automatic_retry_allowed":{"const":false},
    "receipt_verified":{"const":true},
    "finality_verified":{"const":false},
    "raw_signed_transaction_accessed":{"const":false},
    "opaque_custody_handle_accessed":{"const":false},
    "filesystem_mutation_performed":{"const":false},
    "sovereign_private_key_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "direct_rpc_call_performed":{"const":false},
    "direct_network_call_performed":{"const":false},
    "chain2050_write_direct_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
