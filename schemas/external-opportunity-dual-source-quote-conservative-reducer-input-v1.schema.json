{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:void:schema:external-opportunity-dual-source-quote-conservative-reducer-input:1",
  "title": "VOID external opportunity dual-source quote conservative reducer input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reduction_id",
    "evaluated_at",
    "maximum_observation_skew_seconds",
    "quotes"
  ],
  "properties": {
    "schema": {
      "const": "void-dual-source-quote-conservative-reducer-input-v1"
    },
    "reduction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "maximum_observation_skew_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "quotes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/quote"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "address", "symbol", "decimals"],
      "properties": {
        "chain_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "quote_id",
        "observed_at",
        "quote_expiry_timestamp",
        "input_asset",
        "output_asset",
        "input_amount",
        "expected_output_amount",
        "minimum_output_amount",
        "expected_output_value_usd",
        "minimum_output_value_usd",
        "expected_fill_time_seconds",
        "quoted_output_includes_provider_fees",
        "quoted_output_includes_price_impact",
        "app_fee_usd",
        "gas_usd"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "quote_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "quote_expiry_timestamp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4102444800
        },
        "input_asset": {
          "$ref": "#/$defs/asset"
        },
        "output_asset": {
          "$ref": "#/$defs/asset"
        },
        "input_amount": {
          "$ref": "#/$defs/positive_integer_string"
        },
        "expected_output_amount": {
          "$ref": "#/$defs/positive_integer_string"
        },
        "minimum_output_amount": {
          "$ref": "#/$defs/positive_integer_string"
        },
        "expected_output_value_usd": {
          "$ref": "#/$defs/usd"
        },
        "minimum_output_value_usd": {
          "$ref": "#/$defs/usd"
        },
        "expected_fill_time_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "quoted_output_includes_provider_fees": {
          "const": true
        },
        "quoted_output_includes_price_impact": {
          "const": true
        },
        "app_fee_usd": {
          "const": "0.000000"
        },
        "gas_usd": {
          "$ref": "#/$defs/usd"
        }
      }
    },
    "positive_integer_string": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 128
    },
    "usd": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
      "maxLength": 64
    }
  }
}
