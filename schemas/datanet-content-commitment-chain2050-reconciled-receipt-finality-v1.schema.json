{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-chain2050-reconciled-receipt-finality-v1.schema.json",
  "title":"VOID DataNet Content Commitment Chain-2050 Reconciled Receipt Finality v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "finality_policy_id","finality_kind",
    "receipt_verification_fingerprint_sha256","checkpoint_attestation_id",
    "signed_transaction_hash","receipt_status","transaction_status",
    "publisher_address","receipt_block_number","receipt_block_hash",
    "observed_current_block_number","observed_confirmation_count",
    "minimum_confirmations","accepted_checkpoint_height",
    "accepted_checkpoint_hash","signer_public_key_der_sha256",
    "commitment_succeeded","finality","authority","next_gate",
    "finality_verification_id","finality_verified",
    "protocol_consensus_finality_claimed",
    "transaction_submission_authorized","automatic_retry_allowed",
    "filesystem_mutation_performed","sovereign_private_key_access_performed",
    "wallet_access_performed","transaction_signing_performed",
    "direct_rpc_call_performed","direct_network_call_performed",
    "chain2050_write_direct_performed","authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_CHAIN2050_RECONCILED_RECEIPT_FINALITY_V1"
    },
    "version":{"const":1},
    "status":{"const":"chain2050_reconciled_receipt_finality_verified"},
    "chain_id":{"const":"2050"},
    "finality_policy_id":{"const":"mainnet0-checkpoint-finality-v1"},
    "finality_kind":{"const":"operator_recognized_accepted_checkpoint"},
    "receipt_verification_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "checkpoint_attestation_id":{
      "type":"string","pattern":"^voiddccfca1_[0-9a-f]{64}$"
    },
    "signed_transaction_hash":{
      "type":"string","pattern":"^0x[0-9a-f]{64}$"
    },
    "receipt_status":{"enum":["confirmed","reverted"]},
    "transaction_status":{"enum":["0","1"]},
    "publisher_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "receipt_block_number":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
    "receipt_block_hash":{"type":"string","pattern":"^0x[0-9a-f]{64}$"},
    "observed_current_block_number":{
      "type":"string","pattern":"^(0|[1-9][0-9]*)$"
    },
    "observed_confirmation_count":{
      "type":"string","pattern":"^(0|[1-9][0-9]*)$"
    },
    "minimum_confirmations":{"const":"12"},
    "accepted_checkpoint_height":{
      "type":"string","pattern":"^[1-9][0-9]*$"
    },
    "accepted_checkpoint_hash":{
      "type":"string","pattern":"^0x[0-9a-f]{64}$"
    },
    "signer_public_key_der_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "commitment_succeeded":{"type":"boolean"},
    "finality":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "minimum_confirmation_threshold_applied",
        "minimum_confirmation_threshold_met",
        "accepted_checkpoint_membership_verified",
        "receipt_block_in_accepted_history_verified",
        "operator_recognized_canonical_checkpoint_verified",
        "chain_finality_verified","protocol_consensus_finality_claimed"
      ],
      "properties":{
        "minimum_confirmation_threshold_applied":{"const":true},
        "minimum_confirmation_threshold_met":{"const":true},
        "accepted_checkpoint_membership_verified":{"const":true},
        "receipt_block_in_accepted_history_verified":{"const":true},
        "operator_recognized_canonical_checkpoint_verified":{"const":true},
        "chain_finality_verified":{"const":true},
        "protocol_consensus_finality_claimed":{"const":false}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "finality_verification_only",
        "sovereign_checkpoint_signature_verified","receipt_verification_bound",
        "transaction_submission_authorized","automatic_retry_authorized",
        "filesystem_mutation_performed","sovereign_private_key_access_performed",
        "wallet_access_performed","transaction_signing_performed",
        "direct_rpc_call_performed","direct_network_call_performed",
        "chain2050_write_direct_performed"
      ],
      "properties":{
        "finality_verification_only":{"const":true},
        "sovereign_checkpoint_signature_verified":{"const":true},
        "receipt_verification_bound":{"const":true},
        "transaction_submission_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false},
        "filesystem_mutation_performed":{"const":false},
        "sovereign_private_key_access_performed":{"const":false},
        "wallet_access_performed":{"const":false},
        "transaction_signing_performed":{"const":false},
        "direct_rpc_call_performed":{"const":false},
        "direct_network_call_performed":{"const":false},
        "chain2050_write_direct_performed":{"const":false}
      }
    },
    "next_gate":{
      "enum":[
        "datanet_content_commitment_finalized_receipt_admission_v1",
        "datanet_content_commitment_reverted_terminal_closeout_v1"
      ]
    },
    "finality_verification_id":{
      "type":"string","pattern":"^voiddccrfv1_[0-9a-f]{64}$"
    },
    "finality_verified":{"const":true},
    "protocol_consensus_finality_claimed":{"const":false},
    "transaction_submission_authorized":{"const":false},
    "automatic_retry_allowed":{"const":false},
    "filesystem_mutation_performed":{"const":false},
    "sovereign_private_key_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "direct_rpc_call_performed":{"const":false},
    "direct_network_call_performed":{"const":false},
    "chain2050_write_direct_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
