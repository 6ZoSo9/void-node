{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-opaque-signed-receipt-verification-v1.schema.json",
  "title":"VOID DataNet Content Commitment Opaque Signed Receipt Verification v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id","signing_request_id",
    "opaque_signed_receipt_id","authorization_id","consumption_record_id",
    "final_signing_review_preflight_id",
    "external_signing_idempotency_key_sha256",
    "unsigned_transaction_candidate_fingerprint_sha256",
    "publisher_address","recovered_publisher_attestation_address",
    "signed_transaction_hash","custody_handle_fingerprint_sha256",
    "signed_at_utc","verification","authority","next_gate",
    "opaque_signed_receipt_verification_id",
    "publisher_wallet_attestation_verified",
    "raw_signed_transaction_accessed",
    "raw_signed_transaction_verified_by_application",
    "filesystem_mutation_performed","transaction_signer_access_performed",
    "wallet_access_performed","transaction_signing_performed",
    "transaction_broadcast_performed","chain2050_write_performed",
    "authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_OPAQUE_SIGNED_RECEIPT_VERIFICATION_V1"
    },
    "version":{"const":1},
    "status":{"const":"opaque_signed_receipt_publisher_attestation_verified"},
    "chain_id":{"const":"2050"},
    "signing_request_id":{
      "type":"string","pattern":"^voiddccpsreq1_[0-9a-f]{64}$"
    },
    "opaque_signed_receipt_id":{
      "type":"string","pattern":"^voiddccosr1_[0-9a-f]{64}$"
    },
    "authorization_id":{"type":"string","pattern":"^voiddccsta1_[0-9a-f]{64}$"},
    "consumption_record_id":{
      "type":"string","pattern":"^voiddccstac1_[0-9a-f]{64}$"
    },
    "final_signing_review_preflight_id":{
      "type":"string","pattern":"^voiddccfsrp1_[0-9a-f]{64}$"
    },
    "external_signing_idempotency_key_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "publisher_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "recovered_publisher_attestation_address":{
      "type":"string","pattern":"^0x[0-9a-f]{40}$"
    },
    "signed_transaction_hash":{
      "type":"string","pattern":"^0x[0-9a-f]{64}$"
    },
    "custody_handle_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "signed_at_utc":{"type":"string"},
    "verification":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "signing_request_content_id_rederived",
        "unsigned_transaction_fingerprint_rederived",
        "transaction_summary_rederived",
        "publisher_wallet_attestation_verified",
        "signed_transaction_hash_attested_by_publisher",
        "custody_handle_fingerprint_attested_by_publisher",
        "external_signing_idempotency_key_attested_by_publisher",
        "raw_signed_transaction_accessed",
        "raw_signed_transaction_verified_by_application",
        "external_custody_inspection_still_required_for_payload_bytes"
      ],
      "properties":{
        "signing_request_content_id_rederived":{"const":true},
        "unsigned_transaction_fingerprint_rederived":{"const":true},
        "transaction_summary_rederived":{"const":true},
        "publisher_wallet_attestation_verified":{"const":true},
        "signed_transaction_hash_attested_by_publisher":{"const":true},
        "custody_handle_fingerprint_attested_by_publisher":{"const":true},
        "external_signing_idempotency_key_attested_by_publisher":{"const":true},
        "raw_signed_transaction_accessed":{"const":false},
        "raw_signed_transaction_verified_by_application":{"const":false},
        "external_custody_inspection_still_required_for_payload_bytes":{"const":true}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "receipt_verification_only","transaction_signer_access_performed",
        "wallet_access_performed","transaction_signing_performed",
        "filesystem_mutation_performed","transaction_broadcast_authorized",
        "transaction_broadcast_performed","chain2050_write_authorized",
        "chain2050_write_performed","validator_mutation_authorized",
        "governance_mutation_authorized","work_credit_mutation_authorized",
        "service_action_authorized","funds_action_authorized",
        "automatic_retry_authorized"
      ],
      "properties":{
        "receipt_verification_only":{"const":true},
        "transaction_signer_access_performed":{"const":false},
        "wallet_access_performed":{"const":false},
        "transaction_signing_performed":{"const":false},
        "filesystem_mutation_performed":{"const":false},
        "transaction_broadcast_authorized":{"const":false},
        "transaction_broadcast_performed":{"const":false},
        "chain2050_write_authorized":{"const":false},
        "chain2050_write_performed":{"const":false},
        "validator_mutation_authorized":{"const":false},
        "governance_mutation_authorized":{"const":false},
        "work_credit_mutation_authorized":{"const":false},
        "service_action_authorized":{"const":false},
        "funds_action_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false}
      }
    },
    "next_gate":{
      "const":"explicit_sovereign_broadcast_authorization_for_exact_opaque_signed_receipt_v1"
    },
    "opaque_signed_receipt_verification_id":{
      "type":"string","pattern":"^voiddccosrv1_[0-9a-f]{64}$"
    },
    "publisher_wallet_attestation_verified":{"const":true},
    "raw_signed_transaction_accessed":{"const":false},
    "raw_signed_transaction_verified_by_application":{"const":false},
    "filesystem_mutation_performed":{"const":false},
    "transaction_signer_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "transaction_broadcast_performed":{"const":false},
    "chain2050_write_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
