{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-exact-single-submission-v1.schema.json",
  "title":"VOID DataNet Content Commitment Exact Single Submission v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","applied","chain_id",
    "broadcast_authorization_id","broadcast_consumption_record_id",
    "inspection_request_id","submission_intent_id",
    "submission_idempotency_key_sha256","signed_transaction_hash",
    "custody_handle_fingerprint_sha256",
    "canonical_state_store_realpath_sha256","provider_submission_id",
    "submission_result_status","definitive_not_submitted",
    "submission_call_performed","submission_may_have_occurred",
    "durable_submission_intent_published","inspection_method_invoked",
    "submit_method_invoked","reconciliation_required",
    "automatic_retry_allowed","raw_signed_transaction_accessed",
    "opaque_custody_handle_accessed","sovereign_private_key_access_performed",
    "wallet_access_performed","transaction_signing_performed",
    "direct_rpc_call_performed","direct_network_call_performed",
    "chain2050_write_direct_performed","next_gate","authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_EXACT_SINGLE_SUBMISSION_V1"
    },
    "version":{"const":1},
    "status":{
      "const":"exact_single_submission_attempted_reconciliation_required"
    },
    "applied":{"const":true},
    "chain_id":{"const":"2050"},
    "broadcast_authorization_id":{
      "type":"string","pattern":"^voiddccba1_[0-9a-f]{64}$"
    },
    "broadcast_consumption_record_id":{
      "type":"string","pattern":"^voiddccbac1_[0-9a-f]{64}$"
    },
    "inspection_request_id":{
      "type":"string","pattern":"^voiddccbair1_[0-9a-f]{64}$"
    },
    "submission_intent_id":{
      "type":"string","pattern":"^voiddccbasi1_[0-9a-f]{64}$"
    },
    "submission_idempotency_key_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "signed_transaction_hash":{
      "type":"string","pattern":"^0x[0-9a-f]{64}$"
    },
    "custody_handle_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "canonical_state_store_realpath_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "provider_submission_id":{"type":"string","maxLength":200},
    "submission_result_status":{
      "enum":["not_submitted","unknown","accepted"]
    },
    "definitive_not_submitted":{"type":"boolean"},
    "submission_call_performed":{"type":"boolean"},
    "submission_may_have_occurred":{"type":"boolean"},
    "durable_submission_intent_published":{"const":true},
    "inspection_method_invoked":{"const":true},
    "submit_method_invoked":{"const":true},
    "reconciliation_required":{"const":true},
    "automatic_retry_allowed":{"const":false},
    "raw_signed_transaction_accessed":{"const":false},
    "opaque_custody_handle_accessed":{"const":false},
    "sovereign_private_key_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "direct_rpc_call_performed":{"const":false},
    "direct_network_call_performed":{"const":false},
    "chain2050_write_direct_performed":{"const":false},
    "next_gate":{
      "const":"broadcast_reconciliation_without_resubmission_v1"
    },
    "authority_contract":{"type":"object"}
  }
}
