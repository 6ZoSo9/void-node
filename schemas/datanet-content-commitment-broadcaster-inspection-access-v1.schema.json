{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-broadcaster-inspection-access-v1.schema.json",
  "title":"VOID DataNet Content Commitment Broadcaster Inspection Access v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "broadcast_authorization_id","broadcast_authorization_verification_id",
    "broadcast_consumption_record_id","opaque_signed_receipt_verification_id",
    "opaque_signed_receipt_id","signing_request_id","signing_authorization_id",
    "signing_consumption_record_id","external_signing_idempotency_key_sha256",
    "unsigned_transaction_candidate_fingerprint_sha256","publisher_address",
    "signed_transaction_hash","custody_handle_fingerprint_sha256",
    "canonical_state_store_realpath_sha256",
    "issued_at_utc","expires_at_utc","consumed_at_utc","inspected_at_utc",
    "inspection_request_id","inspection","authority","next_gate",
    "broadcaster_access_performed","inspection_method_invoked",
    "submit_method_invoked","raw_signed_transaction_accessed",
    "opaque_custody_handle_accessed","transaction_broadcast_performed",
    "chain2050_write_performed","filesystem_mutation_performed",
    "authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_BROADCASTER_INSPECTION_ACCESS_V1"
    },
    "version":{"const":1},
    "status":{
      "const":"exact_consumed_broadcast_authorization_inspected_submission_disabled"
    },
    "chain_id":{"const":"2050"},
    "broadcast_authorization_id":{
      "type":"string","pattern":"^voiddccba1_[0-9a-f]{64}$"
    },
    "broadcast_authorization_verification_id":{
      "type":"string","pattern":"^voiddccbav1_[0-9a-f]{64}$"
    },
    "broadcast_consumption_record_id":{
      "type":"string","pattern":"^voiddccbac1_[0-9a-f]{64}$"
    },
    "opaque_signed_receipt_verification_id":{
      "type":"string","pattern":"^voiddccosrv1_[0-9a-f]{64}$"
    },
    "opaque_signed_receipt_id":{
      "type":"string","pattern":"^voiddccosr1_[0-9a-f]{64}$"
    },
    "signing_request_id":{
      "type":"string","pattern":"^voiddccpsreq1_[0-9a-f]{64}$"
    },
    "signing_authorization_id":{
      "type":"string","pattern":"^voiddccsta1_[0-9a-f]{64}$"
    },
    "signing_consumption_record_id":{
      "type":"string","pattern":"^voiddccstac1_[0-9a-f]{64}$"
    },
    "external_signing_idempotency_key_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "publisher_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "signed_transaction_hash":{"type":"string","pattern":"^0x[0-9a-f]{64}$"},
    "custody_handle_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "canonical_state_store_realpath_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "issued_at_utc":{"type":"string"},
    "expires_at_utc":{"type":"string"},
    "consumed_at_utc":{"type":"string"},
    "inspected_at_utc":{"type":"string"},
    "inspection_request_id":{
      "type":"string","pattern":"^voiddccbair1_[0-9a-f]{64}$"
    },
    "inspection":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "status","transaction_hash","provider_submission_id",
        "definitive_not_submitted","submission_may_have_occurred",
        "reconciliation_required","later_single_submission_gate_candidate"
      ],
      "properties":{
        "status":{
          "enum":["not_submitted","unknown","accepted","confirmed","reverted"]
        },
        "transaction_hash":{"type":"string","pattern":"^0x[0-9a-f]{64}$"},
        "provider_submission_id":{"type":"string","maxLength":200},
        "definitive_not_submitted":{"type":"boolean"},
        "submission_may_have_occurred":{"type":"boolean"},
        "reconciliation_required":{"type":"boolean"},
        "later_single_submission_gate_candidate":{"type":"boolean"}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "durable_consumption_record_verified","canonical_state_store_verified",
        "expiry_rechecked_before_broadcaster_access","metadata_only_request",
        "broadcaster_access_performed","inspection_method_invoked",
        "submit_method_invoked","transaction_submission_authorized_by_this_gate",
        "raw_signed_transaction_accessed","opaque_custody_handle_accessed",
        "filesystem_mutation_performed","sovereign_private_key_access_performed",
        "wallet_access_performed","transaction_signing_performed",
        "transaction_broadcast_performed","chain2050_write_performed",
        "automatic_retry_authorized"
      ],
      "properties":{
        "durable_consumption_record_verified":{"const":true},
        "canonical_state_store_verified":{"const":true},
        "expiry_rechecked_before_broadcaster_access":{"const":true},
        "metadata_only_request":{"const":true},
        "broadcaster_access_performed":{"const":true},
        "inspection_method_invoked":{"const":true},
        "submit_method_invoked":{"const":false},
        "transaction_submission_authorized_by_this_gate":{"const":false},
        "raw_signed_transaction_accessed":{"const":false},
        "opaque_custody_handle_accessed":{"const":false},
        "filesystem_mutation_performed":{"const":false},
        "sovereign_private_key_access_performed":{"const":false},
        "wallet_access_performed":{"const":false},
        "transaction_signing_performed":{"const":false},
        "transaction_broadcast_performed":{"const":false},
        "chain2050_write_performed":{"const":false},
        "automatic_retry_authorized":{"const":false}
      }
    },
    "next_gate":{
      "enum":[
        "broadcast_reconciliation_without_resubmission_v1",
        "exact_single_submission_from_inspected_consumed_broadcast_authorization_v1"
      ]
    },
    "broadcaster_access_performed":{"const":true},
    "inspection_method_invoked":{"const":true},
    "submit_method_invoked":{"const":false},
    "raw_signed_transaction_accessed":{"const":false},
    "opaque_custody_handle_accessed":{"const":false},
    "transaction_broadcast_performed":{"const":false},
    "chain2050_write_performed":{"const":false},
    "filesystem_mutation_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
