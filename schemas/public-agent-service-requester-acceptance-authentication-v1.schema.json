{
  "$id": "https://voidchain.io/schemas/public-agent-service-requester-acceptance-authentication-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authenticated_quote_acceptance_handoff_input": {
      "$ref": "public-agent-service-authenticated-quote-acceptance-handoff-v1.schema.json"
    },
    "evidence_mode": {
      "enum": [
        "example_fixture",
        "external_requester_evidence"
      ]
    },
    "marker": {
      "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_ACCEPTANCE_AUTHENTICATION_V1"
    },
    "requester_authentication_envelope": {
      "additionalProperties": false,
      "properties": {
        "acceptance_nonce": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]{16,128}$",
          "type": "string"
        },
        "authentication_nonce": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]{16,128}$",
          "type": "string"
        },
        "canonicalization": {
          "const": "void-canonical-json-v1"
        },
        "catalog_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "created_at_utc": {
          "format": "date-time",
          "type": "string"
        },
        "expires_at_utc": {
          "format": "date-time",
          "type": "string"
        },
        "handoff_id": {
          "pattern": "^voidawah1_[0-9a-f]{64}$",
          "type": "string"
        },
        "marker": {
          "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_ACCEPTANCE_AUTHENTICATION_EVIDENCE_V1"
        },
        "provider_authentication_id": {
          "pattern": "^voidawqa1_[0-9a-f]{64}$",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
          "type": "string"
        },
        "provider_key_binding_id": {
          "pattern": "^voidapkb1_[0-9a-f]{64}$",
          "type": "string"
        },
        "provider_key_id": {
          "pattern": "^ed25519:[0-9a-f]{64}$",
          "type": "string"
        },
        "quote_handoff_id": {
          "pattern": "^voidawqh1_[0-9a-f]{64}$",
          "type": "string"
        },
        "quote_id": {
          "pattern": "^voidawq1_[0-9a-f]{64}$",
          "type": "string"
        },
        "requester_agent_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
          "type": "string"
        },
        "requester_authentication_id": {
          "pattern": "^voidawra1_[0-9a-f]{64}$",
          "type": "string"
        },
        "requester_key_binding_id": {
          "pattern": "^voidarkb1_[0-9a-f]{64}$",
          "type": "string"
        },
        "response_id": {
          "pattern": "^voidawqr1_[0-9a-f]{64}$",
          "type": "string"
        },
        "signature_base64": {
          "maxLength": 88,
          "minLength": 88,
          "type": "string"
        },
        "signature_domain": {
          "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_ACCEPTANCE_AUTHENTICATION_V1"
        },
        "signature_scheme": {
          "const": "ed25519-spki-sha256-v1"
        },
        "version": {
          "const": 1
        },
        "work_order_id": {
          "pattern": "^voidawo1_[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "marker",
        "version",
        "signature_scheme",
        "signature_domain",
        "canonicalization",
        "handoff_id",
        "provider_authentication_id",
        "provider_key_binding_id",
        "provider_key_id",
        "response_id",
        "quote_id",
        "quote_handoff_id",
        "work_order_id",
        "requester_agent_id",
        "provider_id",
        "catalog_fingerprint_sha256",
        "requester_key_binding_id",
        "acceptance_nonce",
        "authentication_nonce",
        "created_at_utc",
        "expires_at_utc",
        "signature_base64",
        "requester_authentication_id"
      ],
      "type": "object"
    },
    "requester_key_binding": {
      "additionalProperties": false,
      "properties": {
        "authority_scope": {
          "const": "agent_paid_work_accept"
        },
        "binding_id": {
          "pattern": "^voidarkb1_[0-9a-f]{64}$",
          "type": "string"
        },
        "binding_nonce": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]{16,128}$",
          "type": "string"
        },
        "binding_status": {
          "enum": [
            "example_fixture",
            "operator_approved_snapshot"
          ]
        },
        "expires_at_utc": {
          "format": "date-time",
          "type": "string"
        },
        "key_id": {
          "pattern": "^ed25519:[0-9a-f]{64}$",
          "type": "string"
        },
        "marker": {
          "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_ACCEPTANCE_KEY_BINDING_V1"
        },
        "public_key_pem": {
          "maxLength": 256,
          "minLength": 100,
          "type": "string"
        },
        "requester_agent_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
          "type": "string"
        },
        "revoked_at_utc": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "valid_from_utc": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "marker",
        "version",
        "binding_status",
        "requester_agent_id",
        "authority_scope",
        "key_id",
        "public_key_pem",
        "valid_from_utc",
        "expires_at_utc",
        "revoked_at_utc",
        "binding_nonce",
        "binding_id"
      ],
      "type": "object"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "marker",
    "version",
    "evidence_mode",
    "authenticated_quote_acceptance_handoff_input",
    "requester_key_binding",
    "requester_authentication_envelope"
  ],
  "title": "VOID Public Agent Service Requester Acceptance Authentication V1",
  "type": "object",
  "x_void_marker": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_ACCEPTANCE_AUTHENTICATION_SCHEMA_V1"
}
