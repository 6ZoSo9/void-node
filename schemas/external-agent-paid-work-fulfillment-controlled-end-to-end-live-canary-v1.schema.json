{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://void.example/schemas/external-agent-paid-work-fulfillment-controlled-end-to-end-live-canary-v1.schema.json",
  "title": "VOID controlled end-to-end live fulfillment canary V1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "version",
    "mode",
    "canary_id",
    "account",
    "expected_award_wc",
    "coordinator",
    "executor",
    "pre_state",
    "expected_post_state",
    "stack_hashes",
    "phase_profiles"
  ],
  "properties": {
    "marker": {
      "const": "VOID_EXTERNAL_AGENT_PAID_WORK_FULFILLMENT_CONTROLLED_END_TO_END_LIVE_CANARY_MANIFEST_V1"
    },
    "version": { "const": 1 },
    "mode": { "enum": ["mock", "live"] },
    "canary_id": { "type": "string", "minLength": 3, "maxLength": 180 },
    "account": { "type": "string", "minLength": 3, "maxLength": 180 },
    "expected_award_wc": { "const": 3 },
    "coordinator": { "$ref": "#/$defs/host" },
    "executor": { "$ref": "#/$defs/host" },
    "pre_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_active_tickets",
        "global_consumed_tickets",
        "global_ticket_cap",
        "remaining_global_ticket_capacity",
        "fresh_account_ticket_total",
        "fresh_account_redeemable"
      ],
      "properties": {
        "global_active_tickets": { "const": 0 },
        "global_consumed_tickets": { "type": "integer", "minimum": 0 },
        "global_ticket_cap": { "type": "integer", "minimum": 1 },
        "remaining_global_ticket_capacity": { "type": "integer", "minimum": 1 },
        "fresh_account_ticket_total": { "const": 0 },
        "fresh_account_redeemable": { "const": 0 }
      }
    },
    "expected_post_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_active_tickets",
        "global_consumed_tickets",
        "fresh_account_ticket_total",
        "fresh_account_redeemable"
      ],
      "properties": {
        "global_active_tickets": { "const": 0 },
        "global_consumed_tickets": { "type": "integer", "minimum": 1 },
        "fresh_account_ticket_total": { "const": 1 },
        "fresh_account_redeemable": { "const": 3 }
      }
    },
    "stack_hashes": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "phase_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_ticket",
        "transfer_package",
        "execute_on_nimo",
        "accept_and_finalize",
        "duplicate_probe_and_seal"
      ],
      "properties": {
        "issue_ticket": { "$ref": "#/$defs/phase" },
        "transfer_package": { "$ref": "#/$defs/phase" },
        "execute_on_nimo": { "$ref": "#/$defs/phase" },
        "accept_and_finalize": { "$ref": "#/$defs/phase" },
        "duplicate_probe_and_seal": { "$ref": "#/$defs/phase" }
      }
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tailscale_ip", "node_id", "role"],
      "properties": {
        "tailscale_ip": { "type": "string", "minLength": 7 },
        "node_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "role": { "enum": ["coordinator_only", "executor_only"] }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation", "transport_mode", "command", "expected"],
      "properties": {
        "confirmation": { "type": "string", "minLength": 10 },
        "transport_mode": { "enum": ["mock", "live"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 900000 },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["marker", "assertions"],
          "properties": {
            "marker": { "type": "string", "minLength": 5 },
            "assertions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["pointer"],
                "properties": {
                  "pointer": { "type": "string", "pattern": "^/" },
                  "equals": {},
                  "type": { "enum": ["string", "number", "boolean", "object", "array", "null"] },
                  "hex64": { "type": "boolean" },
                  "nonempty": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    }
  }
}
