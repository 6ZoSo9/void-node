{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "void://schemas/public-node/mainnet0-public-node-operator-readiness-chain-rollup-hold-v1.schema.json",
  "title": "VOID Mainnet-0 Public Node Operator Readiness Chain Rollup Hold v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "lane",
    "status",
    "public_surface",
    "source_chain",
    "authority",
    "summary"
  ],
  "properties": {
    "marker": {
      "const": "VOID_MAINNET0_PUBLIC_NODE_OPERATOR_READINESS_CHAIN_ROLLUP_HOLD_V1_GREEN"
    },
    "lane": {
      "const": "mainnet0-public-node-operator-readiness-chain-rollup-hold-v1"
    },
    "status": {
