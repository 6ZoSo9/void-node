    },
    "public_surface": {
      "const": "read_only_static_chain_rollup"
    },
    "source_chain": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "lane", "marker", "status", "json"],
        "properties": {
          "order": { "type": "integer" },
          "lane": { "type": "string" },
          "marker": { "type": "string" },
          "status": { "type": "string" },
          "json": { "type": "string" },
          "html": { "type": "string" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_enabled",
        "checklist_submission_enabled",
        "validator_admission_enabled",
        "validator_activation_enabled",
        "staking_enabled",
        "wallet_connect_enabled",
        "public_mutation_enabled",
        "ledger_write_enabled",
        "peer_state_write_enabled",
        "validator_set_write_enabled"
      ],
      "properties": {
        "registration_enabled": { "const": false },
        "checklist_submission_enabled": { "const": false },
        "validator_admission_enabled": { "const": false },
        "validator_activation_enabled": { "const": false },
        "staking_enabled": { "const": false },
        "wallet_connect_enabled": { "const": false },
        "public_mutation_enabled": { "const": false },
        "ledger_write_enabled": { "const": false },
        "peer_state_write_enabled": { "const": false },
        "validator_set_write_enabled": { "const": false }
      }
    },
