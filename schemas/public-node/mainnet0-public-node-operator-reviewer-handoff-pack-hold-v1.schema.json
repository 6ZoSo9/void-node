{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "void://schemas/public-node/mainnet0-public-node-operator-reviewer-handoff-pack-hold-v1.schema.json",
  "title": "VOID Mainnet-0 Public Node Operator Reviewer Handoff Pack Hold v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "lane",
    "status",
    "public_surface",
    "review_order",
    "source_markers",
    "source_links",
    "root_index_link",
    "authority",
    "reviewer_summary"
  ],
  "properties": {
    "marker": {
      "const": "VOID_MAINNET0_PUBLIC_NODE_OPERATOR_REVIEWER_HANDOFF_PACK_HOLD_V1_GREEN"
    },
    "lane": {
      "const": "mainnet0-public-node-operator-reviewer-handoff-pack-hold-v1"
    },
    "status": {
      "const": "reviewer_handoff_pack_hold"
    },
    "public_surface": {
      "const": "read_only_static_reviewer_handoff_pack"
    },
    "review_order": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "label", "lane", "marker", "review_note"],
        "properties": {
          "order": { "type": "integer" },
          "label": { "type": "string" },
          "lane": { "type": "string" },
          "marker": { "type": "string" },
          "review_note": { "type": "string" },
          "json": { "type": "string" },
          "html": { "type": "string" }
        }
      }
    },
    "source_markers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "string" }
    },
    "source_links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_json",
        "matrix_html",
        "checklist_json",
        "checklist_html",
        "chain_rollup_json",
        "chain_rollup_html",
        "final_seal_json",
        "final_seal_html",
        "root_index_json"
      ],
      "properties": {
        "matrix_json": { "type": "string" },
        "matrix_html": { "type": "string" },
        "checklist_json": { "type": "string" },
        "checklist_html": { "type": "string" },
        "chain_rollup_json": { "type": "string" },
        "chain_rollup_html": { "type": "string" },
        "final_seal_json": { "type": "string" },
        "final_seal_html": { "type": "string" },
        "root_index_json": { "type": "string" }
      }
    },
    "root_index_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "json", "html"],
      "properties": {
        "enabled": { "const": true },
        "json": { "const": "/public-node/mainnet0-public-node-operator-reviewer-handoff-pack-hold-v1.json" },
        "html": { "const": "/public-node/mainnet0-public-node-operator-reviewer-handoff-pack-hold-v1.html" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_enabled",
        "checklist_submission_enabled",
        "validator_admission_enabled",
        "validator_activation_enabled",
        "staking_enabled",
        "wallet_connect_enabled",
        "public_mutation_enabled",
        "ledger_write_enabled",
        "peer_state_write_enabled",
        "validator_set_write_enabled"
      ],
      "properties": {
        "registration_enabled": { "const": false },
        "checklist_submission_enabled": { "const": false },
        "validator_admission_enabled": { "const": false },
        "validator_activation_enabled": { "const": false },
        "staking_enabled": { "const": false },
        "wallet_connect_enabled": { "const": false },
        "public_mutation_enabled": { "const": false },
        "ledger_write_enabled": { "const": false },
        "peer_state_write_enabled": { "const": false },
        "validator_set_write_enabled": { "const": false }
      }
    },
    "reviewer_summary": {
      "type": "string"
    }
  }
}
