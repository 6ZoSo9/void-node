{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-final-signing-review-preflight-v1.schema.json",
  "title":"VOID DataNet Content Commitment Final Signing Review Preflight v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "prior_credential_binding_id","fresh_pre_sign_revalidation_id",
    "fresh_credential_binding_id","publisher_address",
    "unsigned_transaction_candidate",
    "unsigned_transaction_candidate_fingerprint_sha256",
    "revalidation","authority","next_gate",
    "final_signing_review_preflight_id",
    "signer_object_exposed","signing_authorized","signing_performed",
    "transaction_broadcast_authorized","transaction_broadcast_performed",
    "chain2050_write_authorized","chain2050_write_performed",
    "authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_FINAL_SIGNING_REVIEW_PREFLIGHT_V1"
    },
    "version":{"const":1},
    "status":{
      "const":"fresh_candidate_and_publisher_identity_ready_for_separate_signing_authorization_review"
    },
    "chain_id":{"const":"2050"},
    "prior_credential_binding_id":{
      "type":"string","pattern":"^voiddccpcb1_[0-9a-f]{64}$"
    },
    "fresh_pre_sign_revalidation_id":{
      "type":"string","pattern":"^voiddccpsr1_[0-9a-f]{64}$"
    },
    "fresh_credential_binding_id":{
      "type":"string","pattern":"^voiddccpcb1_[0-9a-f]{64}$"
    },
    "publisher_address":{
      "type":"string","pattern":"^0x[0-9a-f]{40}$"
    },
    "unsigned_transaction_candidate":{
      "type":"object"
    },
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "revalidation":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "full_pre_sign_revalidation_rerun",
        "repaired_freshness_wall_reapplied",
        "pending_nonce_rechecked_after_final_preflight",
        "credential_identity_binding_rerun_after_fresh_pre_sign",
        "prior_binding_used_as_lineage_only",
        "stale_pre_sign_result_authorizes_signing"
      ],
      "properties":{
        "full_pre_sign_revalidation_rerun":{"const":true},
        "repaired_freshness_wall_reapplied":{"const":true},
        "pending_nonce_rechecked_after_final_preflight":{"const":true},
        "credential_identity_binding_rerun_after_fresh_pre_sign":{"const":true},
        "prior_binding_used_as_lineage_only":{"const":true},
        "stale_pre_sign_result_authorizes_signing":{"const":false}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "review_artifact_only",
        "separate_explicit_signing_authorization_required",
        "signer_object_exposed","signer_access_authorized",
        "wallet_access_authorized",
        "transaction_signing_authorized","transaction_signing_performed",
        "transaction_broadcast_authorized","transaction_broadcast_performed",
        "chain2050_write_authorized","chain2050_write_performed",
        "validator_mutation_authorized","governance_mutation_authorized",
        "work_credit_mutation_authorized","service_action_authorized",
        "funds_action_authorized","automatic_retry_authorized"
      ],
      "properties":{
        "review_artifact_only":{"const":true},
        "separate_explicit_signing_authorization_required":{"const":true},
        "signer_object_exposed":{"const":false},
        "signer_access_authorized":{"const":false},
        "wallet_access_authorized":{"const":false},
        "transaction_signing_authorized":{"const":false},
        "transaction_signing_performed":{"const":false},
        "transaction_broadcast_authorized":{"const":false},
        "transaction_broadcast_performed":{"const":false},
        "chain2050_write_authorized":{"const":false},
        "chain2050_write_performed":{"const":false},
        "validator_mutation_authorized":{"const":false},
        "governance_mutation_authorized":{"const":false},
        "work_credit_mutation_authorized":{"const":false},
        "service_action_authorized":{"const":false},
        "funds_action_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false}
      }
    },
    "next_gate":{
      "const":"explicit_sovereign_single_transaction_signing_authorization_v1"
    },
    "final_signing_review_preflight_id":{
      "type":"string","pattern":"^voiddccfsrp1_[0-9a-f]{64}$"
    },
    "signer_object_exposed":{"const":false},
    "signing_authorized":{"const":false},
    "signing_performed":{"const":false},
    "transaction_broadcast_authorized":{"const":false},
    "transaction_broadcast_performed":{"const":false},
    "chain2050_write_authorized":{"const":false},
    "chain2050_write_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
