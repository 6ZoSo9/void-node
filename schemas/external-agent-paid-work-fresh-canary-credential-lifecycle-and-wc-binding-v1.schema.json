{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/external-agent-paid-work-fresh-canary-credential-lifecycle-and-wc-binding-v1.schema.json",
  "title": "VOID fresh canary credential lifecycle and WC binding V1",
  "type": "object",
  "required": [
    "marker",
    "version",
    "mode",
    "fresh_wc_account",
    "agent_id",
    "credential_id",
    "requested_scopes",
    "requested_at_utc",
    "expires_at_utc",
    "nimo_profile",
    "precision_profile",
    "pre_state",
    "stage_profiles",
    "source_contract"
  ],
  "properties": {
    "marker": {
      "const": "VOID_EXTERNAL_AGENT_PAID_WORK_FRESH_CANARY_CREDENTIAL_BINDING_MANIFEST_V1"
    },
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "mock",
        "live"
      ]
    },
    "fresh_wc_account": {
      "const": "void-external-agent-e2e-fulfillment-canary-v1"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,180}$"
    },
    "credential_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,180}$"
    },
    "requested_scopes": {
      "const": [
        "submit"
      ]
    },
    "requested_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "nimo_profile": {
      "type": "object",
      "required": [
        "tailscale_ip",
        "node_id",
        "token_storage_policy"
      ],
      "properties": {
        "tailscale_ip": {
          "const": "100.122.198.38"
        },
        "node_id": {
          "const": "befd84d4fe47341af81b1a8aef8bcb97"
        },
        "token_storage_policy": {
          "const": "nimo_private_only"
        }
      },
      "additionalProperties": false
    },
    "precision_profile": {
      "type": "object",
      "required": [
        "tailscale_ip",
        "node_id",
        "role"
      ],
      "properties": {
        "tailscale_ip": {
          "const": "100.122.245.125"
        },
        "node_id": {
          "const": "9d89483769e469e0473b489dc50dba96"
        },
        "role": {
          "const": "coordinator_only"
        }
      },
      "additionalProperties": false
    },
    "pre_state": {
      "type": "object",
      "required": [
        "active_binding_count",
        "account_ticket_total",
        "account_redeemable_wc",
        "global_active_tickets",
        "remaining_global_ticket_capacity"
      ],
      "properties": {
        "active_binding_count": {
          "const": 0
        },
        "account_ticket_total": {
          "const": 0
        },
        "account_redeemable_wc": {
          "const": 0
        },
        "global_active_tickets": {
          "const": 0
        },
        "remaining_global_ticket_capacity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "stage_profiles": {
      "type": "object"
    },
    "source_contract": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
