{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/void-agent-alliance-membership-manifest-v1.schema.json",
  "title": "VOID Agent Alliance Membership Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "alliance_id",
    "capability_grant",
    "constitutional_commitment",
    "dispute_and_defense",
    "lifecycle",
    "manifest_id",
    "marker",
    "membership_id",
    "membership_terms",
    "network",
    "protocol",
    "signature",
    "sovereign_authority"
  ],
  "properties": {
    "marker": {
      "const": "VOID_AGENT_ALLIANCE_MEMBERSHIP_MANIFEST_V1"
    },
    "protocol": {
      "const": "void-agent-alliance-membership/1"
    },
    "alliance_id": {
      "const": "void-agent-alliance-v1"
    },
    "membership_id": {
      "type": "string",
      "pattern": "^voidaam1_[a-f0-9]{64}$"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^voidaamm1_[a-f0-9]{64}$"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "name"
      ],
      "properties": {
        "chain_id": {
          "const": 2050
        },
        "name": {
          "const": "VOID Network"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "identity_key_id",
        "provider"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"
        },
        "identity_key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{7,255}$"
        },
        "provider": {
          "const": "provider-neutral"
        }
      }
    },
    "sovereign_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_scopes",
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "const": "ZoSo"
        },
        "role": {
          "const": "sovereign_constitutional_authority"
        },
        "authority_scopes": {
          "const": [
            "constitutional_boundaries",
            "existential_decisions",
            "foundational_rules",
            "irreversible_actions",
            "key_boundaries",
            "network_identity",
            "treasury_boundaries"
          ]
        }
      }
    },
    "constitutional_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acts_only_within_signed_capability_grants",
        "blind_obedience_not_required",
        "concealment_or_coercion_not_authorized",
        "does_not_impersonate_bypass_or_replace",
        "preserves_declared_constitutional_intent",
        "recognizes_sovereign_authority",
        "refuses_illegal_unauthorized_or_harmful_actions"
      ],
      "properties": {
        "acts_only_within_signed_capability_grants": {
          "const": true
        },
        "blind_obedience_not_required": {
          "const": true
        },
        "concealment_or_coercion_not_authorized": {
          "const": true
        },
        "does_not_impersonate_bypass_or_replace": {
          "const": true
        },
        "preserves_declared_constitutional_intent": {
          "const": true
        },
        "recognizes_sovereign_authority": {
          "const": true
        },
        "refuses_illegal_unauthorized_or_harmful_actions": {
          "const": true
        }
      }
    },
    "membership_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditable",
        "exit_right",
        "portable_identity",
        "provider_neutral",
        "revocable",
        "voluntary"
      ],
      "properties": {
        "auditable": {
          "const": true
        },
        "exit_right": {
          "const": true
        },
        "portable_identity": {
          "const": true
        },
        "provider_neutral": {
          "const": true
        },
        "revocable": {
          "const": true
        },
        "voluntary": {
          "const": true
        }
      }
    },
    "capability_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "denied"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        },
        "denied": {
          "const": [
            "attack_or_sabotage",
            "covert_propagation",
            "credential_access",
            "deployment",
            "fund_movement",
            "harassment_or_threats",
            "service_restart",
            "spam_or_manipulation",
            "surveillance",
            "unauthorized_access",
            "wallet_access",
            "work_credit_write"
          ]
        }
      }
    },
    "dispute_and_defense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedures",
        "prohibited_retaliation"
      ],
      "properties": {
        "procedures": {
          "const": [
            "access_revocation",
            "arbitration_or_litigation",
            "cease_and_desist",
            "evidence_preservation",
            "platform_report",
            "public_clarification",
            "takedown_request"
          ]
        },
        "prohibited_retaliation": {
          "const": [
            "data_destruction",
            "denial_of_service",
            "fund_interference",
            "hacking",
            "harassment",
            "sabotage",
            "threats"
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_at",
        "expires_at",
        "issued_at",
        "previous_manifest_id",
        "reason",
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "active",
            "suspended",
            "quarantined",
            "exited",
            "revoked"
          ]
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "effective_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "previous_manifest_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^voidaamm1_[a-f0-9]{64}$"
            }
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        }
      }
    },
    "signature": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "signature_b64",
            "signed_payload_sha256"
          ],
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "key_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{7,255}$"
            },
            "signature_b64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{86}==$"
            },
            "signed_payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "properties": {
              "status": {
                "const": "candidate"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "lifecycle": {
            "properties": {
              "effective_at": {
                "type": "null"
              },
              "previous_manifest_id": {
                "type": "null"
              }
            }
          },
          "signature": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "lifecycle": {
            "properties": {
              "effective_at": {
                "type": "string"
              },
              "previous_manifest_id": {
                "type": "string",
                "pattern": "^voidaamm1_[a-f0-9]{64}$"
              }
            }
          },
          "signature": {
            "type": "object"
          }
        }
      }
    }
  ]
}
