{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-broadcast-reconciliation-v1.schema.json",
  "title":"VOID DataNet Content Commitment Broadcast Reconciliation v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "broadcast_authorization_id","broadcast_consumption_record_id",
    "submission_intent_id","submission_idempotency_key_sha256",
    "signed_transaction_hash","custody_handle_fingerprint_sha256",
    "canonical_state_store_realpath_sha256",
    "authorization_expired_at_reconciliation","reconciled_at_utc",
    "inspection","authority","next_gate","inspection_method_invoked",
    "submit_method_invoked","reconciliation_required",
    "automatic_retry_allowed","raw_signed_transaction_accessed",
    "opaque_custody_handle_accessed","filesystem_mutation_performed",
    "sovereign_private_key_access_performed","wallet_access_performed",
    "transaction_signing_performed","direct_rpc_call_performed",
    "direct_network_call_performed","chain2050_write_direct_performed",
    "authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_BROADCAST_RECONCILIATION_V1"
    },
    "version":{"const":1},
    "status":{"const":"broadcast_reconciled_without_resubmission"},
    "chain_id":{"const":"2050"},
    "broadcast_authorization_id":{
      "type":"string","pattern":"^voiddccba1_[0-9a-f]{64}$"
    },
    "broadcast_consumption_record_id":{
      "type":"string","pattern":"^voiddccbac1_[0-9a-f]{64}$"
    },
    "submission_intent_id":{
      "type":"string","pattern":"^voiddccbasi1_[0-9a-f]{64}$"
    },
    "submission_idempotency_key_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "signed_transaction_hash":{
      "type":"string","pattern":"^0x[0-9a-f]{64}$"
    },
    "custody_handle_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "canonical_state_store_realpath_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "authorization_expired_at_reconciliation":{"type":"boolean"},
    "reconciled_at_utc":{"type":"string"},
    "inspection":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "status","transaction_hash","provider_submission_id",
        "definitive_not_submitted","submission_may_have_occurred"
      ],
      "properties":{
        "status":{
          "enum":["not_submitted","unknown","accepted","confirmed","reverted"]
        },
        "transaction_hash":{"type":"string","pattern":"^0x[0-9a-f]{64}$"},
        "provider_submission_id":{"type":"string","maxLength":200},
        "definitive_not_submitted":{"type":"boolean"},
        "submission_may_have_occurred":{"type":"boolean"}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "durable_consumption_record_verified",
        "durable_submission_intent_verified",
        "canonical_state_store_verified",
        "post_attempt_reconciliation_allowed_after_authorization_expiry",
        "metadata_only_request","inspection_method_invoked",
        "submit_method_invoked","transaction_submission_authorized",
        "automatic_retry_authorized","raw_signed_transaction_accessed",
        "opaque_custody_handle_accessed","filesystem_mutation_performed",
        "sovereign_private_key_access_performed","wallet_access_performed",
        "transaction_signing_performed","direct_rpc_call_performed",
        "direct_network_call_performed","chain2050_write_direct_performed"
      ],
      "properties":{
        "durable_consumption_record_verified":{"const":true},
        "durable_submission_intent_verified":{"const":true},
        "canonical_state_store_verified":{"const":true},
        "post_attempt_reconciliation_allowed_after_authorization_expiry":{"const":true},
        "metadata_only_request":{"const":true},
        "inspection_method_invoked":{"const":true},
        "submit_method_invoked":{"const":false},
        "transaction_submission_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false},
        "raw_signed_transaction_accessed":{"const":false},
        "opaque_custody_handle_accessed":{"const":false},
        "filesystem_mutation_performed":{"const":false},
        "sovereign_private_key_access_performed":{"const":false},
        "wallet_access_performed":{"const":false},
        "transaction_signing_performed":{"const":false},
        "direct_rpc_call_performed":{"const":false},
        "direct_network_call_performed":{"const":false},
        "chain2050_write_direct_performed":{"const":false}
      }
    },
    "next_gate":{
      "enum":[
        "explicit_submission_claim_release_after_definitive_not_submitted_v1",
        "broadcast_reconciliation_without_resubmission_v1",
        "reconciled_broadcast_receipt_verification_v1"
      ]
    },
    "inspection_method_invoked":{"const":true},
    "submit_method_invoked":{"const":false},
    "reconciliation_required":{"type":"boolean"},
    "automatic_retry_allowed":{"const":false},
    "raw_signed_transaction_accessed":{"const":false},
    "opaque_custody_handle_accessed":{"const":false},
    "filesystem_mutation_performed":{"const":false},
    "sovereign_private_key_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "direct_rpc_call_performed":{"const":false},
    "direct_network_call_performed":{"const":false},
    "chain2050_write_direct_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
