{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/public-agent-service-requester-trust-registry-snapshot-v1.schema.json",
  "x_void_marker": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_TRUST_REGISTRY_SNAPSHOT_SCHEMA_V1",
  "title": "VOID Public Agent Service Requester Trust Registry Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "version",
    "evidence_mode",
    "trust_root",
    "snapshot_body",
    "authentication_envelope"
  ],
  "properties": {
    "marker": {
      "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_TRUST_REGISTRY_SNAPSHOT_V1"
    },
    "version": {
      "const": 1
    },
    "evidence_mode": {
      "enum": [
        "example_fixture",
        "operator_signed_snapshot"
      ]
    },
    "trust_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker",
        "version",
        "trust_status",
        "authority_scope",
        "key_id",
        "public_key_pem",
        "valid_from_utc",
        "expires_at_utc",
        "revoked_at_utc",
        "root_nonce",
        "root_id"
      ],
      "properties": {
        "marker": {
          "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_TRUST_ROOT_V1"
        },
        "version": {
          "const": 1
        },
        "trust_status": {
          "enum": [
            "example_fixture",
            "operator_pinned_trust_root"
          ]
        },
        "authority_scope": {
          "const": "requester_trust_registry_snapshot_verify"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "public_key_pem": {
          "type": "string"
        },
        "valid_from_utc": {
          "type": "string"
        },
        "expires_at_utc": {
          "type": "string"
        },
        "revoked_at_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "root_nonce": {
          "type": "string"
        },
        "root_id": {
          "type": "string",
          "pattern": "^voidartr1_[0-9a-f]{64}$"
        }
      }
    },
    "snapshot_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker",
        "version",
        "snapshot_status",
        "registry_id",
        "sequence",
        "previous_snapshot_id",
        "generated_at_utc",
        "expires_at_utc",
        "snapshot_nonce",
        "requester_key_bindings"
      ],
      "properties": {
        "marker": {
          "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_TRUST_REGISTRY_SNAPSHOT_BODY_V1"
        },
        "version": {
          "const": 1
        },
        "snapshot_status": {
          "enum": [
            "example_fixture",
            "operator_approved_snapshot"
          ]
        },
        "registry_id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previous_snapshot_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^voidarts1_[0-9a-f]{64}$"
            }
          ]
        },
        "generated_at_utc": {
          "type": "string"
        },
        "expires_at_utc": {
          "type": "string"
        },
        "snapshot_nonce": {
          "type": "string"
        },
        "requester_key_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "marker",
              "version",
              "binding_status",
              "requester_agent_id",
              "authority_scope",
              "key_id",
              "public_key_pem",
              "valid_from_utc",
              "expires_at_utc",
              "revoked_at_utc",
              "binding_nonce",
              "binding_id"
            ],
            "properties": {
              "marker": {
                "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_ACCEPTANCE_KEY_BINDING_V1"
              },
              "version": {
                "const": 1
              },
              "binding_status": {
                "enum": [
                  "example_fixture",
                  "operator_approved_snapshot"
                ]
              },
              "requester_agent_id": {
                "type": "string"
              },
              "authority_scope": {
                "const": "agent_paid_work_accept"
              },
              "key_id": {
                "type": "string",
                "pattern": "^ed25519:[0-9a-f]{64}$"
              },
              "public_key_pem": {
                "type": "string"
              },
              "valid_from_utc": {
                "type": "string"
              },
              "expires_at_utc": {
                "type": "string"
              },
              "revoked_at_utc": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "binding_nonce": {
                "type": "string"
              },
              "binding_id": {
                "type": "string",
                "pattern": "^voidarkb1_[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "authentication_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker",
        "version",
        "signature_scheme",
        "signature_domain",
        "canonicalization",
        "snapshot_id",
        "trust_root_id",
        "key_id",
        "signed_at_utc",
        "signature_base64",
        "authentication_id"
      ],
      "properties": {
        "marker": {
          "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_TRUST_REGISTRY_SNAPSHOT_AUTHENTICATION_V1"
        },
        "version": {
          "const": 1
        },
        "signature_scheme": {
          "const": "ed25519-spki-sha256-v1"
        },
        "signature_domain": {
          "const": "VOID_PUBLIC_AGENT_SERVICE_REQUESTER_TRUST_REGISTRY_SNAPSHOT_V1"
        },
        "canonicalization": {
          "const": "void-canonical-json-v1"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^voidarts1_[0-9a-f]{64}$"
        },
        "trust_root_id": {
          "type": "string",
          "pattern": "^voidartr1_[0-9a-f]{64}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "signed_at_utc": {
          "type": "string"
        },
        "signature_base64": {
          "type": "string"
        },
        "authentication_id": {
          "type": "string",
          "pattern": "^voidartsa1_[0-9a-f]{64}$"
        }
      }
    }
  }
}
