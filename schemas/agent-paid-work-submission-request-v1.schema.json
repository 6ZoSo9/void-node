{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/agent-paid-work-submission-request-v1.schema.json",
  "title": "VOID Agent Paid Work Submission Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "version",
    "submission_id",
    "work_order"
  ],
  "properties": {
    "marker": {
      "const": "VOID_AGENT_PAID_WORK_SUBMISSION_REQUEST_V1"
    },
    "version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "work_order": {
      "$ref": "agent-paid-work-order-envelope-v1.schema.json"
    }
  }
}
