{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-finalized-event-membership-v1.schema.json",
  "title":"VOID DataNet Content Commitment Finalized Event Membership v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "finalized_receipt_admission_id","finality_verification_id",
    "checkpoint_attestation_id","signed_transaction_hash",
    "registry_address","publisher_address","object_id",
    "commitment","finalized_receipt","event_receipt","verification",
    "authority","next_gate","finalized_event_membership_id",
    "event_receipt_membership_verified","canonical_commitment_truth_admitted",
    "protocol_consensus_finality_claimed",
    "filesystem_mutation_performed","sovereign_private_key_access_performed",
    "wallet_access_performed","transaction_signing_performed",
    "transaction_submission_performed","direct_rpc_call_performed",
    "direct_network_call_performed","chain2050_write_direct_performed",
    "authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{"const":"VOID_DATANET_CONTENT_COMMITMENT_FINALIZED_EVENT_MEMBERSHIP_V1"},
    "version":{"const":1},
    "status":{"const":"finalized_content_committed_event_membership_verified_canonical_truth_pending"},
    "chain_id":{"const":"2050"},
    "finalized_receipt_admission_id":{"type":"string","pattern":"^voiddccfra1_[0-9a-f]{64}$"},
    "finality_verification_id":{"type":"string","pattern":"^voiddccrfv1_[0-9a-f]{64}$"},
    "checkpoint_attestation_id":{"type":"string","pattern":"^voiddccfca1_[0-9a-f]{64}$"},
    "signed_transaction_hash":{"type":"string","pattern":"^0x[0-9a-f]{64}$"},
    "registry_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "publisher_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "object_id":{"type":"string","minLength":1,"maxLength":160},
    "commitment":{
      "type":"object",
      "additionalProperties":false,
      "required":["object_id_sha256","content_sha256","byte_length","function_signature","calldata_sha256"],
      "properties":{
        "object_id_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "byte_length":{"type":"string","pattern":"^[1-9][0-9]{0,8}$"},
        "function_signature":{"const":"commit(bytes32,bytes32,uint64)"},
        "calldata_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "finalized_receipt":{"type":"object"},
    "event_receipt":{"type":"object"},
    "verification":{"type":"object"},
    "authority":{"type":"object"},
    "next_gate":{"const":"datanet_content_commitment_canonical_commitment_truth_admission_v1"},
    "finalized_event_membership_id":{"type":"string","pattern":"^voiddccfem1_[0-9a-f]{64}$"},
    "event_receipt_membership_verified":{"const":true},
    "canonical_commitment_truth_admitted":{"const":false},
    "protocol_consensus_finality_claimed":{"const":false},
    "filesystem_mutation_performed":{"const":false},
    "sovereign_private_key_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "transaction_submission_performed":{"const":false},
    "direct_rpc_call_performed":{"const":false},
    "direct_network_call_performed":{"const":false},
    "chain2050_write_direct_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
