{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/external-agent-paid-work-fresh-canary-credential-live-stage-commands-v1.schema.json",
  "title": "VOID fresh canary credential live stage command profile V1",
  "type": "object",
  "required": [
    "marker",
    "version",
    "mode",
    "fresh_wc_account",
    "expected_precision_ip",
    "expected_nimo_ip",
    "credential_registry_path",
    "binding_registry_path",
    "stage_state_root",
    "nimo_private_token_root",
    "nimo_private_registry_path",
    "nimo_ssh_target",
    "nimo_remote_script_path",
    "source_contract"
  ],
  "properties": {
    "marker": {
      "const": "VOID_EXTERNAL_AGENT_PAID_WORK_FRESH_CANARY_CREDENTIAL_LIVE_STAGE_COMMAND_PROFILE_V1"
    },
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "mock",
        "live"
      ]
    },
    "fresh_wc_account": {
      "const": "void-external-agent-e2e-fulfillment-canary-v1"
    },
    "expected_precision_ip": {
      "const": "100.122.245.125"
    },
    "expected_nimo_ip": {
      "const": "100.122.198.38"
    },
    "credential_registry_path": {
      "type": "string",
      "minLength": 1
    },
    "binding_registry_path": {
      "type": "string",
      "minLength": 1
    },
    "stage_state_root": {
      "type": "string",
      "minLength": 1
    },
    "nimo_private_token_root": {
      "type": "string",
      "minLength": 1
    },
    "nimo_private_registry_path": {
      "type": "string",
      "minLength": 1
    },
    "nimo_ssh_target": {
      "type": "string",
      "minLength": 1
    },
    "nimo_remote_script_path": {
      "type": "string",
      "minLength": 1
    },
    "source_contract": {
      "type": "object",
      "required": [
        "receipt_sha256",
        "checkpoint_commit"
      ],
      "properties": {
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpoint_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
