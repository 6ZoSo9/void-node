{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-single-use-authorization-consumption-v1.schema.json",
  "title":"VOID DataNet Content Commitment Single-Use Authorization Consumption v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id","authorization_id",
    "authorization_verification_id","final_signing_review_preflight_id",
    "fresh_pre_sign_revalidation_id","fresh_credential_binding_id",
    "unsigned_transaction_candidate_fingerprint_sha256","publisher_address",
    "transaction_summary","issued_at_utc","expires_at_utc","consumed_at_utc",
    "state_store_realpath_sha256","consumption","authority","next_gate",
    "consumption_record_id","durable_consumption_record_published",
    "consumption_record_mode","state_store_directory_mode",
    "signer_object_exposed","transaction_signer_access_performed",
    "wallet_access_performed","transaction_signing_performed",
    "transaction_broadcast_performed","chain2050_write_performed",
    "authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_SINGLE_USE_AUTHORIZATION_CONSUMPTION_V1"
    },
    "version":{"const":1},
    "status":{"const":"authorization_consumed_for_exact_transaction_signing"},
    "chain_id":{"const":"2050"},
    "authorization_id":{"type":"string","pattern":"^voiddccsta1_[0-9a-f]{64}$"},
    "authorization_verification_id":{
      "type":"string","pattern":"^voiddccstav1_[0-9a-f]{64}$"
    },
    "final_signing_review_preflight_id":{
      "type":"string","pattern":"^voiddccfsrp1_[0-9a-f]{64}$"
    },
    "fresh_pre_sign_revalidation_id":{
      "type":"string","pattern":"^voiddccpsr1_[0-9a-f]{64}$"
    },
    "fresh_credential_binding_id":{
      "type":"string","pattern":"^voiddccpcb1_[0-9a-f]{64}$"
    },
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "publisher_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "transaction_summary":{"type":"object"},
    "issued_at_utc":{"type":"string"},
    "expires_at_utc":{"type":"string"},
    "consumed_at_utc":{"type":"string"},
    "state_store_realpath_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "consumption":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "single_use","authorization_consumed","immutable_consumption_record",
        "replay_rejected_within_exact_state_store","replay_prevention_scope",
        "global_replay_prevention_claimed",
        "canonical_state_store_runtime_binding_required",
        "expiry_rechecked_at_consumption",
        "consumption_precedes_any_signer_access"
      ],
      "properties":{
        "single_use":{"const":true},
        "authorization_consumed":{"const":true},
        "immutable_consumption_record":{"const":true},
        "replay_rejected_within_exact_state_store":{"const":true},
        "replay_prevention_scope":{"const":"exact_state_store_realpath"},
        "global_replay_prevention_claimed":{"const":false},
        "canonical_state_store_runtime_binding_required":{"const":true},
        "expiry_rechecked_at_consumption":{"const":true},
        "consumption_precedes_any_signer_access":{"const":true}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "filesystem_mutation_performed","signer_object_exposed",
        "transaction_signer_access_performed","wallet_access_performed",
        "transaction_signing_authorized_by_this_gate",
        "transaction_signing_performed","transaction_broadcast_authorized",
        "transaction_broadcast_performed","chain2050_write_authorized",
        "chain2050_write_performed","validator_mutation_authorized",
        "governance_mutation_authorized","work_credit_mutation_authorized",
        "service_action_authorized","funds_action_authorized",
        "automatic_retry_authorized"
      ],
      "properties":{
        "filesystem_mutation_performed":{"const":true},
        "signer_object_exposed":{"const":false},
        "transaction_signer_access_performed":{"const":false},
        "wallet_access_performed":{"const":false},
        "transaction_signing_authorized_by_this_gate":{"const":false},
        "transaction_signing_performed":{"const":false},
        "transaction_broadcast_authorized":{"const":false},
        "transaction_broadcast_performed":{"const":false},
        "chain2050_write_authorized":{"const":false},
        "chain2050_write_performed":{"const":false},
        "validator_mutation_authorized":{"const":false},
        "governance_mutation_authorized":{"const":false},
        "work_credit_mutation_authorized":{"const":false},
        "service_action_authorized":{"const":false},
        "funds_action_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false}
      }
    },
    "next_gate":{
      "const":"exact_publisher_transaction_signing_from_consumed_authorization_v1"
    },
    "consumption_record_id":{
      "type":"string","pattern":"^voiddccstac1_[0-9a-f]{64}$"
    },
    "durable_consumption_record_published":{"const":true},
    "consumption_record_mode":{"const":"0600"},
    "state_store_directory_mode":{"const":"0700"},
    "signer_object_exposed":{"const":false},
    "transaction_signer_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "transaction_broadcast_performed":{"const":false},
    "chain2050_write_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
