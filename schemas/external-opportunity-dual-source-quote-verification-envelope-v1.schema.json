{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:void:schema:external-opportunity-dual-source-quote-verification-envelope:1",
  "title": "VOID external opportunity dual-source quote verification envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "marker",
    "phase",
    "reduction_id",
    "source_input_sha256",
    "reducer_receipt_sha256",
    "receipt_integrity_verified",
    "receipt_derivation_verified",
    "conservative_derivation_recomputed",
    "source_identity_authenticated",
    "network_access_performed",
    "credential_access_performed",
    "raw_response_retention",
    "transaction_payload_retention",
    "network_mutation_performed",
    "wallet_or_key_access_performed",
    "transaction_construction_performed",
    "transaction_signing_performed",
    "transaction_submission_performed",
    "fund_movement_performed",
    "live_execution_authorized",
    "execution_authorized",
    "verification_sha256"
  ],
  "properties": {
    "schema": {
      "const": "void-dual-source-quote-verification-envelope-v1"
    },
    "marker": {
      "const": "VOID_EXTERNAL_OPPORTUNITY_DUAL_SOURCE_QUOTE_VERIFICATION_ENVELOPE_V1"
    },
    "phase": {
      "const": "paper_verification"
    },
    "reduction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "source_input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reducer_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_integrity_verified": {
      "const": true
    },
    "receipt_derivation_verified": {
      "const": true
    },
    "conservative_derivation_recomputed": {
      "const": true
    },
    "source_identity_authenticated": {
      "const": false
    },
    "network_access_performed": {
      "const": false
    },
    "credential_access_performed": {
      "const": false
    },
    "raw_response_retention": {
      "const": false
    },
    "transaction_payload_retention": {
      "const": false
    },
    "network_mutation_performed": {
      "const": false
    },
    "wallet_or_key_access_performed": {
      "const": false
    },
    "transaction_construction_performed": {
      "const": false
    },
    "transaction_signing_performed": {
      "const": false
    },
    "transaction_submission_performed": {
      "const": false
    },
    "fund_movement_performed": {
      "const": false
    },
    "live_execution_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "verification_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
