{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-broadcast-authorization-consumption-v1.schema.json",
  "title":"VOID DataNet Content Commitment Broadcast Authorization Consumption v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "broadcast_authorization_id","broadcast_authorization_verification_id",
    "opaque_signed_receipt_verification_id","opaque_signed_receipt_id",
    "signing_request_id","signing_authorization_id",
    "signing_consumption_record_id","final_signing_review_preflight_id",
    "external_signing_idempotency_key_sha256",
    "unsigned_transaction_candidate_fingerprint_sha256",
    "publisher_address","signed_transaction_hash",
    "custody_handle_fingerprint_sha256","signed_at_utc",
    "signer_public_key_der_sha256","issued_at_utc","expires_at_utc",
    "consumed_at_utc","state_store_realpath_sha256",
    "consumption","authority","next_gate",
    "broadcast_consumption_record_id","durable_consumption_record_published",
    "consumption_record_mode","state_store_directory_mode",
    "sovereign_private_key_access_performed","raw_signed_transaction_accessed",
    "opaque_custody_handle_accessed","broadcaster_access_performed",
    "rpc_call_performed","transaction_broadcast_performed",
    "chain2050_write_performed","authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_BROADCAST_AUTHORIZATION_CONSUMPTION_V1"
    },
    "version":{"const":1},
    "status":{
      "const":"broadcast_authorization_consumed_before_broadcaster_access"
    },
    "chain_id":{"const":"2050"},
    "broadcast_authorization_id":{
      "type":"string","pattern":"^voiddccba1_[0-9a-f]{64}$"
    },
    "broadcast_authorization_verification_id":{
      "type":"string","pattern":"^voiddccbav1_[0-9a-f]{64}$"
    },
    "opaque_signed_receipt_verification_id":{
      "type":"string","pattern":"^voiddccosrv1_[0-9a-f]{64}$"
    },
    "opaque_signed_receipt_id":{
      "type":"string","pattern":"^voiddccosr1_[0-9a-f]{64}$"
    },
    "signing_request_id":{
      "type":"string","pattern":"^voiddccpsreq1_[0-9a-f]{64}$"
    },
    "signing_authorization_id":{
      "type":"string","pattern":"^voiddccsta1_[0-9a-f]{64}$"
    },
    "signing_consumption_record_id":{
      "type":"string","pattern":"^voiddccstac1_[0-9a-f]{64}$"
    },
    "final_signing_review_preflight_id":{
      "type":"string","pattern":"^voiddccfsrp1_[0-9a-f]{64}$"
    },
    "external_signing_idempotency_key_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "publisher_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "signed_transaction_hash":{
      "type":"string","pattern":"^0x[0-9a-f]{64}$"
    },
    "custody_handle_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "signed_at_utc":{"type":"string"},
    "signer_public_key_der_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "issued_at_utc":{"type":"string"},
    "expires_at_utc":{"type":"string"},
    "consumed_at_utc":{"type":"string"},
    "state_store_realpath_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "consumption":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "single_use","authorization_consumed","immutable_consumption_record",
        "replay_rejected_within_exact_state_store","replay_prevention_scope",
        "global_replay_prevention_claimed",
        "canonical_broadcast_state_store_runtime_binding_required",
        "expiry_rechecked_at_consumption",
        "consumption_precedes_any_broadcaster_access",
        "signed_transaction_hash_bound","custody_handle_fingerprint_bound",
        "raw_signed_transaction_remains_inaccessible",
        "broadcaster_access_remains_disabled"
      ],
      "properties":{
        "single_use":{"const":true},
        "authorization_consumed":{"const":true},
        "immutable_consumption_record":{"const":true},
        "replay_rejected_within_exact_state_store":{"const":true},
        "replay_prevention_scope":{"const":"exact_state_store_realpath"},
        "global_replay_prevention_claimed":{"const":false},
        "canonical_broadcast_state_store_runtime_binding_required":{"const":true},
        "expiry_rechecked_at_consumption":{"const":true},
        "consumption_precedes_any_broadcaster_access":{"const":true},
        "signed_transaction_hash_bound":{"const":true},
        "custody_handle_fingerprint_bound":{"const":true},
        "raw_signed_transaction_remains_inaccessible":{"const":true},
        "broadcaster_access_remains_disabled":{"const":true}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "filesystem_mutation_performed","sovereign_private_key_access_performed",
        "raw_signed_transaction_accessed","opaque_custody_handle_accessed",
        "broadcaster_access_performed","rpc_call_performed",
        "transaction_broadcast_authorized_by_this_gate",
        "transaction_broadcast_performed","chain2050_write_authorized",
        "chain2050_write_performed","validator_mutation_authorized",
        "governance_mutation_authorized","work_credit_mutation_authorized",
        "service_action_authorized","funds_action_authorized",
        "automatic_retry_authorized"
      ],
      "properties":{
        "filesystem_mutation_performed":{"const":true},
        "sovereign_private_key_access_performed":{"const":false},
        "raw_signed_transaction_accessed":{"const":false},
        "opaque_custody_handle_accessed":{"const":false},
        "broadcaster_access_performed":{"const":false},
        "rpc_call_performed":{"const":false},
        "transaction_broadcast_authorized_by_this_gate":{"const":false},
        "transaction_broadcast_performed":{"const":false},
        "chain2050_write_authorized":{"const":false},
        "chain2050_write_performed":{"const":false},
        "validator_mutation_authorized":{"const":false},
        "governance_mutation_authorized":{"const":false},
        "work_credit_mutation_authorized":{"const":false},
        "service_action_authorized":{"const":false},
        "funds_action_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false}
      }
    },
    "next_gate":{
      "const":"exact_broadcaster_access_from_consumed_broadcast_authorization_v1"
    },
    "broadcast_consumption_record_id":{
      "type":"string","pattern":"^voiddccbac1_[0-9a-f]{64}$"
    },
    "durable_consumption_record_published":{"const":true},
    "consumption_record_mode":{"const":"0600"},
    "state_store_directory_mode":{"const":"0700"},
    "sovereign_private_key_access_performed":{"const":false},
    "raw_signed_transaction_accessed":{"const":false},
    "opaque_custody_handle_accessed":{"const":false},
    "broadcaster_access_performed":{"const":false},
    "rpc_call_performed":{"const":false},
    "transaction_broadcast_performed":{"const":false},
    "chain2050_write_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
