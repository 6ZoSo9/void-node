{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/void-node-public-origin-binding-v1.schema.json",
  "title": "VOID Node Public Origin Binding V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "version",
    "status",
    "issued_at",
    "expires_at",
    "network",
    "origin",
    "node",
    "surface",
    "authority",
    "signature"
  ],
  "properties": {
    "marker": { "const": "VOID_NODE_PUBLIC_ORIGIN_BINDING_V1" },
    "version": { "const": 1 },
    "status": { "const": "active" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identity", "chain_id"],
      "properties": {
        "name": { "const": "VOID Mainnet-0" },
        "identity": { "const": "mainnet0" },
        "chain_id": { "const": 2050 }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "key_type",
        "public_key_pem",
        "public_key_fingerprint_sha256"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "key_type": { "const": "ed25519" },
        "public_key_pem": { "type": "string", "minLength": 1 },
        "public_key_fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_paths",
        "health",
        "work_credit_status",
        "same_origin_only",
        "redirects_allowed"
      ],
      "properties": {
        "binding_paths": {
          "const": [
            "/.well-known/void-node-public-origin-binding-v1.json",
            "/public-node/identity/public-origin-binding-v1.json"
          ]
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "methods"],
          "properties": {
            "path": { "const": "/health" },
            "methods": { "const": ["GET"] }
          }
        },
        "work_credit_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "methods"],
          "properties": {
            "path": { "const": "/wc/public-earning-pilot-v1/status" },
            "methods": { "const": ["GET"] }
          }
        },
        "same_origin_only": { "const": true },
        "redirects_allowed": { "const": false }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "transaction_submission",
        "payment_authority",
        "wallet_or_signer_access",
        "work_credit_write",
        "validator_mutation",
        "governance_mutation",
        "treasury_or_liquidity",
        "void_settlement",
        "node_runtime_mutation",
        "operator_control"
      ],
      "properties": {
        "read_only": { "const": true },
        "transaction_submission": { "const": false },
        "payment_authority": { "const": false },
        "wallet_or_signer_access": { "const": false },
        "work_credit_write": { "const": false },
        "validator_mutation": { "const": false },
        "governance_mutation": { "const": false },
        "treasury_or_liquidity": { "const": false },
        "void_settlement": { "const": false },
        "node_runtime_mutation": { "const": false },
        "operator_control": { "const": false }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "algorithm",
        "encoding",
        "canonicalization",
        "key_id",
        "value"
      ],
      "properties": {
        "domain": { "const": "VOID_NODE_PUBLIC_ORIGIN_BINDING_V1" },
        "algorithm": { "const": "ed25519" },
        "encoding": { "const": "base64" },
        "canonicalization": { "const": "void-canonical-json-v1" },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
