{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://void.network/schemas/authenticated-paid-work-runtime-disabled-production-activation-readiness-decision-v1.schema.json",
  "title": "VOID authenticated paid-work disabled-runtime activation readiness decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocking_requirements",
    "composition_evidence",
    "decision",
    "evaluated_at_utc",
    "execution_boundary",
    "marker",
    "prerequisite_gate_id",
    "ready",
    "status",
    "version"
  ],
  "properties": {
    "blocking_requirements": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "const": "activation_configuration_schema" },
        { "const": "activation_configuration_instance" },
        { "const": "trusted_context_reference_metadata" },
        { "const": "credential_reference_metadata" },
        { "const": "bounded_replay_snapshot" },
        { "const": "service_unit_design" },
        { "const": "rollback_plan" },
        { "const": "activation_execution_confirmation" },
        { "const": "live_canary_scope" }
      ],
      "items": false
    },
    "composition_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_sha256",
        "observed_main_commit",
        "operation_id",
        "prerequisite_merge_commit",
        "repair_merge_commit"
      ],
      "properties": {
        "composition_sha256": { "$ref": "#/$defs/sha256" },
        "observed_main_commit": { "$ref": "#/$defs/oid" },
        "operation_id": { "type": "string", "minLength": 1 },
        "prerequisite_merge_commit": {
          "const": "25db3a0b0ff802914ef40bacabcbbda3779866cd"
        },
        "repair_merge_commit": {
          "const": "e46619b4eba306dd0727e93ef87f52b68f724852"
        }
      }
    },
    "decision": { "const": "HOLD" },
    "evaluated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "execution_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_authorized",
        "activation_configuration_written",
        "credential_or_token_read",
        "deployment",
        "fund_movement",
        "payment_execution",
        "read_only",
        "ready_for_activation",
        "runtime_listener_created",
        "separate_activation_execution_lane_required",
        "service_restart",
        "wallet_or_signer_access",
        "work_credit_write",
        "work_dispatch"
      ],
      "properties": {
        "activation_authorized": { "const": false },
        "activation_configuration_written": { "const": false },
        "credential_or_token_read": { "const": false },
        "deployment": { "const": false },
        "fund_movement": { "const": false },
        "payment_execution": { "const": false },
        "read_only": { "const": true },
        "ready_for_activation": { "const": false },
        "runtime_listener_created": { "const": false },
        "separate_activation_execution_lane_required": { "const": true },
        "service_restart": { "const": false },
        "wallet_or_signer_access": { "const": false },
        "work_credit_write": { "const": false },
        "work_dispatch": { "const": false }
      }
    },
    "marker": {
      "const": "VOID_AUTHENTICATED_PAID_WORK_DISABLED_RUNTIME_ACTIVATION_READINESS_DECISION_RESULT_V1"
    },
    "prerequisite_gate_id": {
      "const": "void.authenticated-paid-work.disabled-runtime.activation-prerequisites.v1"
    },
    "ready": { "const": false },
    "status": {
      "const": "required_future_artifacts_unvalidated_activation_hold"
    },
    "version": { "const": 1 }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
