{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-finalized-receipt-admission-v1.schema.json",
  "title":"VOID DataNet Content Commitment Finalized Receipt Admission v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "finality_verification_id","receipt_verification_fingerprint_sha256",
    "checkpoint_attestation_id","signing_request_id",
    "signed_transaction_hash",
    "unsigned_transaction_candidate_fingerprint_sha256",
    "registry_address","publisher_address","commitment","finalized_receipt",
    "verification","authority","next_gate","finalized_receipt_admission_id",
    "admission_constructed","event_receipt_membership_verified",
    "canonical_commitment_truth_admitted",
    "filesystem_mutation_performed","sovereign_private_key_access_performed",
    "wallet_access_performed","transaction_signing_performed",
    "transaction_submission_performed","direct_rpc_call_performed",
    "direct_network_call_performed","chain2050_write_direct_performed",
    "authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_FINALIZED_RECEIPT_ADMISSION_V1"
    },
    "version":{"const":1},
    "status":{
      "const":"finalized_confirmed_commit_call_admitted_event_membership_pending"
    },
    "chain_id":{"const":"2050"},
    "finality_verification_id":{
      "type":"string","pattern":"^voiddccrfv1_[0-9a-f]{64}$"
    },
    "receipt_verification_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "checkpoint_attestation_id":{
      "type":"string","pattern":"^voiddccfca1_[0-9a-f]{64}$"
    },
    "signing_request_id":{
      "type":"string","pattern":"^voiddccpsreq1_[0-9a-f]{64}$"
    },
    "signed_transaction_hash":{
      "type":"string","pattern":"^0x[0-9a-f]{64}$"
    },
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "registry_address":{
      "type":"string","pattern":"^0x[0-9a-f]{40}$"
    },
    "publisher_address":{
      "type":"string","pattern":"^0x[0-9a-f]{40}$"
    },
    "commitment":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "object_id_sha256","content_sha256","byte_length",
        "function_signature","calldata_sha256"
      ],
      "properties":{
        "object_id_sha256":{
          "type":"string","pattern":"^[0-9a-f]{64}$"
        },
        "content_sha256":{
          "type":"string","pattern":"^[0-9a-f]{64}$"
        },
        "byte_length":{
          "type":"string","pattern":"^[1-9][0-9]{0,8}$"
        },
        "function_signature":{
          "const":"commit(bytes32,bytes32,uint64)"
        },
        "calldata_sha256":{
          "type":"string","pattern":"^[0-9a-f]{64}$"
        }
      }
    },
    "finalized_receipt":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "transaction_status","block_number","block_hash",
        "observed_confirmation_count","accepted_checkpoint_height",
        "accepted_checkpoint_hash","finality_policy_id","finality_kind",
        "protocol_consensus_finality_claimed"
      ],
      "properties":{
        "transaction_status":{"const":"1"},
        "block_number":{
          "type":"string","pattern":"^[1-9][0-9]*$"
        },
        "block_hash":{
          "type":"string","pattern":"^0x[0-9a-f]{64}$"
        },
        "observed_confirmation_count":{
          "type":"string","pattern":"^(0|[1-9][0-9]*)$"
        },
        "accepted_checkpoint_height":{
          "type":"string","pattern":"^[1-9][0-9]*$"
        },
        "accepted_checkpoint_hash":{
          "type":"string","pattern":"^0x[0-9a-f]{64}$"
        },
        "finality_policy_id":{
          "const":"mainnet0-checkpoint-finality-v1"
        },
        "finality_kind":{
          "const":"operator_recognized_accepted_checkpoint"
        },
        "protocol_consensus_finality_claimed":{"const":false}
      }
    },
    "verification":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "finality_verification_id_rederived",
        "signing_request_id_rederived",
        "unsigned_transaction_candidate_fingerprint_rederived",
        "exact_publisher_bound","exact_registry_bound",
        "exact_commit_calldata_decoded","commit_calldata_roundtrip_verified",
        "finalized_confirmed_transaction_verified",
        "operator_recognized_checkpoint_finality_verified",
        "content_committed_event_membership_verified",
        "canonical_commitment_truth_admitted"
      ],
      "properties":{
        "finality_verification_id_rederived":{"const":true},
        "signing_request_id_rederived":{"const":true},
        "unsigned_transaction_candidate_fingerprint_rederived":{"const":true},
        "exact_publisher_bound":{"const":true},
        "exact_registry_bound":{"const":true},
        "exact_commit_calldata_decoded":{"const":true},
        "commit_calldata_roundtrip_verified":{"const":true},
        "finalized_confirmed_transaction_verified":{"const":true},
        "operator_recognized_checkpoint_finality_verified":{"const":true},
        "content_committed_event_membership_verified":{"const":false},
        "canonical_commitment_truth_admitted":{"const":false}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "admission_artifact_only","transaction_submission_authorized",
        "automatic_retry_authorized","filesystem_mutation_performed",
        "sovereign_private_key_access_performed","wallet_access_performed",
        "transaction_signing_performed","direct_rpc_call_performed",
        "direct_network_call_performed","chain2050_write_direct_performed",
        "validator_mutation_authorized","governance_mutation_authorized",
        "work_credit_mutation_authorized","funds_action_authorized"
      ],
      "properties":{
        "admission_artifact_only":{"const":true},
        "transaction_submission_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false},
        "filesystem_mutation_performed":{"const":false},
        "sovereign_private_key_access_performed":{"const":false},
        "wallet_access_performed":{"const":false},
        "transaction_signing_performed":{"const":false},
        "direct_rpc_call_performed":{"const":false},
        "direct_network_call_performed":{"const":false},
        "chain2050_write_direct_performed":{"const":false},
        "validator_mutation_authorized":{"const":false},
        "governance_mutation_authorized":{"const":false},
        "work_credit_mutation_authorized":{"const":false},
        "funds_action_authorized":{"const":false}
      }
    },
    "next_gate":{
      "const":"datanet_content_commitment_finalized_event_membership_v1"
    },
    "finalized_receipt_admission_id":{
      "type":"string","pattern":"^voiddccfra1_[0-9a-f]{64}$"
    },
    "admission_constructed":{"const":true},
    "event_receipt_membership_verified":{"const":false},
    "canonical_commitment_truth_admitted":{"const":false},
    "filesystem_mutation_performed":{"const":false},
    "sovereign_private_key_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "transaction_submission_performed":{"const":false},
    "direct_rpc_call_performed":{"const":false},
    "direct_network_call_performed":{"const":false},
    "chain2050_write_direct_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
