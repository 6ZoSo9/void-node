{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/agent-paid-work-credential-wc-account-binding-v1.schema.json",
  "title": "VOID Agent Paid Work Credential WC Account Binding V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "version",
    "binding_id",
    "credential_id",
    "agent_id",
    "destination_wc_account",
    "scope",
    "status",
    "effective_at",
    "expires_at",
    "uniqueness_key",
    "policy"
  ],
  "properties": {
    "marker": {
      "const": "VOID_AGENT_PAID_WORK_CREDENTIAL_WC_ACCOUNT_BINDING_V1"
    },
    "version": {
      "const": 1
    },
    "binding_id": {
      "type": "string",
      "pattern": "^void[a-z0-9_]{2,160}$"
    },
    "credential_id": {
      "type": "string",
      "pattern": "^void[a-z0-9_]{2,160}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{3,160}$"
    },
    "destination_wc_account": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{3,160}$"
    },
    "scope": {
      "const": "agent_paid_work_submit"
    },
    "status": {
      "const": "active"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "uniqueness_key": {
      "type": "string",
      "minLength": 20,
      "maxLength": 256
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_active_binding_per_credential",
        "account_change_requires_new_binding",
        "live_settlement_authorized"
      ],
      "properties": {
        "one_active_binding_per_credential": {
          "const": true
        },
        "account_change_requires_new_binding": {
          "const": true
        },
        "live_settlement_authorized": {
          "const": false
        }
      }
    }
  }
}
