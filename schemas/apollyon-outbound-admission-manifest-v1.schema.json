{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.org/schemas/apollyon-outbound-admission-manifest-v1.schema.json",
  "title": "VOID Apollyon Outbound Admission Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "trial_id",
    "entries",
    "created_at_utc",
    "nonce"
  ],
  "properties": {
    "marker": {
      "const": "VOID_APOLLYON_OUTBOUND_ADMISSION_MANIFEST_V1"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^voidat1_[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "relative_path",
          "sha256",
          "classification",
          "media_type"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,96}$"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,256}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "classification": {
            "enum": ["public", "sanitized"]
          },
          "media_type": {
            "enum": ["text/plain", "application/json"]
          }
        }
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  }
}
