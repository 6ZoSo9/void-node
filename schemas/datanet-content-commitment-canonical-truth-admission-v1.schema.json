{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-canonical-truth-admission-v1.schema.json",
  "title":"VOID DataNet Content Commitment Canonical Truth Admission v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "finalized_event_membership_id","finalized_receipt_admission_id",
    "finality_verification_id","checkpoint_attestation_id","finality_policy_id",
    "finality_kind","protocol_consensus_finality_claimed",
    "event_receipt_membership_verified","canonical_commitment_truth_admitted",
    "commitment_reference","verification","authority","next_gate",
    "canonical_commitment_truth_admission_id","reconstruction_authority_granted",
    "filesystem_mutation_performed","sovereign_private_key_access_performed",
    "wallet_access_performed","transaction_signing_performed",
    "transaction_submission_performed","direct_rpc_call_performed",
    "direct_network_call_performed","chain2050_write_direct_performed",
    "authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{"const":"VOID_DATANET_CONTENT_COMMITMENT_CANONICAL_TRUTH_ADMISSION_V1"},
    "version":{"const":1},
    "status":{"const":"canonical_chain2050_content_commitment_truth_admitted_reconstruction_authority_pending"},
    "chain_id":{"const":"2050"},
    "finalized_event_membership_id":{"type":"string","pattern":"^voiddccfem1_[0-9a-f]{64}$"},
    "finalized_receipt_admission_id":{"type":"string","pattern":"^voiddccfra1_[0-9a-f]{64}$"},
    "finality_verification_id":{"type":"string","pattern":"^voiddccrfv1_[0-9a-f]{64}$"},
    "checkpoint_attestation_id":{"type":"string","pattern":"^voiddccfca1_[0-9a-f]{64}$"},
    "finality_policy_id":{"const":"mainnet0-checkpoint-finality-v1"},
    "finality_kind":{"const":"operator_recognized_accepted_checkpoint"},
    "protocol_consensus_finality_claimed":{"const":false},
    "event_receipt_membership_verified":{"const":true},
    "canonical_commitment_truth_admitted":{"const":true},
    "commitment_reference":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "marker","version","chain_id","object_id","content_sha256","byte_length",
        "checkpoint_height","checkpoint_block_hash","accepted_checkpoint_id",
        "commitment_transaction_hash","commitment_log_index","commitment_id"
      ]
    },
    "verification":{"type":"object"},
    "authority":{"type":"object"},
    "next_gate":{"const":"datanet_chain_peer_reconstruction_canonical_commitment_integration_v1"},
    "canonical_commitment_truth_admission_id":{"type":"string","pattern":"^voiddcccta1_[0-9a-f]{64}$"},
    "reconstruction_authority_granted":{"const":false},
    "filesystem_mutation_performed":{"const":false},
    "sovereign_private_key_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "transaction_submission_performed":{"const":false},
    "direct_rpc_call_performed":{"const":false},
    "direct_network_call_performed":{"const":false},
    "chain2050_write_direct_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
