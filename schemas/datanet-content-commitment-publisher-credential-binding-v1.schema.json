{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.org/schemas/datanet-content-commitment-publisher-credential-binding-v1.schema.json",
  "title": "VOID DataNet Content Commitment Publisher Credential Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "marker",
    "version",
    "status",
    "chain_id",
    "pre_sign_revalidation_id",
    "credential_id",
    "publisher_address",
    "publisher_address_fingerprint_sha256",
    "credential_source",
    "binding",
    "authority",
    "next_gate",
    "credential_binding_id",
    "raw_private_key_output",
    "signer_object_exposed",
    "signing_performed",
    "transaction_broadcast_performed",
    "chain2050_write_performed",
    "authority_contract"
  ],
  "properties": {
    "ok": {"const": true},
    "marker": {
      "const": "VOID_DATANET_CONTENT_COMMITMENT_PUBLISHER_CREDENTIAL_BINDING_V1"
    },
    "version": {"const": 1},
    "status": {
      "const": "publisher_credential_identity_bound_without_signing_authority"
    },
    "chain_id": {"const": "2050"},
    "pre_sign_revalidation_id": {
      "type": "string",
      "pattern": "^voiddccpsr1_[0-9a-f]{64}$"
    },
    "credential_id": {
      "const": "datanet-content-commitment-publisher-wallet-v1"
    },
    "publisher_address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "publisher_address_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "credential_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regular_file", "symbolic_link", "mode", "size_bytes"],
      "properties": {
        "regular_file": {"const": true},
        "symbolic_link": {"const": false},
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{3}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_candidate_publisher_match",
        "credential_address_derived",
        "credential_identity_only",
        "upstream_pre_sign_is_not_bearer_signing_authority"
      ],
      "properties": {
        "exact_candidate_publisher_match": {"const": true},
        "credential_address_derived": {"const": true},
        "credential_identity_only": {"const": true},
        "upstream_pre_sign_is_not_bearer_signing_authority": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_content_access_performed",
        "wallet_address_derivation_performed",
        "raw_private_key_output",
        "signer_object_exposed",
        "rpc_call_performed",
        "transaction_revalidation_performed",
        "transaction_signing_authorized",
        "transaction_signing_performed",
        "transaction_broadcast_authorized",
        "transaction_broadcast_performed",
        "chain2050_write_authorized",
        "chain2050_write_performed",
        "validator_mutation_authorized",
        "governance_mutation_authorized",
        "work_credit_mutation_authorized",
        "service_action_authorized",
        "funds_action_authorized",
        "automatic_retry_authorized"
      ],
      "properties": {
        "credential_content_access_performed": {"const": true},
        "wallet_address_derivation_performed": {"const": true},
        "raw_private_key_output": {"const": false},
        "signer_object_exposed": {"const": false},
        "rpc_call_performed": {"const": false},
        "transaction_revalidation_performed": {"const": false},
        "transaction_signing_authorized": {"const": false},
        "transaction_signing_performed": {"const": false},
        "transaction_broadcast_authorized": {"const": false},
        "transaction_broadcast_performed": {"const": false},
        "chain2050_write_authorized": {"const": false},
        "chain2050_write_performed": {"const": false},
        "validator_mutation_authorized": {"const": false},
        "governance_mutation_authorized": {"const": false},
        "work_credit_mutation_authorized": {"const": false},
        "service_action_authorized": {"const": false},
        "funds_action_authorized": {"const": false},
        "automatic_retry_authorized": {"const": false}
      }
    },
    "next_gate": {
      "const": "revalidate_exact_bound_candidate_immediately_before_separate_signing_authorization"
    },
    "credential_binding_id": {
      "type": "string",
      "pattern": "^voiddccpcb1_[0-9a-f]{64}$"
    },
    "raw_private_key_output": {"const": false},
    "signer_object_exposed": {"const": false},
    "signing_performed": {"const": false},
    "transaction_broadcast_performed": {"const": false},
    "chain2050_write_performed": {"const": false},
    "authority_contract": {"type": "object"}
  }
}
