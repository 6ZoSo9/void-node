{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:void:schema:sovereign-name-record:1",
  "title": "VOID Sovereign Name Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "marker",
    "version",
    "status",
    "issued_at",
    "expires_at",
    "sequence",
    "previous_record_sha256",
    "network",
    "namespace",
    "name",
    "subject",
    "transports",
    "authority",
    "signature"
  ],
  "properties": {
    "$schema": {
      "const": "urn:void:schema:sovereign-name-record:1"
    },
    "marker": {
      "const": "VOID_SOVEREIGN_NAME_RECORD_V1"
    },
    "version": {
      "const": 1
    },
    "status": {
      "const": "active"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_record_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "chain_id",
        "identity",
        "genesis_sha256"
      ],
      "properties": {
        "name": {
          "const": "VOID Mainnet-0"
        },
        "chain_id": {
          "const": 2050
        },
        "identity": {
          "const": "mainnet0"
        },
        "genesis_sha256": {
          "const": "22f42ef6cfa8e4ebfbc5ea98cdc536ec04c1bb4ddb15885b45b1ac02d0f122ab"
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "authority_key_id"
      ],
      "properties": {
        "name": {
          "const": "void"
        },
        "authority_key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        }
      }
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "canonical"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          }
        },
        "canonical": {
          "type": "string",
          "pattern": "^void://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:/[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?){0,7}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "node_id",
        "key_type",
        "key_id",
        "public_key_pem",
        "public_key_fingerprint_sha256"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^voidid:ed25519:[0-9a-f]{64}$"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "key_type": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "public_key_pem": {
          "type": "string",
          "minLength": 1
        },
        "public_key_fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "endpoint",
          "priority",
          "expires_at"
        ],
        "properties": {
          "kind": {
            "enum": [
              "https",
              "tor-v3"
            ]
          },
          "endpoint": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name_resolution",
        "source_origin_trusted",
        "dns_control_required",
        "transport_provider_authority",
        "transaction_submission",
        "payment_authority",
        "wallet_or_signer_access",
        "work_credit_write",
        "void_settlement",
        "node_runtime_mutation",
        "operator_control",
        "governance_mutation",
        "fund_movement"
      ],
      "properties": {
        "name_resolution": {
          "const": true
        },
        "source_origin_trusted": {
          "const": false
        },
        "dns_control_required": {
          "const": false
        },
        "transport_provider_authority": {
          "const": false
        },
        "transaction_submission": {
          "const": false
        },
        "payment_authority": {
          "const": false
        },
        "wallet_or_signer_access": {
          "const": false
        },
        "work_credit_write": {
          "const": false
        },
        "void_settlement": {
          "const": false
        },
        "node_runtime_mutation": {
          "const": false
        },
        "operator_control": {
          "const": false
        },
        "governance_mutation": {
          "const": false
        },
        "fund_movement": {
          "const": false
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "algorithm",
        "encoding",
        "canonicalization",
        "key_id",
        "value"
      ],
      "properties": {
        "domain": {
          "const": "VOID_SOVEREIGN_NAME_RECORD_V1"
        },
        "algorithm": {
          "const": "ed25519"
        },
        "encoding": {
          "const": "base64"
        },
        "canonicalization": {
          "const": "void-canonical-json-v1"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
