{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/agent-paid-work-credential-wc-account-binding-retirement-v1.schema.json",
  "title": "VOID Agent Paid Work Credential WC Account Binding Retirement V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "version",
    "retirement_id",
    "binding_id",
    "credential_id",
    "agent_id",
    "destination_wc_account",
    "reason",
    "retired_at",
    "credential_expires_at_utc",
    "credential_revoked_at_utc",
    "original_binding_sha256",
    "original_binding",
    "replacement_binding_created",
    "replacement_credential_id",
    "authority"
  ],
  "properties": {
    "marker": {
      "const": "VOID_AGENT_PAID_WORK_CREDENTIAL_WC_ACCOUNT_BINDING_RETIREMENT_RECORD_V1"
    },
    "version": {
      "const": 1
    },
    "retirement_id": {
      "type": "string",
      "pattern": "^voidapwbr1_[0-9a-f]{64}$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^voidapwcb1_[0-9a-f]{64}$"
    },
    "credential_id": {
      "type": "string",
      "pattern": "^voidapwc1_[0-9a-f]{64}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "destination_wc_account": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "reason": {
      "const": "credential_expired_rotation"
    },
    "retired_at": {
      "type": "string",
      "format": "date-time"
    },
    "credential_expires_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "credential_revoked_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "original_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker",
        "binding_id",
        "credential_id",
        "agent_id",
        "destination_wc_account",
        "status",
        "valid_from",
        "valid_until",
        "revoked_at",
        "uniqueness_key",
        "source",
        "authority",
        "created_at"
      ],
      "properties": {
        "marker": {
          "const": "VOID_AGENT_PAID_WORK_CREDENTIAL_WC_ACCOUNT_BINDING_V1"
        },
        "binding_id": {
          "type": "string",
          "pattern": "^voidapwcb1_[0-9a-f]{64}$"
        },
        "credential_id": {
          "type": "string",
          "pattern": "^voidapwc1_[0-9a-f]{64}$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "destination_wc_account": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "status": {
          "const": "active"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "const": null
        },
        "uniqueness_key": {
          "type": "string",
          "pattern": "^paid-work-credential-wc-account:voidapwc1_[0-9a-f]{64}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "credential_registry_sha256",
            "review_decision_id",
            "issuance_preparation_id"
          ],
          "properties": {
            "credential_registry_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "review_decision_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "issuance_preparation_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paid_work_submission_identity",
            "wc_award_destination",
            "payment",
            "wc_ledger_write",
            "wc_to_void_settlement",
            "wallet_or_signer"
          ],
          "properties": {
            "paid_work_submission_identity": {
              "const": true
            },
            "wc_award_destination": {
              "const": true
            },
            "payment": {
              "const": false
            },
            "wc_ledger_write": {
              "const": false
            },
            "wc_to_void_settlement": {
              "const": false
            },
            "wallet_or_signer": {
              "const": false
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "replacement_binding_created": {
      "const": false
    },
    "replacement_credential_id": {
      "const": null
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment",
        "money_movement",
        "paid_work_submission",
        "paid_work_submission_retry",
        "payment_authorization",
        "payment_execution",
        "service_restart",
        "signing",
        "transaction_broadcast",
        "wallet_or_signer_access",
        "wc_award_destination_change",
        "wc_ledger_write",
        "wc_to_void_settlement",
        "work_dispatch",
        "work_execution_authorization"
      ],
      "properties": {
        "paid_work_submission": {
          "const": false
        },
        "paid_work_submission_retry": {
          "const": false
        },
        "wc_award_destination_change": {
          "const": false
        },
        "wc_ledger_write": {
          "const": false
        },
        "wc_to_void_settlement": {
          "const": false
        },
        "payment_authorization": {
          "const": false
        },
        "payment_execution": {
          "const": false
        },
        "work_execution_authorization": {
          "const": false
        },
        "work_dispatch": {
          "const": false
        },
        "wallet_or_signer_access": {
          "const": false
        },
        "signing": {
          "const": false
        },
        "transaction_broadcast": {
          "const": false
        },
        "service_restart": {
          "const": false
        },
        "deployment": {
          "const": false
        },
        "money_movement": {
          "const": false
        }
      }
    }
  }
}
