{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-sovereign-single-transaction-authorization-v1.schema.json",
  "title":"VOID DataNet Content Commitment Sovereign Single Transaction Authorization v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id","authorization_id",
    "final_signing_review_preflight_id","fresh_pre_sign_revalidation_id",
    "fresh_credential_binding_id",
    "unsigned_transaction_candidate_fingerprint_sha256",
    "publisher_address","transaction_summary",
    "issued_at_utc","expires_at_utc","signer_public_key_der_sha256",
    "authorization","authority","next_gate",
    "authorization_verification_id",
    "sovereign_private_key_access_performed","signer_object_exposed",
    "signer_access_performed","wallet_access_performed",
    "transaction_signing_performed","transaction_broadcast_performed",
    "chain2050_write_performed","authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_SOVEREIGN_SINGLE_TRANSACTION_AUTHORIZATION_V1"
    },
    "version":{"const":1},
    "status":{
      "const":"exact_single_transaction_sovereign_authorization_verified_unconsumed"
    },
    "chain_id":{"const":"2050"},
    "authorization_id":{
      "type":"string","pattern":"^voiddccsta1_[0-9a-f]{64}$"
    },
    "final_signing_review_preflight_id":{
      "type":"string","pattern":"^voiddccfsrp1_[0-9a-f]{64}$"
    },
    "fresh_pre_sign_revalidation_id":{
      "type":"string","pattern":"^voiddccpsr1_[0-9a-f]{64}$"
    },
    "fresh_credential_binding_id":{
      "type":"string","pattern":"^voiddccpcb1_[0-9a-f]{64}$"
    },
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "publisher_address":{
      "type":"string","pattern":"^0x[0-9a-f]{40}$"
    },
    "transaction_summary":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "transaction_type","chain_id","nonce","from_address","to_address",
        "value_wei","gas_limit","max_fee_per_gas_wei",
        "max_priority_fee_per_gas_wei","calldata_sha256"
      ],
      "properties":{
        "transaction_type":{"const":2},
        "chain_id":{"const":"2050"},
        "nonce":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
        "from_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
        "to_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
        "value_wei":{"const":"0"},
        "gas_limit":{"type":"string","pattern":"^[1-9][0-9]*$"},
        "max_fee_per_gas_wei":{"type":"string","pattern":"^[1-9][0-9]*$"},
        "max_priority_fee_per_gas_wei":{
          "type":"string","pattern":"^(0|[1-9][0-9]*)$"
        },
        "calldata_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "issued_at_utc":{"type":"string"},
    "expires_at_utc":{"type":"string"},
    "signer_public_key_der_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "authorization":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "sovereign_signature_verified",
        "exact_single_transaction_signing_approved","single_use",
        "authorization_consumed","consumption_record_present",
        "durable_consumption_before_signing_required",
        "runtime_expiry_recheck_before_signing_required",
        "replay_prevention_enforced_by_this_verifier"
      ],
      "properties":{
        "sovereign_signature_verified":{"const":true},
        "exact_single_transaction_signing_approved":{"const":true},
        "single_use":{"const":true},
        "authorization_consumed":{"const":false},
        "consumption_record_present":{"const":false},
        "durable_consumption_before_signing_required":{"const":true},
        "runtime_expiry_recheck_before_signing_required":{"const":true},
        "replay_prevention_enforced_by_this_verifier":{"const":false}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "authorization_evidence_only",
        "exact_transaction_signing_permitted_by_sovereign",
        "sovereign_private_key_access_performed","signer_object_exposed",
        "signer_access_performed","wallet_access_performed",
        "transaction_signing_performed",
        "transaction_broadcast_authorized","transaction_broadcast_performed",
        "chain2050_write_authorized","chain2050_write_performed",
        "validator_mutation_authorized","governance_mutation_authorized",
        "work_credit_mutation_authorized","service_action_authorized",
        "funds_action_authorized","automatic_retry_authorized"
      ],
      "properties":{
        "authorization_evidence_only":{"const":true},
        "exact_transaction_signing_permitted_by_sovereign":{"const":true},
        "sovereign_private_key_access_performed":{"const":false},
        "signer_object_exposed":{"const":false},
        "signer_access_performed":{"const":false},
        "wallet_access_performed":{"const":false},
        "transaction_signing_performed":{"const":false},
        "transaction_broadcast_authorized":{"const":false},
        "transaction_broadcast_performed":{"const":false},
        "chain2050_write_authorized":{"const":false},
        "chain2050_write_performed":{"const":false},
        "validator_mutation_authorized":{"const":false},
        "governance_mutation_authorized":{"const":false},
        "work_credit_mutation_authorized":{"const":false},
        "service_action_authorized":{"const":false},
        "funds_action_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false}
      }
    },
    "next_gate":{
      "const":"durable_single_use_authorization_consumption_before_exact_transaction_signing_v1"
    },
    "authorization_verification_id":{
      "type":"string","pattern":"^voiddccstav1_[0-9a-f]{64}$"
    },
    "sovereign_private_key_access_performed":{"const":false},
    "signer_object_exposed":{"const":false},
    "signer_access_performed":{"const":false},
    "wallet_access_performed":{"const":false},
    "transaction_signing_performed":{"const":false},
    "transaction_broadcast_performed":{"const":false},
    "chain2050_write_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
