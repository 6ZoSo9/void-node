{
  "$id": "https://voidchain.io/schemas/public-agent-service-authenticated-quote-acceptance-handoff-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "marker": {
      "const": "VOID_PUBLIC_AGENT_SERVICE_AUTHENTICATED_QUOTE_ACCEPTANCE_HANDOFF_V1"
    },
    "provider_authentication_input": {
      "$ref": "public-agent-service-provider-quote-response-authentication-v1.schema.json"
    },
    "requester_intent": {
      "additionalProperties": false,
      "properties": {
        "acceptance_nonce": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9._:-]{16,128}$",
          "type": "string"
        },
        "created_at_utc": {
          "format": "date-time",
          "type": "string"
        },
        "expires_at_utc": {
          "format": "date-time",
          "type": "string"
        },
        "requester_agent_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
          "type": "string"
        },
        "requester_authentication": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "not_provided"
            },
            "required_scope": {
              "const": "agent_paid_work_accept"
            },
            "verified": {
              "const": false
            }
          },
          "required": [
            "mode",
            "required_scope",
            "verified"
          ],
          "type": "object"
        }
      },
      "required": [
        "requester_agent_id",
        "created_at_utc",
        "expires_at_utc",
        "acceptance_nonce",
        "requester_authentication"
      ],
      "type": "object"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "marker",
    "version",
    "provider_authentication_input",
    "requester_intent"
  ],
  "title": "VOID Public Agent Service Authenticated Quote Acceptance Handoff V1",
  "type": "object",
  "x_void_marker": "VOID_PUBLIC_AGENT_SERVICE_AUTHENTICATED_QUOTE_ACCEPTANCE_HANDOFF_SCHEMA_V1"
}
