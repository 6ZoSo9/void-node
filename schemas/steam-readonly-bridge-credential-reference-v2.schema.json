{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://void.network/schemas/steam-readonly-bridge-credential-reference-v2.schema.json",
  "title": "VOID Steam read-only bridge credential reference v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "marker",
    "version",
    "status",
    "reference_id",
    "credential_reference",
    "revalidation",
    "authority"
  ],
  "properties": {
    "$schema": {
      "const": "https://void.network/schemas/steam-readonly-bridge-credential-reference-v2.schema.json"
    },
    "marker": {
      "const": "VOID_STEAM_READONLY_BRIDGE_CREDENTIAL_REFERENCE_V2"
    },
    "version": {
      "const": 2
    },
    "status": {
      "const": "source_reference_only_credential_read_forbidden"
    },
    "reference_id": {
      "type": "string",
      "pattern": "^voidsteamref1_[0-9a-f]{64}$"
    },
    "credential_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "environment_variable",
        "source_locator_sha256",
        "expected_scope",
        "raw_credential_embedded",
        "credential_digest_embedded",
        "private_locator_disclosed"
      ],
      "properties": {
        "mode": {
          "const": "environment_reference"
        },
        "environment_variable": {
          "const": "VOID_STEAM_WEB_API_KEY"
        },
        "source_locator_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_scope": {
          "const": "steam_readonly_web_api"
        },
        "raw_credential_embedded": {
          "const": false
        },
        "credential_digest_embedded": {
          "const": false
        },
        "private_locator_disclosed": {
          "const": false
        }
      }
    },
    "revalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_source_locator_revalidation_required",
        "credential_presence_revalidation_required",
        "scope_revalidation_required",
        "revocation_revalidation_required",
        "credential_read_required_for_source_proof",
        "credential_provider_invocation_required_for_source_proof",
        "live_request_authorized_by_reference"
      ],
      "properties": {
        "private_source_locator_revalidation_required": {
          "const": true
        },
        "credential_presence_revalidation_required": {
          "const": true
        },
        "scope_revalidation_required": {
          "const": true
        },
        "revocation_revalidation_required": {
          "const": true
        },
        "credential_read_required_for_source_proof": {
          "const": false
        },
        "credential_provider_invocation_required_for_source_proof": {
          "const": false
        },
        "live_request_authorized_by_reference": {
          "const": false
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_reference_metadata_created",
        "credential_or_token_read",
        "credential_provider_invoked",
        "authorization_header_materialized",
        "runtime_route_registration_available",
        "runtime_route_registered_by_source_proof",
        "runtime_listener_created",
        "live_steam_request",
        "response_persistence",
        "deployment",
        "service_restart",
        "work_credit_write",
        "wallet_or_signer_access",
        "fund_movement"
      ],
      "properties": {
        "source_reference_metadata_created": {
          "const": true
        },
        "credential_or_token_read": {
          "const": false
        },
        "credential_provider_invoked": {
          "const": false
        },
        "authorization_header_materialized": {
          "const": false
        },
        "runtime_route_registration_available": {
          "const": true
        },
        "runtime_route_registered_by_source_proof": {
          "const": true
        },
        "runtime_listener_created": {
          "const": false
        },
        "live_steam_request": {
          "const": false
        },
        "response_persistence": {
          "const": false
        },
        "deployment": {
          "const": false
        },
        "service_restart": {
          "const": false
        },
        "work_credit_write": {
          "const": false
        },
        "wallet_or_signer_access": {
          "const": false
        },
        "fund_movement": {
          "const": false
        }
      }
    }
  },
  "x_void_marker": "VOID_STEAM_READONLY_BRIDGE_CREDENTIAL_REFERENCE_SCHEMA_V2"
