{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://voidchain.org/schemas/datanet-content-commitment-sovereign-broadcast-authorization-v1.schema.json",
  "title":"VOID DataNet Content Commitment Sovereign Broadcast Authorization v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "ok","marker","version","status","chain_id",
    "broadcast_authorization_id","opaque_signed_receipt_verification_id",
    "opaque_signed_receipt_id","signing_request_id",
    "signing_authorization_id","consumption_record_id",
    "final_signing_review_preflight_id",
    "external_signing_idempotency_key_sha256",
    "unsigned_transaction_candidate_fingerprint_sha256",
    "publisher_address","signed_transaction_hash",
    "custody_handle_fingerprint_sha256","signed_at_utc",
    "issued_at_utc","expires_at_utc","signer_public_key_der_sha256",
    "authorization","authority","next_gate",
    "broadcast_authorization_verification_id",
    "exact_signed_transaction_broadcast_authorization_verified",
    "sovereign_private_key_access_performed","raw_signed_transaction_accessed",
    "broadcaster_access_performed","transaction_broadcast_performed",
    "chain2050_write_performed","filesystem_mutation_performed",
    "authority_contract"
  ],
  "properties":{
    "ok":{"const":true},
    "marker":{
      "const":"VOID_DATANET_CONTENT_COMMITMENT_SOVEREIGN_BROADCAST_AUTHORIZATION_V1"
    },
    "version":{"const":1},
    "status":{
      "const":"exact_signed_transaction_broadcast_authorization_verified_unconsumed"
    },
    "chain_id":{"const":"2050"},
    "broadcast_authorization_id":{
      "type":"string","pattern":"^voiddccba1_[0-9a-f]{64}$"
    },
    "opaque_signed_receipt_verification_id":{
      "type":"string","pattern":"^voiddccosrv1_[0-9a-f]{64}$"
    },
    "opaque_signed_receipt_id":{
      "type":"string","pattern":"^voiddccosr1_[0-9a-f]{64}$"
    },
    "signing_request_id":{
      "type":"string","pattern":"^voiddccpsreq1_[0-9a-f]{64}$"
    },
    "signing_authorization_id":{
      "type":"string","pattern":"^voiddccsta1_[0-9a-f]{64}$"
    },
    "consumption_record_id":{
      "type":"string","pattern":"^voiddccstac1_[0-9a-f]{64}$"
    },
    "final_signing_review_preflight_id":{
      "type":"string","pattern":"^voiddccfsrp1_[0-9a-f]{64}$"
    },
    "external_signing_idempotency_key_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "unsigned_transaction_candidate_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "publisher_address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "signed_transaction_hash":{
      "type":"string","pattern":"^0x[0-9a-f]{64}$"
    },
    "custody_handle_fingerprint_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "signed_at_utc":{"type":"string"},
    "issued_at_utc":{"type":"string"},
    "expires_at_utc":{"type":"string"},
    "signer_public_key_der_sha256":{
      "type":"string","pattern":"^[0-9a-f]{64}$"
    },
    "authorization":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "sovereign_signature_verified",
        "exact_signed_transaction_broadcast_approved","single_use",
        "authorization_consumed","consumption_record_present",
        "durable_consumption_before_broadcaster_access_required",
        "runtime_expiry_recheck_before_broadcast_required",
        "replay_prevention_enforced_by_this_verifier"
      ],
      "properties":{
        "sovereign_signature_verified":{"const":true},
        "exact_signed_transaction_broadcast_approved":{"const":true},
        "single_use":{"const":true},
        "authorization_consumed":{"const":false},
        "consumption_record_present":{"const":false},
        "durable_consumption_before_broadcaster_access_required":{"const":true},
        "runtime_expiry_recheck_before_broadcast_required":{"const":true},
        "replay_prevention_enforced_by_this_verifier":{"const":false}
      }
    },
    "authority":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "authorization_evidence_only",
        "exact_signed_transaction_broadcast_permitted_by_sovereign",
        "sovereign_private_key_access_performed","raw_signed_transaction_accessed",
        "broadcaster_access_performed","transaction_broadcast_performed",
        "chain2050_write_performed","filesystem_mutation_performed",
        "validator_mutation_authorized","governance_mutation_authorized",
        "work_credit_mutation_authorized","service_action_authorized",
        "funds_action_authorized","automatic_retry_authorized"
      ],
      "properties":{
        "authorization_evidence_only":{"const":true},
        "exact_signed_transaction_broadcast_permitted_by_sovereign":{"const":true},
        "sovereign_private_key_access_performed":{"const":false},
        "raw_signed_transaction_accessed":{"const":false},
        "broadcaster_access_performed":{"const":false},
        "transaction_broadcast_performed":{"const":false},
        "chain2050_write_performed":{"const":false},
        "filesystem_mutation_performed":{"const":false},
        "validator_mutation_authorized":{"const":false},
        "governance_mutation_authorized":{"const":false},
        "work_credit_mutation_authorized":{"const":false},
        "service_action_authorized":{"const":false},
        "funds_action_authorized":{"const":false},
        "automatic_retry_authorized":{"const":false}
      }
    },
    "next_gate":{
      "const":"durable_single_use_broadcast_authorization_consumption_before_broadcaster_access_v1"
    },
    "broadcast_authorization_verification_id":{
      "type":"string","pattern":"^voiddccbav1_[0-9a-f]{64}$"
    },
    "exact_signed_transaction_broadcast_authorization_verified":{"const":true},
    "sovereign_private_key_access_performed":{"const":false},
    "raw_signed_transaction_accessed":{"const":false},
    "broadcaster_access_performed":{"const":false},
    "transaction_broadcast_performed":{"const":false},
    "chain2050_write_performed":{"const":false},
    "filesystem_mutation_performed":{"const":false},
    "authority_contract":{"type":"object"}
  }
}
