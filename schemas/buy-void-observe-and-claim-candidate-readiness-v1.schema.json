{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "void://schemas/buy-void-observe-and-claim-candidate-readiness-v1",
  "title": "VOID Buy VOID observe-and-claim candidate readiness V1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "marker",
    "version",
    "candidate_stage",
    "readiness_status",
    "request_record_count",
    "eligible_candidate_count",
    "eligible_request_ids",
    "recommended_request_id",
    "records",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "void_buy_void_observe_and_claim_candidate_readiness_v1"
    },
    "marker": {
      "const": "VOID_BUY_VOID_OBSERVE_AND_CLAIM_CANDIDATE_READINESS_V1"
    },
    "version": {
      "const": 1
    },
    "candidate_stage": {
      "const": "observe_and_claim"
    },
    "readiness_status": {
      "enum": [
        "none",
        "exact_one",
        "multiple"
      ]
    },
    "request_record_count": {
      "type": "integer",
      "minimum": 0
    },
    "request_json_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "canonical_request_json_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "operator_event_json_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "ignored_noncanonical_json_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "request_id_count": {
      "type": "integer",
      "minimum": 0
    },
    "orphan_operator_event_request_id_count": {
      "type": "integer",
      "minimum": 0
    },
    "orphan_operator_event_request_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{3,160}$"
      },
      "uniqueItems": true
    },
    "parse_failure_count": {
      "type": "integer",
      "minimum": 0
    },
    "parse_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eligible_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "eligible_request_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{3,160}$"
      },
      "uniqueItems": true
    },
    "recommended_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommended_plan_fingerprint_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "recommended_orchestrator_confirmation": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommended_delegated_confirmation": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommended_stage_confirmation": {
      "type": [
        "string",
        "null"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "orchestrator_status",
          "selected_stage",
          "activation_status",
          "plan_fingerprint_sha256",
          "eligible_observe_and_claim",
          "wallet_access_authorized",
          "signing_authorized",
          "transaction_broadcast_authorized",
          "money_movement_authorized"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{3,160}$"
          },
          "public_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempt_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "broadcast_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "orchestrator_status": {
            "type": "string"
          },
          "orchestrator_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "selected_stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "activation_status": {
            "type": "string"
          },
          "activation_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "plan_fingerprint_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "required_orchestrator_confirmation": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_delegated_confirmation": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_stage_confirmation": {
            "type": [
              "string",
              "null"
            ]
          },
          "eligible_observe_and_claim": {
            "type": "boolean"
          },
          "wallet_access_authorized": {
            "const": false
          },
          "signing_authorized": {
            "const": false
          },
          "transaction_broadcast_authorized": {
            "const": false
          },
          "money_movement_authorized": {
            "const": false
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "server_derived_snapshot_required",
        "exact_request_id_only",
        "runtime_import_mounted",
        "apply_requested",
        "filesystem_write_to_network_state",
        "inventory_reservation",
        "execution_attempt_reservation",
        "wallet_access",
        "signing",
        "transaction_broadcast",
        "rpc_mutation",
        "money_movement",
        "background_loop",
        "startup_execution"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "server_derived_snapshot_required": {
          "const": true
        },
        "exact_request_id_only": {
          "const": true
        },
        "runtime_import_mounted": {
          "const": false
        },
        "apply_requested": {
          "const": false
        },
        "filesystem_write_to_network_state": {
          "const": false
        },
        "inventory_reservation": {
          "const": false
        },
        "execution_attempt_reservation": {
          "const": false
        },
        "wallet_access": {
          "const": false
        },
        "signing": {
          "const": false
        },
        "transaction_broadcast": {
          "const": false
        },
        "rpc_mutation": {
          "const": false
        },
        "money_movement": {
          "const": false
        },
        "background_loop": {
          "const": false
        },
        "startup_execution": {
          "const": false
        }
      }
    }
  }
}
