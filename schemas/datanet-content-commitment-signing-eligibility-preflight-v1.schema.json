{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.org/schemas/datanet-content-commitment-signing-eligibility-preflight-v1.schema.json",
  "title": "VOID DataNet Content Commitment Signing Eligibility Preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "marker",
    "version",
    "status",
    "chain_id",
    "unsigned_call_plan_id",
    "first_pre_sign_revalidation_id",
    "publisher_credential_binding_id",
    "final_pre_sign_revalidation_id",
    "publisher_address",
    "publisher_address_fingerprint_sha256",
    "final_observation_block_number",
    "final_observation_block_hash",
    "policy_fingerprint_sha256",
    "rpc_url_fingerprint_sha256",
    "transaction_candidate",
    "transaction_candidate_sha256",
    "stability",
    "eligibility",
    "authority",
    "next_gate",
    "signing_eligibility_preflight_id",
    "eligible_for_separate_sovereign_one_shot_signing_authorization",
    "this_receipt_is_bearer_signing_authority",
    "raw_private_key_output",
    "signer_object_exposed",
    "signing_performed",
    "transaction_broadcast_performed",
    "chain2050_write_performed",
    "authority_contract"
  ],
  "properties": {
    "ok": {"const": true},
    "marker": {
      "const": "VOID_DATANET_CONTENT_COMMITMENT_SIGNING_ELIGIBILITY_PREFLIGHT_V1"
    },
    "version": {"const": 1},
    "status": {
      "const": "fresh_candidate_and_publisher_identity_stable_eligible_for_separate_sovereign_one_shot_authorization"
    },
    "chain_id": {"const": "2050"},
    "unsigned_call_plan_id": {
      "type": "string",
      "pattern": "^voiddccup1_[0-9a-f]{64}$"
    },
    "first_pre_sign_revalidation_id": {
      "type": "string",
      "pattern": "^voiddccpsr1_[0-9a-f]{64}$"
    },
    "publisher_credential_binding_id": {
      "type": "string",
      "pattern": "^voiddccpcb1_[0-9a-f]{64}$"
    },
    "final_pre_sign_revalidation_id": {
      "type": "string",
      "pattern": "^voiddccpsr1_[0-9a-f]{64}$"
    },
    "publisher_address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "publisher_address_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "final_observation_block_number": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "final_observation_block_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "policy_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rpc_url_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transaction_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_type",
        "chain_id",
        "nonce",
        "from_address",
        "to_address",
        "value_wei",
        "calldata",
        "gas_limit",
        "max_fee_per_gas_wei",
        "max_priority_fee_per_gas_wei"
      ],
      "properties": {
        "transaction_type": {"const": 2},
        "chain_id": {"const": "2050"},
        "nonce": {"type": "string", "pattern": "^[0-9]+$"},
        "from_address": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
        "to_address": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
        "value_wei": {"const": "0"},
        "calldata": {"type": "string", "pattern": "^0x[0-9a-f]+$"},
        "gas_limit": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "max_fee_per_gas_wei": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "max_priority_fee_per_gas_wei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "transaction_candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_revalidation_before_credential_binding",
        "credential_identity_bound_to_first_fresh_candidate",
        "complete_revalidation_after_credential_binding",
        "exact_unsigned_candidate_stable_across_credential_binding",
        "final_object_uncommitted",
        "final_pending_nonce_stable",
        "final_pending_nonce_rechecked_after_final_preflight"
      ],
      "properties": {
        "complete_revalidation_before_credential_binding": {"const": true},
        "credential_identity_bound_to_first_fresh_candidate": {"const": true},
        "complete_revalidation_after_credential_binding": {"const": true},
        "exact_unsigned_candidate_stable_across_credential_binding": {"const": true},
        "final_object_uncommitted": {"const": true},
        "final_pending_nonce_stable": {"const": true},
        "final_pending_nonce_rechecked_after_final_preflight": {"const": true}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_for_separate_sovereign_one_shot_signing_authorization",
        "separate_sovereign_authorization_still_required",
        "this_receipt_is_bearer_signing_authority",
        "later_signer_must_rederive_exact_transaction",
        "later_signer_must_match_publisher_address",
        "broadcast_requires_separate_gate"
      ],
      "properties": {
        "eligible_for_separate_sovereign_one_shot_signing_authorization": {"const": true},
        "separate_sovereign_authorization_still_required": {"const": true},
        "this_receipt_is_bearer_signing_authority": {"const": false},
        "later_signer_must_rederive_exact_transaction": {"const": true},
        "later_signer_must_match_publisher_address": {"const": true},
        "broadcast_requires_separate_gate": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only_chain2050_rpc_performed",
        "credential_content_access_performed",
        "wallet_address_derivation_performed",
        "raw_private_key_output",
        "signer_object_exposed",
        "transaction_signing_authorized",
        "transaction_signing_performed",
        "transaction_broadcast_authorized",
        "transaction_broadcast_performed",
        "chain2050_write_authorized",
        "chain2050_write_performed",
        "validator_mutation_authorized",
        "governance_mutation_authorized",
        "work_credit_mutation_authorized",
        "service_action_authorized",
        "funds_action_authorized",
        "automatic_retry_authorized"
      ],
      "properties": {
        "read_only_chain2050_rpc_performed": {"const": true},
        "credential_content_access_performed": {"const": true},
        "wallet_address_derivation_performed": {"const": true},
        "raw_private_key_output": {"const": false},
        "signer_object_exposed": {"const": false},
        "transaction_signing_authorized": {"const": false},
        "transaction_signing_performed": {"const": false},
        "transaction_broadcast_authorized": {"const": false},
        "transaction_broadcast_performed": {"const": false},
        "chain2050_write_authorized": {"const": false},
        "chain2050_write_performed": {"const": false},
        "validator_mutation_authorized": {"const": false},
        "governance_mutation_authorized": {"const": false},
        "work_credit_mutation_authorized": {"const": false},
        "service_action_authorized": {"const": false},
        "funds_action_authorized": {"const": false},
        "automatic_retry_authorized": {"const": false}
      }
    },
    "next_gate": {
      "const": "sovereign_one_shot_datanet_signing_authorization_without_broadcast_v1"
    },
    "signing_eligibility_preflight_id": {
      "type": "string",
      "pattern": "^voiddccsep1_[0-9a-f]{64}$"
    },
    "eligible_for_separate_sovereign_one_shot_signing_authorization": {
      "const": true
    },
    "this_receipt_is_bearer_signing_authority": {"const": false},
    "raw_private_key_output": {"const": false},
    "signer_object_exposed": {"const": false},
    "signing_performed": {"const": false},
    "transaction_broadcast_performed": {"const": false},
    "chain2050_write_performed": {"const": false},
    "authority_contract": {"type": "object"}
  }
}
