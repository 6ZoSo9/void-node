{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.io/schemas/agent-paid-work-credential-wc-account-binding-registry-v1.schema.json",
  "title": "VOID Agent Paid Work Credential WC Account Binding Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "marker",
    "version",
    "registry_id",
    "updated_at",
    "bindings"
  ],
  "properties": {
    "marker": {
      "const": "VOID_AGENT_PAID_WORK_CREDENTIAL_WC_ACCOUNT_BINDING_REGISTRY_V1"
    },
    "version": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "pattern": "^voidapwcbr1_[0-9a-f]{64}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "bindings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "marker",
          "binding_id",
          "credential_id",
          "agent_id",
          "destination_wc_account",
          "status",
          "valid_from",
          "valid_until",
          "revoked_at",
          "uniqueness_key",
          "source",
          "authority",
          "created_at"
        ],
        "properties": {
          "marker": {
            "const": "VOID_AGENT_PAID_WORK_CREDENTIAL_WC_ACCOUNT_BINDING_V1"
          },
          "binding_id": {
            "type": "string",
            "pattern": "^voidapwcb1_[0-9a-f]{64}$"
          },
          "credential_id": {
            "type": "string",
            "pattern": "^voidapwc1_[0-9a-f]{64}$"
          },
          "agent_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          },
          "destination_wc_account": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "uniqueness_key": {
            "type": "string",
            "pattern": "^paid-work-credential-wc-account:voidapwc1_[0-9a-f]{64}$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "credential_registry_sha256",
              "review_decision_id",
              "issuance_preparation_id"
            ],
            "properties": {
              "credential_registry_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "review_decision_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "issuance_preparation_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "paid_work_submission_identity",
              "wc_award_destination",
              "payment",
              "wc_ledger_write",
              "wc_to_void_settlement",
              "wallet_or_signer"
            ],
            "properties": {
              "paid_work_submission_identity": {
                "const": true
              },
              "wc_award_destination": {
                "const": true
              },
              "payment": {
                "const": false
              },
              "wc_ledger_write": {
                "const": false
              },
              "wc_to_void_settlement": {
                "const": false
              },
              "wallet_or_signer": {
                "const": false
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
