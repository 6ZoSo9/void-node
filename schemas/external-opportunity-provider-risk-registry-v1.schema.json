{
  "$defs": {
    "chainIds": {
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/evmAddress"
        },
        "chain_id": {
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "spoke_pool",
            "router",
            "settlement",
            "token",
            "other"
          ]
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "kind",
        "address",
        "label"
      ],
      "type": "object"
    },
    "evmAddress": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "type": "string"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "contract_allowlist_required_for_live": {
          "const": true
        },
        "max_daily_loss_usd": {
          "minimum": 0,
          "type": "number"
        },
        "max_daily_notional_usd": {
          "minimum": 0,
          "type": "number"
        },
        "max_gas_cost_usd": {
          "minimum": 0,
          "type": "number"
        },
        "max_loss_per_opportunity_usd": {
          "minimum": 0,
          "type": "number"
        },
        "max_notional_usd": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "max_protocol_fee_bps": {
          "minimum": 0,
          "type": "number"
        },
        "max_quote_age_ms": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "max_slippage_bps": {
          "minimum": 0,
          "type": "number"
        },
        "min_net_profit_margin_bps": {
          "minimum": 0,
          "type": "number"
        },
        "min_net_profit_usd": {
          "minimum": 0,
          "type": "number"
        },
        "operator_approval_required_for_live": {
          "const": true
        },
        "simulation_required_for_live": {
          "const": true
        }
      },
      "required": [
        "max_quote_age_ms",
        "max_notional_usd",
        "max_daily_notional_usd",
        "max_protocol_fee_bps",
        "max_gas_cost_usd",
        "max_slippage_bps",
        "min_net_profit_usd",
        "min_net_profit_margin_bps",
        "max_loss_per_opportunity_usd",
        "max_daily_loss_usd",
        "simulation_required_for_live",
        "operator_approval_required_for_live",
        "contract_allowlist_required_for_live"
      ],
      "type": "object"
    },
    "provider": {
      "additionalProperties": false,
      "properties": {
        "allowed_api_origins": {
          "items": {
            "maxLength": 256,
            "pattern": "^https://",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "contract_allowlist": {
          "items": {
            "$ref": "#/$defs/contract"
          },
          "type": "array"
        },
        "destination_chain_ids": {
          "$ref": "#/$defs/chainIds"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "provider_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "source_chain_ids": {
          "$ref": "#/$defs/chainIds"
        },
        "status": {
          "enum": [
            "allowed",
            "blocked"
          ]
        },
        "token_allowlist": {
          "items": {
            "$ref": "#/$defs/token"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "provider_id",
        "display_name",
        "status",
        "allowed_api_origins",
        "source_chain_ids",
        "destination_chain_ids",
        "token_allowlist",
        "contract_allowlist",
        "policy"
      ],
      "type": "object"
    },
    "token": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/evmAddress"
        },
        "chain_id": {
          "minimum": 1,
          "type": "integer"
        },
        "symbol": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "symbol",
        "address"
      ],
      "type": "object"
    }
  },
  "$id": "https://voidchain.io/schemas/external-opportunity-provider-risk-registry-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "automatic_operator_approval": {
          "const": false
        },
        "credential_storage": {
          "const": false
        },
        "live_execution": {
          "const": false
        },
        "network_mutation": {
          "const": false
        },
        "service_mutation": {
          "const": false
        },
        "transaction_construction": {
          "const": false
        },
        "transaction_submission": {
          "const": false
        },
        "wallet_or_key_access": {
          "const": false
        }
      },
      "required": [
        "live_execution",
        "wallet_or_key_access",
        "transaction_construction",
        "transaction_submission",
        "network_mutation",
        "service_mutation",
        "credential_storage",
        "automatic_operator_approval"
      ],
      "type": "object"
    },
    "live_execution_enabled": {
      "const": false
    },
    "marker": {
      "const": "VOID_EXTERNAL_OPPORTUNITY_PROVIDER_RISK_REGISTRY_V1"
    },
    "phase": {
      "const": "paper_only"
    },
    "providers": {
      "items": {
        "$ref": "#/$defs/provider"
      },
      "minItems": 1,
      "type": "array"
    },
    "revision": {
      "const": 1
    },
    "schema": {
      "const": "void-external-opportunity-provider-risk-registry-v1"
    }
  },
  "required": [
    "schema",
    "marker",
    "revision",
    "phase",
    "live_execution_enabled",
    "authority",
    "providers"
  ],
  "title": "VOID External Opportunity Provider Risk Registry V1",
  "type": "object"
}
