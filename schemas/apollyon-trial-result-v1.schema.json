{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.org/schemas/apollyon-trial-result-v1.schema.json",
  "title": "VOID Apollyon Trial Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","trial_id","contestant","output","evidence_refs","result_sha256"],
  "properties": {
    "schema_version": { "const": "apollyon-trial-result-v1" },
    "trial_id": { "type": "string", "pattern": "^voidat1_[a-f0-9]{64}$" },
    "contestant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_label","model_label"],
      "properties": {
        "provider_label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model_label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runtime_label": { "type": "string", "maxLength": 256 }
      }
    },
    "output": { "type": "string", "maxLength": 262144 },
    "evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "latency_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "self_reported_cost": { "type": "string", "maxLength": 128 },
    "result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
