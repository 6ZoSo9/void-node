{
  "$id": "https://voidchain.io/schemas/public-agent-service-order-submission-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "marker": {
      "const": "VOID_PUBLIC_AGENT_SERVICE_ORDER_SUBMISSION_V1"
    },
    "order_request": {
      "$ref": "public-agent-service-order-request-v1.schema.json"
    },
    "submission_nonce": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "marker",
    "version",
    "submission_nonce",
    "order_request"
  ],
  "title": "VOID Public Agent Service Order Submission V1",
  "type": "object",
  "x_void_marker": "VOID_PUBLIC_AGENT_SERVICE_ORDER_SUBMISSION_SCHEMA_V1"
}
