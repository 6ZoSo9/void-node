{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidnetwork.org/schemas/buy-void-chain2050-presale-two-phase-v1.schema.json",
  "title": "VOID Buy VOID Chain-2050 two-phase presale reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "marker",
    "constants",
    "authority",
    "genesis_state",
    "source_payment",
    "reservation",
    "reserved_state",
    "chain2050_delivery",
    "fulfillment",
    "final_state"
  ],
  "properties": {
    "schema": { "const": "void_buy_void_chain2050_presale_two_phase_fixture_v1" },
    "marker": { "const": "VOID_BUY_VOID_CHAIN2050_PRESALE_TWO_PHASE_V1" },
    "constants": { "$ref": "#/$defs/constants" },
    "authority": { "$ref": "#/$defs/authority" },
    "genesis_state": { "$ref": "#/$defs/state" },
    "source_payment": { "$ref": "#/$defs/sourcePayment" },
    "reservation": { "$ref": "#/$defs/reservation" },
    "reserved_state": { "$ref": "#/$defs/state" },
    "chain2050_delivery": { "$ref": "#/$defs/delivery" },
    "fulfillment": { "$ref": "#/$defs/fulfillment" },
    "final_state": { "$ref": "#/$defs/state" }
  },
  "$defs": {
    "hash32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "uint": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "constants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id","pool_id","policy_id","initial_inventory_void_atoms",
        "void_decimals","usdc_decimals","rate_void_atoms_numerator",
        "rate_void_atoms_denominator","exact_payment_required",
        "payment_confirmation_separate_from_fulfillment","no_hidden_minimum",
        "no_per_buyer_throttle_below_remaining_inventory"
      ],
      "properties": {
        "chain_id": { "const": "2050" },
        "pool_id": { "const": "buy-void-presale-v1" },
        "policy_id": { "const": "void-buy-void-presale-two-phase-v1" },
        "initial_inventory_void_atoms": { "const": "10000000000000" },
        "void_decimals": { "const": 6 },
        "usdc_decimals": { "const": 6 },
        "rate_void_atoms_numerator": { "const": "2" },
        "rate_void_atoms_denominator": { "const": "1" },
        "exact_payment_required": { "const": true },
        "payment_confirmation_separate_from_fulfillment": { "const": true },
        "no_hidden_minimum": { "const": true },
        "no_per_buyer_throttle_below_remaining_inventory": { "const": true }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_only_reference_machine","chain_state_mutation","source_chain_rpc_call",
        "chain2050_rpc_call","filesystem_read","filesystem_write","credential_access",
        "wallet_access","signer_access","transaction_construction","transaction_signing",
        "transaction_broadcast","inventory_funding","public_presale_activation","money_movement"
      ],
      "properties": {
        "source_only_reference_machine": { "const": true },
        "chain_state_mutation": { "const": false },
        "source_chain_rpc_call": { "const": false },
        "chain2050_rpc_call": { "const": false },
        "filesystem_read": { "const": false },
        "filesystem_write": { "const": false },
        "credential_access": { "const": false },
        "wallet_access": { "const": false },
        "signer_access": { "const": false },
        "transaction_construction": { "const": false },
        "transaction_signing": { "const": false },
        "transaction_broadcast": { "const": false },
        "inventory_funding": { "const": false },
        "public_presale_activation": { "const": false },
        "money_movement": { "const": false }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema","marker","version","chain_id","pool_id","policy_id",
        "initial_inventory_void_atoms","available_inventory_void_atoms",
        "reserved_inventory_void_atoms","fulfilled_inventory_void_atoms",
        "confirmed_payment_count","fulfilled_payment_count","state_sequence",
        "previous_state_sha256","last_transition_anchor_sha256",
        "transition_root_sha256","state_sha256"
      ],
      "properties": {
        "schema": { "const": "void_buy_void_chain2050_presale_state_v2" },
        "marker": { "const": "VOID_BUY_VOID_CHAIN2050_PRESALE_STATE_V2" },
        "version": { "const": 2 },
        "chain_id": { "const": "2050" },
        "pool_id": { "const": "buy-void-presale-v1" },
        "policy_id": { "const": "void-buy-void-presale-two-phase-v1" },
        "initial_inventory_void_atoms": { "const": "10000000000000" },
        "available_inventory_void_atoms": { "$ref": "#/$defs/uint" },
        "reserved_inventory_void_atoms": { "$ref": "#/$defs/uint" },
        "fulfilled_inventory_void_atoms": { "$ref": "#/$defs/uint" },
        "confirmed_payment_count": { "$ref": "#/$defs/uint" },
        "fulfilled_payment_count": { "$ref": "#/$defs/uint" },
        "state_sequence": { "$ref": "#/$defs/uint" },
        "previous_state_sha256": { "anyOf": [{ "$ref": "#/$defs/hex64" }, { "type": "null" }] },
        "last_transition_anchor_sha256": { "anyOf": [{ "$ref": "#/$defs/hex64" }, { "type": "null" }] },
        "transition_root_sha256": { "$ref": "#/$defs/hex64" },
        "state_sha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "sourcePayment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema","marker","source_chain","source_chain_id","source_transaction_hash",
        "source_log_index","canonical_payment_identity","payment_key_sha256","payer_address",
        "delivery_address","payment_usdc_atoms","source_policy_fingerprint_sha256",
        "source_finality_attestation_sha256","finality_status","exact_payment_verified"
      ],
      "properties": {
        "schema": { "const": "void_buy_void_finalized_source_payment_v1" },
        "marker": { "const": "VOID_BUY_VOID_FINALIZED_SOURCE_PAYMENT_V1" },
        "source_chain": { "enum": ["base","ethereum"] },
        "source_chain_id": { "enum": ["8453","1"] },
        "source_transaction_hash": { "$ref": "#/$defs/hash32" },
        "source_log_index": { "$ref": "#/$defs/uint" },
        "canonical_payment_identity": { "type": "string", "pattern": "^voidpay1:(base|ethereum):0x[0-9a-f]{64}:(0|[1-9][0-9]*)$" },
        "payment_key_sha256": { "$ref": "#/$defs/hex64" },
        "payer_address": { "$ref": "#/$defs/address" },
        "delivery_address": { "$ref": "#/$defs/address" },
        "payment_usdc_atoms": { "$ref": "#/$defs/uint" },
        "source_policy_fingerprint_sha256": { "$ref": "#/$defs/hex64" },
        "source_finality_attestation_sha256": { "$ref": "#/$defs/hex64" },
        "finality_status": { "const": "finalized" },
        "exact_payment_verified": { "const": true }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema","marker","version","pool_id","policy_id","payment_key_sha256",
        "canonical_payment_identity","source_chain","source_chain_id","source_transaction_hash",
        "source_log_index","source_policy_fingerprint_sha256","source_finality_attestation_sha256",
        "payer_address","delivery_address","payment_usdc_atoms","reserved_void_atoms",
        "previous_state_sha256","state_sequence","reservation_anchor_sha256"
      ],
      "properties": {
        "schema": { "const": "void_buy_void_chain2050_payment_reservation_v1" },
        "marker": { "const": "VOID_BUY_VOID_CHAIN2050_PAYMENT_RESERVATION_V1" },
        "version": { "const": 1 },
        "pool_id": { "const": "buy-void-presale-v1" },
        "policy_id": { "const": "void-buy-void-presale-two-phase-v1" },
        "payment_key_sha256": { "$ref": "#/$defs/hex64" },
        "canonical_payment_identity": { "type": "string" },
        "source_chain": { "enum": ["base","ethereum"] },
        "source_chain_id": { "enum": ["8453","1"] },
        "source_transaction_hash": { "$ref": "#/$defs/hash32" },
        "source_log_index": { "$ref": "#/$defs/uint" },
        "source_policy_fingerprint_sha256": { "$ref": "#/$defs/hex64" },
        "source_finality_attestation_sha256": { "$ref": "#/$defs/hex64" },
        "payer_address": { "$ref": "#/$defs/address" },
        "delivery_address": { "$ref": "#/$defs/address" },
        "payment_usdc_atoms": { "$ref": "#/$defs/uint" },
        "reserved_void_atoms": { "$ref": "#/$defs/uint" },
        "previous_state_sha256": { "$ref": "#/$defs/hex64" },
        "state_sequence": { "$ref": "#/$defs/uint" },
        "reservation_anchor_sha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema","marker","chain_id","transaction_hash","log_index","block_height",
        "block_hash","recipient_address","void_amount_atoms","execution_status",
        "accepted_checkpoint_height","accepted_checkpoint_hash","finality_policy_id",
        "finality_attestation_sha256"
      ],
      "properties": {
        "schema": { "const": "void_chain2050_finalized_delivery_v1" },
        "marker": { "const": "VOID_CHAIN2050_FINALIZED_DELIVERY_V1" },
        "chain_id": { "const": "2050" },
        "transaction_hash": { "$ref": "#/$defs/hash32" },
        "log_index": { "$ref": "#/$defs/uint" },
        "block_height": { "$ref": "#/$defs/uint" },
        "block_hash": { "$ref": "#/$defs/hash32" },
        "recipient_address": { "$ref": "#/$defs/address" },
        "void_amount_atoms": { "$ref": "#/$defs/uint" },
        "execution_status": { "const": "success" },
        "accepted_checkpoint_height": { "$ref": "#/$defs/uint" },
        "accepted_checkpoint_hash": { "$ref": "#/$defs/hash32" },
        "finality_policy_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "finality_attestation_sha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "fulfillment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema","marker","version","pool_id","policy_id","payment_key_sha256",
        "reservation_anchor_sha256","canonical_payment_identity","delivery_address",
        "delivery_void_atoms","delivery_event_identity","delivery_event_key_sha256",
        "chain2050_transaction_hash","chain2050_log_index","chain2050_block_height",
        "chain2050_block_hash","chain2050_accepted_checkpoint_height",
        "chain2050_accepted_checkpoint_hash","chain2050_finality_policy_id",
        "chain2050_finality_attestation_sha256","previous_state_sha256",
        "state_sequence","fulfillment_anchor_sha256"
      ],
      "properties": {
        "schema": { "const": "void_buy_void_chain2050_fulfillment_record_v1" },
        "marker": { "const": "VOID_BUY_VOID_CHAIN2050_FULFILLMENT_RECORD_V1" },
        "version": { "const": 1 },
        "pool_id": { "const": "buy-void-presale-v1" },
        "policy_id": { "const": "void-buy-void-presale-two-phase-v1" },
        "payment_key_sha256": { "$ref": "#/$defs/hex64" },
        "reservation_anchor_sha256": { "$ref": "#/$defs/hex64" },
        "canonical_payment_identity": { "type": "string" },
        "delivery_address": { "$ref": "#/$defs/address" },
        "delivery_void_atoms": { "$ref": "#/$defs/uint" },
        "delivery_event_identity": { "type": "string" },
        "delivery_event_key_sha256": { "$ref": "#/$defs/hex64" },
        "chain2050_transaction_hash": { "$ref": "#/$defs/hash32" },
        "chain2050_log_index": { "$ref": "#/$defs/uint" },
        "chain2050_block_height": { "$ref": "#/$defs/uint" },
        "chain2050_block_hash": { "$ref": "#/$defs/hash32" },
        "chain2050_accepted_checkpoint_height": { "$ref": "#/$defs/uint" },
        "chain2050_accepted_checkpoint_hash": { "$ref": "#/$defs/hash32" },
        "chain2050_finality_policy_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "chain2050_finality_attestation_sha256": { "$ref": "#/$defs/hex64" },
        "previous_state_sha256": { "$ref": "#/$defs/hex64" },
        "state_sequence": { "$ref": "#/$defs/uint" },
        "fulfillment_anchor_sha256": { "$ref": "#/$defs/hex64" }
      }
    }
  }
}
