            "external_side_effects_allowed": {
              "const": false
            },
            "wallet_access_allowed": {
              "const": false
            },
            "money_movement_allowed": {
              "const": false
            }
          }
        },
        "nonce": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]{8,128}$"
