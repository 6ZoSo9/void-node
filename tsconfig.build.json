{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    "declaration": false,
    "noEmit": false,
    "isolatedModules": false,
    "skipLibCheck": true,
    "sourceMap": false,

    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "script",
    "ops",
    "config",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
