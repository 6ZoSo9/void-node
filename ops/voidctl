#!/usr/bin/env bash
set -euo pipefail

CTL_DIR="${HOME}/.config/void"
CTL_ENV="${CTL_DIR}/voidctl.env"

if [ -f "${CTL_ENV}" ]; then
  # shellcheck disable=SC1090
  . "${CTL_ENV}"
fi

HOST="${VOID_HTTP_HOST:-127.0.0.1}"
PORT="${VOID_HTTP_PORT:-4100}"
BASE="http://${HOST}:${PORT}"

KEY_PATH_DEFAULT="${HOME}/.secrets/void-node-demo.key.pkcs8.pem"
DATA_DIR_DEFAULT="${HOME}/void-data"
SERVICE_NAME="${VOID_SYSTEMD_UNIT:-void-node.service}"

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "[FAIL] missing dependency: $1" >&2
    exit 1
  }
}

need curl
need python3

j() { curl -fsS --max-time 4 "${BASE}$1"; }

usage() {
  cat <<EOF
VOIDCTL v0

Usage:
  ops/voidctl init
  ops/voidctl install-service
  ops/voidctl start
  ops/voidctl stop
  ops/voidctl version
  ops/voidctl status
  ops/voidctl doctor
  ops/voidctl update-check
  ops/voidctl update-verify
  ops/voidctl update-plan
  ops/voidctl update-apply
  ops/voidctl demo-summary
  ops/voidctl agent-summary

Env:
  VOID_HTTP_HOST     default: 127.0.0.1
  VOID_HTTP_PORT     default: 4100
  VOID_SYSTEMD_UNIT  default: void-node.service
EOF
}

ensure_dirs() {
  mkdir -p "${CTL_DIR}"
  mkdir -p "${HOME}/.secrets"
  mkdir -p "${DATA_DIR_DEFAULT}"
}

load_env_if_present() {
  if [ -f "${CTL_ENV}" ]; then
    # shellcheck disable=SC1090
    . "${CTL_ENV}"
  fi
}

cmd_init() {
  ensure_dirs
  load_env_if_present

  local http_host="${VOID_HTTP_HOST:-127.0.0.1}"
  local http_port="${VOID_HTTP_PORT:-4110}"
  local p2p_port="${VOID_P2P_PORT:-4710}"
  local service_name="${VOID_SYSTEMD_UNIT:-void-node-local.service}"
  local key_path="${VOID_KEY_PATH:-${KEY_PATH_DEFAULT}}"
  local data_dir="${VOID_DATA_DIR:-${DATA_DIR_DEFAULT}}"

  if [ ! -f "${key_path}" ]; then
    mkdir -p "$(dirname "${key_path}")"
    openssl genpkey -algorithm ed25519 -out "${key_path}"
    chmod 600 "${key_path}" || true
    echo "[ok] generated pkcs8 ed25519 key: ${key_path}"
  else
    chmod 600 "${key_path}" || true
    echo "[ok] key exists: ${key_path}"
  fi

  cat > "${CTL_ENV}" <<EOF
# VOIDCTL local config v0
VOID_HTTP_HOST=${http_host}
VOID_HTTP_PORT=${http_port}
VOID_P2P_PORT=${p2p_port}
VOID_SYSTEMD_UNIT=${service_name}
VOID_KEY_PATH=${key_path}
VOID_DATA_DIR=${data_dir}
EOF

  chmod 600 "${CTL_ENV}" || true

  echo "[ok] wrote ${CTL_ENV}"
  echo
  echo "=== config ==="
  sed -n "1,120p" "${CTL_ENV}"
  echo
  echo "[ok] init complete"
  echo "next:"
  echo "  ops/voidctl start"
  echo "  ops/voidctl status"
}

cmd_start() {
  load_env_if_present
  systemctl --user daemon-reload
  systemctl --user start "${SERVICE_NAME}"
  sleep 2
  echo "[ok] started ${SERVICE_NAME}"
  systemctl --user --no-pager --full status "${SERVICE_NAME}" -n 20 || true
}

cmd_stop() {
  load_env_if_present
  systemctl --user stop "${SERVICE_NAME}"
  echo "[ok] stopped ${SERVICE_NAME}"
}

print_json_pretty() {
  python3 -m json.tool
}

cmd_version() {
  j /version | print_json_pretty
}

cmd_update_check() {
  j /upgrade/check | print_json_pretty
}

cmd_update_verify() {
  local U
  U="$(j /upgrade/check)"
  python3 -c 'import json,sys\nfrom pathlib import Path
u=json.loads(sys.argv[1])

manifest_found = bool(u.get("manifest_found"))
compatible = bool(u.get("compatible"))
signature_valid = bool(u.get("signature_valid"))
signature_present = bool(u.get("signature_present"))
verification_reason = u.get("verification_reason")
trust_state = "verified" if signature_valid else ("signed-unverified" if signature_present else "unsigned")

print("VOID update verify")
print("------------------")
print("manifest_found:", manifest_found)
print("compatible:", compatible)
print("signature_present:", signature_present)
print("signature_valid:", signature_valid)
print("verification_reason:", verification_reason)
print("trust_state:", trust_state)

ok = manifest_found and compatible and signature_valid
raise SystemExit(0 if ok else 1)' "$U"
}

cmd_update_plan() {
  load_env_if_present

  local TS BACKUP_DIR
  TS="$(date +%Y%m%d-%H%M%S)"
  BACKUP_DIR="${HOME}/.config/void/backups/update-apply-${TS}"

  local U
  U="$(j /upgrade/check)"
  python3 -c 'import json,sys
u=json.loads(sys.argv[1])
local=u.get("local") or {}
manifest=u.get("manifest") or {}
print("VOID update plan")
print("----------------")
print("local_version:", local.get("version"))
print("local_protocol:", local.get("protocol_version"))
print("manifest_found:", u.get("manifest_found"))
print("manifest_version:", manifest.get("version"))
print("manifest_protocol:", manifest.get("protocol_version"))
print("manifest_min_protocol:", manifest.get("min_protocol_version"))
print("channel:", manifest.get("channel"))
print("compatible:", u.get("compatible"))
print("update_available:", u.get("update_available"))
print("reason:", u.get("reason"))
print("signature_present:", u.get("signature_present"))
print("signature_valid:", u.get("signature_valid"))
print("verification_reason:", u.get("verification_reason"))
print("trust_state:", "verified" if u.get("signature_valid") else ("signed-unverified" if u.get("signature_present") else "unsigned"))
print("")
print("service:", sys.argv[2])
print("backup_dir:", sys.argv[3])
print("")
print("planned_steps:")
print("  1. stop service:", sys.argv[2])
print("  2. back up ops/voidctl, config, and current install state")
print("  3. verify manifest/signature (stub today)")
print("  4. apply new files/binaries (stub today)")
print("  5. start service: " + sys.argv[2])
print("  6. run ops/voidctl doctor")' "$U" "$SERVICE_NAME" "$BACKUP_DIR"
}

cmd_update_apply() {
  load_env_if_present

  local TS BACKUP_DIR UNIT_PATH
  TS="$(date +%Y%m%d-%H%M%S)"
  BACKUP_DIR="${HOME}/.config/void/backups/update-apply-${TS}"
  UNIT_PATH="${HOME}/.config/systemd/user/${SERVICE_NAME}"

  mkdir -p "${BACKUP_DIR}"

  [ -f "${CTL_ENV}" ] && cp -a "${CTL_ENV}" "${BACKUP_DIR}/voidctl.env" || true
  [ -f "${UNIT_PATH}" ] && cp -a "${UNIT_PATH}" "${BACKUP_DIR}/$(basename "${UNIT_PATH}")" || true
  [ -f "config/update-manifest.v0.json" ] && cp -a "config/update-manifest.v0.json" "${BACKUP_DIR}/update-manifest.v0.json" || true
  [ -f "config/update-pubkey.v1.pem" ] && cp -a "config/update-pubkey.v1.pem" "${BACKUP_DIR}/update-pubkey.v1.pem" || true
  [ -f "ops/voidctl" ] && cp -a "ops/voidctl" "${BACKUP_DIR}/voidctl" || true

  local U
  U="$(j /upgrade/check)"
  python3 -c 'import json,sys
u=json.loads(sys.argv[1])
local=u.get("local") or {}
manifest=u.get("manifest") or {}

manifest_found = bool(u.get("manifest_found"))
compatible = bool(u.get("compatible"))
signature_valid = bool(u.get("signature_valid"))
signature_present = bool(u.get("signature_present"))
reason = u.get("reason")
verification_reason = u.get("verification_reason")
trust_state = "verified" if signature_valid else ("signed-unverified" if signature_present else "unsigned")

print("VOID update apply (dry-run)")
print("---------------------------")
print("mode:", "dry-run")
print("service:", sys.argv[3])
print("local_version:", local.get("version"))
print("target_version:", manifest.get("version"))
print("compatible:", compatible)
print("update_available:", u.get("update_available"))
print("reason:", reason)
print("signature_present:", signature_present)
print("signature_valid:", signature_valid)
print("verification_reason:", verification_reason)
print("trust_state:", trust_state)
print("")

failures = []
if not manifest_found:
    failures.append("manifest_missing")
if not compatible:
    failures.append("incompatible_protocol")
if not signature_valid:
    failures.append("signature_not_valid")

if failures:
    print("blocked:")
    for f in failures:
        print("  -", f)
    print("")
    print("refusing apply plan because trust checks failed")
    raise SystemExit(1)

print("backup_dir:", sys.argv[2])
print("")
print("would_run:")
print("  systemctl --user stop " + sys.argv[3])
print("  backup current install/config")
print("  verify signed manifest")
print("  stage replacement artifacts")
print("  systemctl --user start " + sys.argv[3])
print("  ops/voidctl doctor")
print("")
print("rollback_commands:")
print("  systemctl --user stop " + sys.argv[3])
print("  cp -a " + sys.argv[2] + "/voidctl.env " + sys.argv[4] + "/.config/void/voidctl.env")
print("  cp -a " + sys.argv[2] + "/" + sys.argv[3] + " " + sys.argv[4] + "/.config/systemd/user/" + sys.argv[3])
print("  cp -a " + sys.argv[2] + "/update-manifest.v0.json config/update-manifest.v0.json")
print("  test ! -f " + sys.argv[2] + "/update-pubkey.v1.pem || cp -a " + sys.argv[2] + "/update-pubkey.v1.pem config/update-pubkey.v1.pem")
print("  cp -a " + sys.argv[2] + "/voidctl ops/voidctl")
print("  chmod +x ops/voidctl")
print("  systemctl --user daemon-reload")
print("  systemctl --user start " + sys.argv[3])
print("  ops/voidctl doctor")' "$U" "$BACKUP_DIR" "$SERVICE_NAME" "$HOME"
}

cmd_demo_summary() {
  j /__void/demo/summary.json | print_json_pretty
}

cmd_agent_summary() {
  j /__void/agent/summary.json | print_json_pretty
}

cmd_status() {
  local health demo agent
  health="$(j /health)"
  demo="$(j /__void/demo/summary.json)"
  agent="$(j /__void/agent/summary.json)"
  python3 -c 'import json,sys
h=json.loads(sys.argv[1]); d=json.loads(sys.argv[2]); a=json.loads(sys.argv[3])
c=d.get("chain") or {}
dn=d.get("datanet") or {}
u=d.get("update") or {}
latest=dn.get("latest_dataset") or {}
counts=a.get("counts") or {}
print("VOID status")
print("-----------")
print("node_id:", h.get("nodeId"))
print("http:", h.get("http"))
print("p2p:", h.get("p2p"))
print("listen:", ", ".join(h.get("listen") or []))
print("head:", c.get("head"))
print("mempool:", c.get("mempool_count"))
print("loopproof:", dn.get("loopproof_ok"))
print("latest_ds:", latest.get("id"))
print("receipts:", dn.get("receipts_count"))
print("version:", u.get("version"))
print("protocol:", u.get("protocol_version"))
print("channel:", u.get("channel"))
print("agent_total:", counts.get("total"))
print("agent_queued:", counts.get("queued"))
print("agent_picked:", counts.get("picked"))
print("agent_done:", counts.get("completed"))' "$health" "$demo" "$agent"
}

cmd_doctor() {
  local fails=0
  ok(){ curl -fsS --max-time 3 "${BASE}$1" >/dev/null && echo "[ok] $2" || { echo "[FAIL] $2"; fails=$((fails+1)); }; }

  echo "VOID doctor"
  echo "-----------"
  echo "[info] base=${BASE}"

  ok /health health
  ok /version version
  ok /upgrade/check upgrade-check
  ok /__void/demo/summary.json demo-summary
  ok /__void/agent/summary.json agent-summary
  ok "/datanet/list?limit=1" datanet-list

  echo
  if [ "$fails" -eq 0 ]; then
    echo "[ok] doctor passed"
  else
    echo "[FAIL] doctor found ${fails} issue(s)"
    exit 1
  fi
}

cmd_install_service() {
  load_env
  mkdir -p "${HOME}/.config/systemd/user"

  local UNIT_PATH="${HOME}/.config/systemd/user/${SERVICE_NAME}"
  local REPO_DIR
  REPO_DIR="$(pwd)"

  cat > "${UNIT_PATH}" <<EOF
[Unit]
Description=VOID Node (installed by voidctl)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${REPO_DIR}
Environment=NODE_ENV=production
Environment=HTTP_PORT=${VOID_HTTP_PORT}
Environment=P2P_PORT=${VOID_P2P_PORT}
Environment=HOST=0.0.0.0
Environment=DATA_DIR=${VOID_DATA_DIR}
Environment=KEY_PATH=${VOID_KEY_PATH}
Environment=NODE_PRIVKEY_PATH=${VOID_KEY_PATH}
Environment=VOID_NODE_KEY_A=${VOID_KEY_PATH}
ExecStart=/usr/bin/env npx tsx src/index.ts
Restart=always
RestartSec=2
TimeoutStopSec=20

[Install]
WantedBy=default.target
EOF

  systemctl --user daemon-reload
  systemctl --user enable --now "${SERVICE_NAME}"

  echo "[ok] wrote ${UNIT_PATH}"
  echo "[ok] enabled+started ${SERVICE_NAME}"
  echo "[info] service=${SERVICE_NAME}"
  echo "[info] http=${VOID_HTTP_PORT}"
  echo "[info] p2p=${VOID_P2P_PORT}"
  echo "[info] data_dir=${VOID_DATA_DIR}"
  echo "[info] key_path=${VOID_KEY_PATH}"
  sleep 3
  cmd_doctor
}


load_env() {
  mkdir -p "${HOME}/.config/void"
  if [ -f "${CTL_ENV}" ]; then
    # shellcheck disable=SC1090
    . "${CTL_ENV}"
  fi
  HOST="${VOID_HTTP_HOST:-127.0.0.1}"
  PORT="${VOID_HTTP_PORT:-4100}"
  BASE="http://${HOST}:${PORT}"
  SERVICE_NAME="${VOID_SYSTEMD_UNIT:-void-node.service}"
  KEY_PATH_DEFAULT="${HOME}/.secrets/void-node-demo.key.pkcs8.pem"
  DATA_DIR_DEFAULT="${HOME}/void-data"
  VOID_P2P_PORT="${VOID_P2P_PORT:-4710}"
}


main() {
  case "${1:-help}" in
    init) shift; cmd_init "$@" ;;
    install-service) shift; cmd_install_service "$@" ;;
    start) shift; cmd_start "$@" ;;
    stop) shift; cmd_stop "$@" ;;
    version) shift; cmd_version "$@" ;;
    status) shift; cmd_status "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    update-check) shift; cmd_update_check "$@" ;;
    update-verify) shift; cmd_update_verify "$@" ;;
    update-plan) shift; cmd_update_plan "$@" ;;
    update-apply) shift; cmd_update_apply "$@" ;;
    demo-summary) shift; cmd_demo_summary "$@" ;;
    agent-summary) shift; cmd_agent_summary "$@" ;;
    ""|-h|--help|help) usage ;;
    *)
      echo "[FAIL] unknown command: ${1:-}" >&2
      echo >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
