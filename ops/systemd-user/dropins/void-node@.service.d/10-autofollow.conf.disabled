[Service]
# Start follower loop a few seconds after HTTP binds (only when FOLLOW_AUTOSTART=1)
ExecStartPost=/bin/sh -lc '[ "${FOLLOW_AUTOSTART}" = "1" ] && { sleep 5; curl -fsS -X POST "http://127.0.0.1:${HTTP_PORT}/follower/start?peer=${PUBLIC_HTTP_BASE_MAIN:-http://127.0.0.1:4100}&intervalMs=1000" >/dev/null || true; } || true'
