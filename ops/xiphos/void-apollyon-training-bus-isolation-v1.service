[Unit]
Description=VOID Apollyon candidate training bus-isolation boundary v1
Documentation=VOID_APOLLYON_TRAINING_BUS_ISOLATION_V1

[Service]
Type=simple
User=voidapollyontrain
Group=voidapollyontrain
WorkingDirectory=/var/lib/void-apollyon-training-v1
ExecStart=/opt/void-apollyon-training-v1/apollyon_candidate_training_entrypoint_v1

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

PrivateNetwork=yes
RestrictAddressFamilies=none
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~socket socketpair connect accept accept4 bind listen sendto recvfrom sendmsg recvmsg sendmmsg recvmmsg pidfd_getfd io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM

StandardInput=null
StandardOutput=journal
StandardError=journal
FileDescriptorStoreMax=0
NotifyAccess=none

RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
ProtectProc=invisible
ProcSubset=pid

ReadOnlyPaths=/opt/void-apollyon-training-v1
ReadOnlyPaths=/var/lib/void-apollyon-training-v1/input
ReadWritePaths=/var/lib/void-apollyon-training-v1/output

Restart=no
