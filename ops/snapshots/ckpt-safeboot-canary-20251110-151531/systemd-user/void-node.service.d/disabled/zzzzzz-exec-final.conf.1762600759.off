  -r /home/zoso/.config/void/boot/crypto-shim.js \
  -r /home/zoso/.config/void/boot/wal-gate-off.js \
  -r /home/zoso/.config/void/boot/wal-gate-metric-zero4.js \
  -r /home/zoso/.config/void/boot/wal-gate-route-override.js \
  -r /home/zoso/dev/void-node/node_modules/tsx/dist/preflight.cjs \
  --import file:///home/zoso/dev/void-node/node_modules/tsx/dist/loader.mjs \
