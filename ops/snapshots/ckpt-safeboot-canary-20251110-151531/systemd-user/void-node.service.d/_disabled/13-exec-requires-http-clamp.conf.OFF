[Service]
ExecStart=
ExecStart=/usr/bin/env -S bash -lc \
 'exec node \
   -r /home/zoso/.config/void/boot/header3-hardlock-pre.js \
   -r /home/zoso/.config/void/boot/listen-guard.js \
   -r /home/zoso/.config/void/boot/crypto-shim.js \
   -r /home/zoso/.config/void/boot/wal-gate-off.js \
   -r /home/zoso/.config/void/boot/wal-gate-metric-zero2.js \
   node_modules/.bin/tsx src/index.ts'
