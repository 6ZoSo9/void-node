# Wall remains disabled until this is explicitly set to 1.
VOID_P2P_EDGE_WALL_ENABLED=0

VOID_P2P_EDGE_WALL_MODE=listen
VOID_P2P_EDGE_WALL_NETWORK_ID=void-mainnet0-chain2050
VOID_P2P_EDGE_WALL_LISTEN_HOST=0.0.0.0
VOID_P2P_EDGE_WALL_LISTEN_PORT=4790

# The existing VOID P2P listener must remain loopback-only behind the wall.
VOID_P2P_EDGE_WALL_BACKEND_HOST=127.0.0.1
VOID_P2P_EDGE_WALL_BACKEND_PORT=4700

VOID_P2P_EDGE_WALL_KEY_FILE=/home/void/.void/p2p-edge-wall-v1/edge-identity-ed25519.key.pem
VOID_P2P_EDGE_WALL_CERT_FILE=/home/void/.void/p2p-edge-wall-v1/edge-identity-ed25519.cert.pem

# Fail-closed default. Populate the exact 64-hex node IDs allowed to connect.
VOID_P2P_EDGE_WALL_ALLOW_NODE_IDS=
VOID_P2P_EDGE_WALL_DENY_NODE_IDS=
VOID_P2P_EDGE_WALL_PERMISSIONLESS=0

# Dial targets are JSON. expected_node_id pins the remote certificate identity.
VOID_P2P_EDGE_WALL_PEERS_JSON=[]
# Example:
# VOID_P2P_EDGE_WALL_PEERS_JSON=[{"host":"198.51.100.10","port":4790,"expected_node_id":"0123...64hex"}]

# Status is deliberately loopback-only.
VOID_P2P_EDGE_WALL_STATUS_HOST=127.0.0.1
VOID_P2P_EDGE_WALL_STATUS_PORT=4190
VOID_P2P_EDGE_WALL_AUDIT_LOG=/var/lib/void/p2p-edge-wall-v1/audit.ndjson

VOID_P2P_EDGE_WALL_HANDSHAKE_TIMEOUT_MS=10000
VOID_P2P_EDGE_WALL_MAX_CLOCK_SKEW_MS=60000
VOID_P2P_EDGE_WALL_IDLE_TIMEOUT_MS=120000
VOID_P2P_EDGE_WALL_BACKEND_CONNECT_TIMEOUT_MS=5000
VOID_P2P_EDGE_WALL_MAX_CONNECTIONS=128
VOID_P2P_EDGE_WALL_MAX_CONNECTIONS_PER_IP=8
VOID_P2P_EDGE_WALL_MAX_PENDING_HANDSHAKES=32
VOID_P2P_EDGE_WALL_MAX_AUTH_LINE_BYTES=16384
VOID_P2P_EDGE_WALL_QUARANTINE_THRESHOLD=3
VOID_P2P_EDGE_WALL_QUARANTINE_BASE_MS=30000
VOID_P2P_EDGE_WALL_QUARANTINE_MAX_MS=3600000
VOID_P2P_EDGE_WALL_RECONNECT_MIN_MS=1000
VOID_P2P_EDGE_WALL_RECONNECT_MAX_MS=30000
