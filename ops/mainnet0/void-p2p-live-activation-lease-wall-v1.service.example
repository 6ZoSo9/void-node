[Unit]
Description=VOID P2P Live Activation Lease Wall v1
Documentation=file:/opt/void-node/docs/architecture/p2p-live-activation-lease-wall-v1.md
Wants=network-online.target
After=network-online.target
Conflicts=void-p2p-authenticated-edge-wall-v1.service
Conflicts=void-p2p-signed-trust-policy-wall-v1.service
Conflicts=void-p2p-node-bound-activation-permit-wall-v1.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=void
Group=void
WorkingDirectory=/opt/void-node
EnvironmentFile=/etc/void/p2p-live-activation-lease-wall-v1.env
UMask=0077
StateDirectory=void-p2p-activation-permit-wall-v1
StateDirectoryMode=0700
RuntimeDirectory=void-p2p-live-activation-lease-wall-v1
RuntimeDirectoryMode=0700
ExecStartPre=/opt/void-node/node_modules/.bin/tsx /opt/void-node/src/p2p/run_live_activation_lease_wall_v1.ts verify
ExecStart=/opt/void-node/ops/mainnet0/run-p2p-live-activation-lease-wall-v1.sh
Restart=no
TimeoutStopSec=35
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/void-p2p-activation-permit-wall-v1

[Install]
WantedBy=multi-user.target
