# All three runtime gates remain disabled. Enabling this supervisor is a separate
# operator cutover after an exact policy, trust roots, node identity, runtime
# profile, and one-shot activation permit have been reviewed offline.
VOID_P2P_ACTIVATION_PERMIT_WALL_ENABLED=0
VOID_P2P_TRUST_POLICY_WALL_ENABLED=0
VOID_P2P_EDGE_WALL_ENABLED=0

# Offline/explicit mutation gates also remain disabled on a runtime node.
VOID_P2P_ACTIVATION_PERMIT_CONSUMPTION_ENABLED=0
VOID_P2P_ACTIVATION_PERMIT_OFFLINE_SIGNING=0
VOID_P2P_ACTIVATION_PERMIT_OFFLINE_ROOT_SET=0
VOID_P2P_ACTIVATION_PERMIT_PROFILE_GENERATION=0

VOID_P2P_ACTIVATION_PERMIT_NETWORK_ID=void-mainnet0-chain2050
VOID_P2P_ACTIVATION_PERMIT_ROOT_SET_FILE=/etc/void/p2p-node-bound-activation-permit-wall-v1/activation-permit-root-set-v1.json
VOID_P2P_ACTIVATION_PERMIT_ENVELOPE_FILE=/etc/void/p2p-node-bound-activation-permit-wall-v1/activation-permit-envelope-v1.json
VOID_P2P_ACTIVATION_RUNTIME_PROFILE_FILE=/etc/void/p2p-node-bound-activation-permit-wall-v1/runtime-profile-v1.json
VOID_P2P_ACTIVATION_PERMIT_STATE_DIR=/var/lib/void/p2p-node-bound-activation-permit-wall-v1
VOID_P2P_ACTIVATION_PERMIT_MAX_CLOCK_SKEW_MS=60000
VOID_P2P_ACTIVATION_PERMIT_MAX_LIFETIME_MS=86400000
VOID_P2P_ACTIVATION_PERMIT_MAX_DOCUMENT_BYTES=1048576

# Inputs to signed policy verification. At consumption, exact canonical copies
# are sealed into the permit generation and those sealed paths are passed to the
# signed-trust-policy supervisor, closing a source-file replacement window.
VOID_P2P_TRUST_POLICY_ROOT_SET_FILE=/etc/void/p2p-trust-policy-wall-v1/trust-root-set-v1.json
VOID_P2P_TRUST_POLICY_ENVELOPE_FILE=/etc/void/p2p-trust-policy-wall-v1/active-policy-envelope-v1.json
VOID_P2P_TRUST_POLICY_STATE_DIR=/var/lib/void/p2p-trust-policy-wall-v1
VOID_P2P_TRUST_POLICY_MAX_CLOCK_SKEW_MS=60000
VOID_P2P_TRUST_POLICY_MAX_LIFETIME_MS=2592000000
VOID_P2P_TRUST_POLICY_MAX_ALLOW_NODE_IDS=1024
VOID_P2P_TRUST_POLICY_MAX_DENY_NODE_IDS=1024
VOID_P2P_TRUST_POLICY_MAX_PEERS=256
VOID_P2P_TRUST_POLICY_MAX_DOCUMENT_BYTES=1048576

# These local values are used only to generate the canonical runtime profile.
# Once signed, the profile hash binds both state directories and every value
# below. Membership fields are not present here; they remain exclusively under
# the threshold-signed trust policy.
VOID_P2P_EDGE_WALL_MODE=both
VOID_P2P_EDGE_WALL_LISTEN_HOST=0.0.0.0
VOID_P2P_EDGE_WALL_LISTEN_PORT=4790
VOID_P2P_EDGE_WALL_BACKEND_HOST=127.0.0.1
VOID_P2P_EDGE_WALL_BACKEND_PORT=4700
VOID_P2P_EDGE_WALL_KEY_FILE=/home/void/.void/p2p-edge-wall-v1/edge-identity-ed25519.key.pem
VOID_P2P_EDGE_WALL_CERT_FILE=/home/void/.void/p2p-edge-wall-v1/edge-identity-ed25519.cert.pem
VOID_P2P_EDGE_WALL_STATUS_HOST=127.0.0.1
VOID_P2P_EDGE_WALL_STATUS_PORT=4190
VOID_P2P_EDGE_WALL_AUDIT_LOG=/var/lib/void/p2p-edge-wall-v1/audit.ndjson
VOID_P2P_EDGE_WALL_HANDSHAKE_TIMEOUT_MS=10000
VOID_P2P_EDGE_WALL_MAX_CLOCK_SKEW_MS=60000
VOID_P2P_EDGE_WALL_IDLE_TIMEOUT_MS=120000
VOID_P2P_EDGE_WALL_BACKEND_CONNECT_TIMEOUT_MS=5000
VOID_P2P_EDGE_WALL_MAX_CONNECTIONS=128
VOID_P2P_EDGE_WALL_MAX_CONNECTIONS_PER_IP=8
VOID_P2P_EDGE_WALL_MAX_PENDING_HANDSHAKES=32
VOID_P2P_EDGE_WALL_MAX_AUTH_LINE_BYTES=16384
VOID_P2P_EDGE_WALL_QUARANTINE_THRESHOLD=3
VOID_P2P_EDGE_WALL_QUARANTINE_BASE_MS=30000
VOID_P2P_EDGE_WALL_QUARANTINE_MAX_MS=3600000
VOID_P2P_EDGE_WALL_RECONNECT_MIN_MS=1000
VOID_P2P_EDGE_WALL_RECONNECT_MAX_MS=30000
