# VOID P2P Live Activation Lease Wall v1
# Copy deliberately. All four independent runtime gates are disabled by default.
VOID_P2P_LIVE_ACTIVATION_LEASE_WALL_ENABLED=0
VOID_P2P_ACTIVATION_PERMIT_WALL_ENABLED=0
VOID_P2P_TRUST_POLICY_WALL_ENABLED=0
VOID_P2P_EDGE_WALL_ENABLED=0

# Exact public trust-policy inputs approved offline.
VOID_P2P_TRUST_POLICY_ROOT_SET_FILE=/etc/void/p2p-trust-roots-v1.json
VOID_P2P_TRUST_POLICY_ENVELOPE_FILE=/etc/void/p2p-policy-envelope-v1.json
VOID_P2P_TRUST_POLICY_MAX_CLOCK_SKEW_MS=60000
VOID_P2P_TRUST_POLICY_MAX_LIFETIME_MS=2592000000
VOID_P2P_TRUST_POLICY_MAX_ALLOW_NODE_IDS=1024
VOID_P2P_TRUST_POLICY_MAX_DENY_NODE_IDS=1024
VOID_P2P_TRUST_POLICY_MAX_PEERS=256
VOID_P2P_TRUST_POLICY_MAX_DOCUMENT_BYTES=1048576

# Exact node-bound activation inputs approved offline.
VOID_P2P_ACTIVATION_PERMIT_NETWORK_ID=void-mainnet0-chain2050
VOID_P2P_ACTIVATION_RUNTIME_PROFILE_FILE=/etc/void/p2p-activation-runtime-profile-v1.json
VOID_P2P_ACTIVATION_PERMIT_ROOT_SET_FILE=/etc/void/p2p-activation-permit-roots-v1.json
VOID_P2P_ACTIVATION_PERMIT_ENVELOPE_FILE=/etc/void/p2p-activation-permit-envelope-v1.json
VOID_P2P_ACTIVATION_PERMIT_STATE_DIR=/var/lib/void-p2p-activation-permit-wall-v1
VOID_P2P_ACTIVATION_PERMIT_MAX_CLOCK_SKEW_MS=60000
VOID_P2P_ACTIVATION_PERMIT_MAX_LIFETIME_MS=86400000
VOID_P2P_ACTIVATION_PERMIT_MAX_DOCUMENT_BYTES=1048576

# Continuous supervision. A local revoke file at STATE_DIR/revoke holds the wall.
VOID_P2P_LIVE_ACTIVATION_LEASE_SHUTDOWN_LEAD_MS=300000
VOID_P2P_LIVE_ACTIVATION_LEASE_POLL_MS=5000
VOID_P2P_LIVE_ACTIVATION_LEASE_CHILD_STOP_TIMEOUT_MS=15000
VOID_P2P_LIVE_ACTIVATION_LEASE_AUDIT_LOG=/var/lib/void-p2p-activation-permit-wall-v1/live-activation-lease-audit-v1.ndjson
VOID_P2P_LIVE_ACTIVATION_LEASE_AUDIT_MAX_BYTES=67108864
VOID_P2P_LIVE_ACTIVATION_LEASE_STATUS_HOST=127.0.0.1
VOID_P2P_LIVE_ACTIVATION_LEASE_STATUS_PORT=4192

# Permissionless admission remains forced off by code and signed policy.
VOID_P2P_EDGE_WALL_PERMISSIONLESS=0
