# VOID_PRIVATE_CHAIN2050_PRODUCTION_SELECTOR_DEPLOYMENT_V1
# SOURCE-ONLY TEMPLATE. DO NOT INSTALL DIRECTLY.
# P0-C3 must replace __SEALED_NODE_BIN__ with an absolute, SHA-256-pinned
# operator Node binary and prove this exact unit against the sealed deployment
# before any P0-D service or checkpoint mutation. Anvil is already bound below
# to the staged absolute path and reviewed SHA-256; the launcher revalidates both.
[Unit]
Description=VOID private Chain-2050 RPC — selector-driven durable state v1
After=network.target
Before=void-wc-relayer.service void-workcredits-devnet-http.service
ConditionPathExists=/home/zoso/.local/share/void-private-chain2050-rpc-v1/deployments/selector-37371-main-1b3429b9-v1/ops/mainnet0/mainnet0-start-8545-selected-durable-state.sh
