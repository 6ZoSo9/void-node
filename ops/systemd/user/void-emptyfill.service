[Unit]
Description=VOID EmptyFill (inject a single NOOP only if mempool==0)
After=default.target

[Service]
Type=oneshot
Environment=HTTP_PORT=4100
Environment=TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
ExecStart=/bin/bash -lc '~/.local/bin/void-emptyfill-worker.sh || :'
SuccessExitStatus=0 1 2
