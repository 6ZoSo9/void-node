[Unit]
Description=Force-enable VOID proposer auto loop via HTTP
After=void-node.service
Wants=void-node.service
PartOf=void-node.service

[Service]
Type=oneshot
Environment=HTTP_PORT=4100
Environment=PROPOSER_TICK_MS=2000
ExecStart=/bin/bash -lc 'set -euo pipefail; for i in {1..60}; do if curl -fsS "http://127.0.0.1:${HTTP_PORT}/metrics/void/proposer.v3b.prom" >/dev/null 2>&1 || curl -fsS "http://127.0.0.1:${HTTP_PORT}/proposer/auto/status2" >/dev/null 2>&1; then curl -fsS -X POST "http://127.0.0.1:${HTTP_PORT}/proposer/auto/start?ms=${PROPOSER_TICK_MS}" >/dev/null && exit 0; fi; sleep 1; done; exit 0'
RemainAfterExit=yes

[Install]
WantedBy=default.target
