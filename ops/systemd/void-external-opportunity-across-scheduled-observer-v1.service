[Unit]
Description=VOID Across scheduled paper-opportunity observer V1
Documentation=https://github.com/6ZoSo9/void-node
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/credstore.encrypted/void-across-api-key

[Service]
Type=oneshot
User=zoso
Group=zoso
UMask=0077
StateDirectory=void-external-opportunity-across-scheduled-observer-v1
StateDirectoryMode=0700
LoadCredentialEncrypted=void-across-api-key:/etc/credstore.encrypted/void-across-api-key
Environment=VOID_ACROSS_AMOUNT=100000000
Environment=VOID_ACROSS_INPUT_TOKEN=0xaf88d065e77c8cc2239327c5edb3a432268e5831
Environment=VOID_ACROSS_OUTPUT_TOKEN=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
Environment=VOID_ACROSS_ORIGIN_CHAIN_ID=42161
Environment=VOID_ACROSS_DESTINATION_CHAIN_ID=8453
Environment=VOID_ACROSS_DEPOSITOR=0x0d66fCDf95d38f7Db6B4206BF183f34cD816C2AA
Environment=VOID_ACROSS_INTEGRATOR_ID=0x022d
Environment=VOID_ACROSS_APP_FEE=0.01
Environment=VOID_ACROSS_APP_FEE_RECIPIENT=0x0d66fCDf95d38f7Db6B4206BF183f34cD816C2AA
Environment=VOID_ACROSS_CAPITAL_AT_RISK_USD=100
Environment=VOID_ACROSS_CAPITAL_LOCK_SECONDS=3600
Environment=VOID_ACROSS_ANNUAL_CAPITAL_COST_BPS=800
Environment=VOID_ACROSS_RISK_HAIRCUT_BPS=25
Environment=VOID_ACROSS_SAFETY_BUFFER_USD=0.10
Environment=VOID_ACROSS_TIMEOUT_MS=10000
ExecStart=/usr/bin/node /opt/void-external-opportunity-across-scheduled-observer-v1/current/dist/ops/main/run_external_opportunity_across_scheduled_observer_v1.js
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=void-across-scheduled-observer-v1

[Install]
WantedBy=multi-user.target
