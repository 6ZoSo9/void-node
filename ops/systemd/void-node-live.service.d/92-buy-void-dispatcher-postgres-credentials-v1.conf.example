# VOID Buy VOID dispatcher PostgreSQL credential binding v1
#
# Source-only example. Installing or activating this file is a separate
# operator action. This example does not enable any Buy VOID runtime or apply
# authority and does not contain credential contents.
#
# The source files referenced below must remain outside the repository.
# Replace only the /ABSOLUTE/OPERATOR/PRIVATE/PATH placeholders during a
# separately reviewed host installation.
#
[Service]
LoadCredential=buy-void-dispatcher-postgres-password-v1:/ABSOLUTE/OPERATOR/PRIVATE/PATH/buy-void-dispatcher-postgres-password-v1
LoadCredential=buy-void-dispatcher-postgres-ca-v1:/ABSOLUTE/OPERATOR/PRIVATE/PATH/buy-void-dispatcher-postgres-ca-v1.pem
