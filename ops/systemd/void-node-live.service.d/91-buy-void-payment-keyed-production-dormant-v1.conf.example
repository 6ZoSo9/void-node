# VOID Buy VOID payment-keyed dormant production policy v1
#
# Source-only example. This file configures the payment-keyed production
# candidate while keeping both runtime and apply authority disabled.
#
# IMPORTANT:
# - Do not set CREDENTIALS_DIRECTORY here. systemd provides it dynamically
#   when the existing LoadCredential= binding is materialized for the service.
# - Do not add or change LoadCredential= here.
# - This file does not enable the parent Buy VOID runtime.
# - Runtime/apply remain explicitly disabled.
# - The fixed history carrier root is an accepted dormant snapshot pin only.
#   Live carrier-root custody/rotation remains a separate gate before enablement.
#
[Service]
Environment=VOID_BUY_VOID_PAYMENT_KEYED_FULL_RUNTIME_ENABLED=0
Environment=VOID_BUY_VOID_PAYMENT_KEYED_FULL_RUNTIME_APPLY_ENABLED=0

Environment=VOID_BUY_VOID_RUNTIME_DIR=/home/zoso/dev/void-node/data_a/buy_void_v1/runtime-integration-v1
Environment=VOID_BUY_VOID_HISTORY_CARRIER_ROOT_SHA256=32649ce8d7edf089d4078d97fd72832d0b44da4736b5d58cdf3cde969a33ab1a

Environment=VOID_BUY_VOID_PAYMENT_KEYED_CHAIN2050_RPC_URL=http://127.0.0.1:8545/
Environment=VOID_BUY_VOID_PAYMENT_KEYED_FULFILLMENT_CONTRACT_ADDRESS=0xa40a43adfd174f88309173cb3daa6e09c10154a7

Environment=VOID_BUY_VOID_PAYMENT_KEYED_GAS_LIMIT_MULTIPLIER_BPS=15000
Environment=VOID_BUY_VOID_PAYMENT_KEYED_MAX_GAS_LIMIT=320000
Environment=VOID_BUY_VOID_PAYMENT_KEYED_FEE_MULTIPLIER_BPS=20000
Environment=VOID_BUY_VOID_PAYMENT_KEYED_MAX_FEE_PER_GAS_WEI=3000000000
Environment=VOID_BUY_VOID_PAYMENT_KEYED_MAX_PRIORITY_FEE_PER_GAS_WEI=1000000000
Environment=VOID_BUY_VOID_PAYMENT_KEYED_RPC_TIMEOUT_MS=5000
Environment=VOID_BUY_VOID_PAYMENT_KEYED_RPC_MAX_RESPONSE_BYTES=65536

Environment=VOID_BUY_VOID_DELIVERY_TOKEN_ADDRESS=0x470075b85352eb86f7d089fb9ba88945f12aad94
Environment=VOID_BUY_VOID_DELIVERY_MIN_CONFIRMATIONS=3
Environment=VOID_BUY_VOID_NATIVE_DELIVERY_WALLET_ADDRESS=0xc884f631c3881b8b672bfcbf019c856146cd7f73

Environment=VOID_BUY_VOID_INVENTORY_POOL_ID=buy-void-presale-v1
Environment=VOID_BUY_VOID_CRASH_CONSISTENT_SAGA_INVENTORY_POLICY_VERSION=presale-v1
Environment=VOID_BUY_VOID_CRASH_CONSISTENT_SAGA_POOL_CAPACITY_VOID_UNITS=10000000000000
Environment=VOID_BUY_VOID_CRASH_CONSISTENT_SAGA_MAX_RESERVATION_VOID_UNITS=10000000000000
Environment=VOID_BUY_VOID_CRASH_CONSISTENT_SAGA_RATE_VOID_UNITS_NUMERATOR=2
Environment=VOID_BUY_VOID_CRASH_CONSISTENT_SAGA_RATE_VOID_UNITS_DENOMINATOR=1

Environment=VOID_BUY_VOID_ERC20_CREDENTIAL_BINDING_EVIDENCE_ID=20b5201b7d0516b3a4eb538fa4ec8fc1d1c68d5d1158740a11992025a2451495
