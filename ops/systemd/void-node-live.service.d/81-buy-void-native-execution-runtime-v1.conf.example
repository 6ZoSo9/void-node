# Example only. Do not install without replacing every operator placeholder.
#
# This drop-in leaves the signer/broadcaster injector, one-request native
# execution runtime, and Chain-2050 durability checkpoint runtime disabled.
#
# Production dependency injection fails closed unless the Chain-2050 durability
# gate is enabled. The gate durably claims one active mutation before a broadcast
# call and blocks later broadcasts until confirmed state is sealed in a finalized
# private Chain-2050 checkpoint (or a definitive no-broadcast result resolves the
# debt).
#
# The Buy VOID journal root, durability root, and private checkpoint root are
# deliberately separate server-controlled paths. The credential source must stay
# outside the repository and contain only the dedicated balance-capped Buy VOID
# fulfillment wallet private key.
[Service]
LoadCredential=buy-void-native-fulfillment-wallet-v1:/ABSOLUTE/OPERATOR/PRIVATE/PATH/buy-void-native-fulfillment-wallet-v1.key

Environment=VOID_BUY_VOID_NATIVE_DELIVERY_DEPENDENCY_INJECTOR_ENABLED=0
Environment=VOID_BUY_VOID_NATIVE_EXECUTION_RUNTIME_ENABLED=0
Environment=VOID_BUY_VOID_CHAIN2050_DURABILITY_GATE_ENABLED=0
Environment=VOID_BUY_VOID_CHAIN2050_DURABILITY_RUNTIME_ENABLED=0

Environment=VOID_BUY_VOID_RUNTIME_DIR=/ABSOLUTE/OPERATOR/PRIVATE/PATH/buy-void-runtime-integration-v1
Environment=VOID_BUY_VOID_CHAIN2050_DURABILITY_ROOT=/ABSOLUTE/OPERATOR/PRIVATE/PATH/buy-void-chain2050-durability-v1
Environment=VOID_PRIVATE_CHAIN2050_CHECKPOINT_ROOT=/ABSOLUTE/OPERATOR/PRIVATE/PATH/private-chain2050-checkpoints-v1

Environment=VOID_BUY_VOID_INVENTORY_POOL_ID=void-presale-mainnet0-v1
Environment=VOID_BUY_VOID_NATIVE_DELIVERY_ASSET_MODE=native_void
Environment=VOID_BUY_VOID_NATIVE_DELIVERY_CHAIN_ID=2050
Environment=VOID_BUY_VOID_NATIVE_DELIVERY_WALLET_ADDRESS=REPLACE_WITH_DEDICATED_BALANCE_CAPPED_WALLET
Environment=VOID_BUY_VOID_NATIVE_DELIVERY_MAX_AMOUNT_UNITS=REPLACE_WITH_BOUNDED_CANARY_LIMIT
Environment=VOID_BUY_VOID_NATIVE_EXECUTION_GAS_LIMIT=21000
Environment=VOID_BUY_VOID_NATIVE_DELIVERY_MAX_GAS_LIMIT=21000
Environment=VOID_BUY_VOID_NATIVE_DELIVERY_MAX_FEE_PER_GAS_WEI=REPLACE_WITH_BOUNDED_FEE_CAP
Environment=VOID_BUY_VOID_NATIVE_DELIVERY_MAX_PRIORITY_FEE_PER_GAS_WEI=REPLACE_WITH_BOUNDED_PRIORITY_FEE
Environment=VOID_BUY_VOID_NATIVE_EXECUTION_FEE_MULTIPLIER_BPS=12000
Environment=VOID_BUY_VOID_NATIVE_CHAIN2050_RPC_URL=http://127.0.0.1:8545/
