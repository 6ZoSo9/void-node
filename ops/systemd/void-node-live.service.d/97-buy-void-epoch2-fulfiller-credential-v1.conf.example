# Source-only example for the distinct Epoch-2 Buy VOID fulfiller credential.
# This file does NOT enable the Buy VOID runtime, payment acceptance, signing
# routes, presale activation, WC/VOID market activation, or any transaction.
#
# Replace only the absolute operator-private source path during a separately
# reviewed Precision host installation. Never place the private key in Git.
[Service]
LoadCredential=buy-void-epoch2-fulfiller-v1:/ABSOLUTE/OPERATOR/PRIVATE/PATH/buy-void-epoch2-fulfiller-v1.key
