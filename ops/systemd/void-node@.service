[Unit]
Description=void-node follower instance %i
After=network.target

[Service]
WorkingDirectory=%h/dev/void-node
ExecStart=/usr/bin/npm run start
Environment=DATA_DIR=data_b
Environment=HTTP_PORT=4101
Environment=P2P_PORT=4701
Environment=BOOTSTRAP_ADDRS=127.0.0.1:4700
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
