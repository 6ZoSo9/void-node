groups:
- name: void-proposer
  interval: 15s
  rules:
  - alert: VoidProposerDisabled
    expr: void:proposer_auto_enabled:last == 0
    for: 2m
    labels: { severity: warning, system: void }
    annotations:
      summary: "Proposer auto disabled"
      description: "Auto proposer is disabled for >2m on {{ $labels.instance }}"

  - alert: VoidProposerStale
    expr: void:proposer_exporter_age_ms:last > 60000
    for: 2m
    labels: { severity: critical, system: void }
    annotations:
      summary: "Proposer exporter stale"
      description: "Exporter TS is stale (>60s) for >2m on {{ $labels.instance }}"

  - alert: VoidProposerTickNaN
    expr: bool_on() (void:proposer_auto_enabled:last == 1)
          and on() (void:proposer_auto_ms:last != void:proposer_auto_ms:last)
    for: 2m
    labels: { severity: warning, system: void }
    annotations:
      summary: "Proposer tick interval NaN"
      description: "Auto is enabled but ms is NaN for >2m on {{ $labels.instance }}"
