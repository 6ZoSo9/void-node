{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voidchain.org/schemas/mainnet0-historical-cartography-acceptance-v1.schema.json",
  "title": "VOID Mainnet-0 Historical Cartography Acceptance V1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "marker",
    "version",
    "network",
    "chain_id",
    "status",
    "scan",
    "canonical_prefix_authority",
    "immutable_snapshot",
    "classification_semantics",
    "acceptance_contract",
    "acceptance_id"
  ],
  "properties": {
    "schema": { "const": "void_mainnet0_historical_cartography_acceptance_v1" },
    "marker": { "const": "VOID_MAINNET0_HISTORICAL_CARTOGRAPHY_ACCEPTANCE_V1_2" },
    "version": { "const": "v1.2" },
    "network": { "const": "VOID Mainnet-0" },
    "chain_id": { "const": 2050 },
    "status": { "const": "complete" },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "scanner_version",
        "source_id",
        "frozen_head",
        "historical_blocks_scanned",
        "complete_scan_digest",
        "class_counts"
      ],
      "properties": {
        "manifest_id": { "type": "string", "pattern": "^voidm0map1_[0-9a-f]{64}$" },
        "scanner_version": { "const": "v1.1" },
        "source_id": { "type": "string", "pattern": "^voidm0src1_[0-9a-f]{64}$" },
        "frozen_head": { "type": "integer", "minimum": 0 },
        "historical_blocks_scanned": { "type": "integer", "minimum": 1 },
        "complete_scan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "class_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "canonical_prefix_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_authority_id",
        "authority_basis",
        "frozen_head",
        "block_count",
        "segment_count",
        "total_prefix_bytes",
        "prefix_root",
        "genesis_raw_sha256",
        "frozen_raw_sha256",
        "descriptors",
        "independent_materializations",
        "independent_witness_repeat_passes",
        "exact_byte_prefix_match"
      ],
      "properties": {
        "source_authority_id": { "type": "string", "pattern": "^voidm0auth1_[0-9a-f]{64}$" },
        "authority_basis": { "const": "independent_materialization_exact_byte_prefix_match" },
        "frozen_head": { "type": "integer", "minimum": 0 },
        "block_count": { "type": "integer", "minimum": 1 },
        "segment_count": { "type": "integer", "minimum": 1 },
        "total_prefix_bytes": { "type": "integer", "minimum": 1 },
        "prefix_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "genesis_raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "frozen_raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "descriptors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segment", "from", "to", "prefix_bytes", "prefix_sha256"],
            "properties": {
              "segment": { "type": "string", "pattern": "^[0-9]{8}$" },
              "from": { "type": "integer", "minimum": 0 },
              "to": { "type": "integer", "minimum": 0 },
              "prefix_bytes": { "type": "integer", "minimum": 1 },
              "prefix_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "independent_materializations": { "const": 2 },
        "independent_witness_repeat_passes": { "const": 2 },
        "exact_byte_prefix_match": { "const": true }
      }
    },
    "immutable_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "checkpoint_descriptor_sha256",
        "checkpoint_source_id",
        "checkpoint_prefix_root",
        "immutable_rescan_manifest_id",
        "immutable_rescan_complete_scan_digest"
      ],
      "properties": {
        "kind": { "const": "blocks_only_checkpoint_v1" },
        "checkpoint_descriptor_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "checkpoint_source_id": { "type": "string", "pattern": "^voidm0src1_[0-9a-f]{64}$" },
        "checkpoint_prefix_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "immutable_rescan_manifest_id": { "type": "string", "pattern": "^voidm0map1_[0-9a-f]{64}$" },
        "immutable_rescan_complete_scan_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "classification_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "algorithm", "inputs", "root"],
      "properties": {
        "schema": { "const": "void_mainnet0_classification_semantics_v1" },
        "algorithm": { "const": "sha256_stable_json_file_digest_set_v1" },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "acceptance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_prefix_independently_witnessed",
        "immutable_snapshot_rescan_equal",
        "classification_semantics_content_bound",
        "numeric_count_conservation_revalidated",
        "append_authority",
        "validator_authority",
        "runtime_authority",
        "canonical_bytes_modified",
        "modern_validator_modified"
      ],
      "properties": {
        "canonical_prefix_independently_witnessed": { "const": true },
        "immutable_snapshot_rescan_equal": { "const": true },
        "classification_semantics_content_bound": { "const": true },
        "numeric_count_conservation_revalidated": { "const": true },
        "append_authority": { "const": false },
        "validator_authority": { "const": false },
        "runtime_authority": { "const": false },
        "canonical_bytes_modified": { "const": 0 },
        "modern_validator_modified": { "const": false }
      }
    },
    "acceptance_id": { "type": "string", "pattern": "^voidm0accept1_[0-9a-f]{64}$" }
  }
}
