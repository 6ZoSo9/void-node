  "purpose": "Public-safe handoff packet for an outside node operator to read status, follow quickstart, use bootstrap/connect routes, and return a receipt template.",
  "recipient_steps": [
    {
      "order": 1,
      "purpose": "Confirm the public operator lane currently reports green before attempting a node connection.",
      "route": "/public-node/operator-status-rollup-v1",
      "title": "Open the operator status rollup"
    },
    {
      "order": 2,
      "purpose": "Follow the human operator sequence before sharing any public-safe evidence.",
      "route": "/public-node/operator-quickstart-v1",
      "title": "Read the operator quickstart"
    },
    {
      "order": 3,
      "purpose": "Read network identity and chain information.",
      "route": "/__void/public-bootstrap.json",
      "title": "Fetch bootstrap metadata"
    },
    {
      "order": 4,
      "purpose": "Read public bootstrap peer hints only.",
      "route": "/bootstrap/peers.json",
      "title": "Fetch bootstrap peers"
    },
    {
      "order": 5,
      "purpose": "Manually connect a node operator to the advertised local/public bootstrap lane.",
      "route": "/public-node/connect",
      "title": "Use the connect pack"
    },
    {
      "order": 6,
      "purpose": "Return public-safe connection evidence without keys, wallet data, money movement, or validator claims.",
      "route": "/public-node/connect/receipt-template-v1",
      "title": "Fill the receipt template"
    }
  ],
