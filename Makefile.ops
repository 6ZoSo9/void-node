pillars-health-export:
	@echo "[pillars-export] repo=$(PWD)"
	@sudo PROM_URL=http://127.0.0.1:9090 \
	  OUT=/var/lib/node_exporter/textfile_collector/void_pillars.prom \
	  ./ops/void-pillars-health-exporter.sh
	@sudo chmod 644 /var/lib/node_exporter/textfile_collector/void_pillars.prom

