.PHONY: ops-kickbrake-install ops-kickbrake-uninstall

ops-kickbrake-install:
	@sudo install -m 0755 ops/scripts/void-proposer-kick-if-stalled.sh /usr/local/bin/void-proposer-kick-if-stalled.sh
	@sudo install -m 0755 ops/scripts/void-proposer-brake-if-unhealthy.sh /usr/local/bin/void-proposer-brake-if-unhealthy.sh
	@sudo install -m 0644 ops/systemd/void-proposer-kick.service /etc/systemd/system/void-proposer-kick.service
	@sudo install -m 0644 ops/systemd/void-proposer-kick.timer   /etc/systemd/system/void-proposer-kick.timer
	@sudo install -m 0644 ops/systemd/void-proposer-brake.service /etc/systemd/system/void-proposer-brake.service
	@sudo install -m 0644 ops/systemd/void-proposer-brake.timer   /etc/systemd/system/void-proposer-brake.timer
	@sudo install -m 0644 ops/tmpfiles/voidlocks.conf /etc/tmpfiles.d/voidlocks.conf
	@sudo systemd-tmpfiles --create /etc/tmpfiles.d/voidlocks.conf
	@sudo systemctl daemon-reload
	@sudo systemctl enable --now void-proposer-kick.timer void-proposer-brake.timer
	@echo "[ok] kick/brake timers installed & running"

ops-kickbrake-uninstall:
	@sudo systemctl disable --now void-proposer-kick.timer void-proposer-brake.timer || true
	@sudo rm -f /etc/systemd/system/void-proposer-kick.{service,timer} /etc/systemd/system/void-proposer-brake.{service,timer}
	@sudo rm -f /usr/local/bin/void-proposer-kick-if-stalled.sh /usr/local/bin/void-proposer-brake-if-unhealthy.sh
	@sudo rm -f /etc/tmpfiles.d/voidlocks.conf
	@sudo systemctl daemon-reload
	@echo "[ok] kick/brake timers removed"

ops-node-user-units-uninstall:
	@systemctl --user disable --now void-node@safe-4102.service 2>/dev/null || true
	@systemctl --user disable --now void-node@bootstrap-1.service 2>/dev/null || true
	@systemctl --user disable --now void-node.service 2>/dev/null || true
	@echo "[ok] user units disabled; files still on disk"

ops-node-user-units-status:
	@systemctl --user status --no-pager void-node.service           2>/dev/null | sed -n "1,60p" || true
	@systemctl --user status --no-pager void-node@bootstrap-1.service 2>/dev/null | sed -n "1,60p" || true
	@systemctl --user status --no-pager void-node@safe-4102.service   2>/dev/null | sed -n "1,60p" || true

ops-node-user-units-backup:
	@mkdir -p ops/backups
	@tar -C ~/.config/systemd/user -czf ops/backups/user-units-$(shell date +%Y%m%d-%H%M%S).tgz \
		void-node.service void-node@.service \
		void-node.service.d void-node@.service.d \
		void-node@safe-4102.service.d 2>/dev/null || true
ops-node-user-units-install:
	@mkdir -p ~/.config/systemd/user
	@rsync -av ops/systemd-user/units/ ~/.config/systemd/user/ || true
	@rsync -av ops/systemd-user/dropins/ ~/.config/systemd/user/ || true
	@systemctl --user daemon-reload
	# Enable only if the unit actually exists:
	@test -f ~/.config/systemd/user/void-node.service && systemctl --user enable --now void-node.service || true
	# Enable follower if desired and template exists:
	@test -f ~/.config/systemd/user/void-node@.service && systemctl --user enable --now void-node@bootstrap-1.service || true
	@echo "[ok] user units installed & enabled (where present)"

ops-node-user-units-uninstall:
	@systemctl --user disable --now void-node@bootstrap-1.service 2>/dev/null || true
	@systemctl --user disable --now void-node.service 2>/dev/null || true
	@echo "[ok] user units disabled; files still on disk"

ops-node-user-units-status:
	@systemctl --user status --no-pager void-node.service 2>/dev/null | sed -n 1,60p || true
	@systemctl --user status --no-pager void-node@bootstrap-1.service 2>/dev/null | sed -n 1,60p || true
	@systemctl --user status --no-pager void-node@safe-* 2>/dev/null | sed -n 1,40p || true

ops-node-user-units-backup:
	@mkdir -p ops/backups
	@tar -C ~/.config/systemd/user -czf ops/backups/user-units-$(shell date +%Y%m%d-%H%M%S).tgz \
		void-node.service void-node@.service \
		void-node.service.d void-node@.service.d \
		void-node@safe-4102.service.d 2>/dev/null || true

.PHONY: ops-node-user-units-install ops-node-user-units-uninstall ops-node-user-units-status ops-node-user-units-backup

ops-node-user-units-install:
	@mkdir -p ~/.config/systemd/user
	@rsync -av ops/systemd-user/units/ ~/.config/systemd/user/ || true
	@rsync -av ops/systemd-user/dropins/ ~/.config/systemd/user/ || true
	@systemctl --user daemon-reload
	@# Enable only if present
	@test -f ~/.config/systemd/user/void-node.service && systemctl --user enable --now void-node.service || true
	@test -f ~/.config/systemd/user/void-node@.service && systemctl --user enable --now void-node@bootstrap-1.service || true
	@echo "[ok] user units installed & enabled (where present)"

ops-node-user-units-uninstall:
	@systemctl --user disable --now void-node@bootstrap-1.service 2>/dev/null || true
	@systemctl --user disable --now void-node.service 2>/dev/null || true
	@echo "[ok] user units disabled; files remain on disk"

ops-node-user-units-status:
	@systemctl --user status --no-pager void-node.service 2>/dev/null | sed -n '1,60p' || true
	@systemctl --user status --no-pager void-node@bootstrap-1.service 2>/dev/null | sed -n '1,60p' || true
	@systemctl --user status --no-pager 'void-node@safe-*' 2>/dev/null | sed -n '1,40p' || true

ops-node-user-units-backup:
	@mkdir -p ops/backups
	@tar -C ~/.config/systemd/user -czf ops/backups/user-units-$(shell date +%Y%m%d-%H%M%S).tgz \
		void-node.service void-node@.service \
		void-node.service.d void-node@.service.d \
		void-node@safe-4102.service.d 2>/dev/null || true
devnet-ci-smoke:
	./ops/void-devnet-ci-smoke.sh

# Devnet AgentRegistry CI smoke (local-only)
devnet-agent-ci-smoke:
	./ops/void-devnet-agent-ci-smoke.sh
