.ONESHELL:
# Autogenerated ops include
.PHONY: prom-snap
prom-snap:
	./ops/prom-snap.sh
.PHONY: prom-prune
prom-prune:
	./ops/prom-prune.sh 12
PROPOSER ?= http://127.0.0.1:4100
FOLLOWER ?= http://127.0.0.1:4101

.PHONY: build up proposer follower seal follow-once tx lookup status receipts kidx-all kidx-block kidx-hash hello-now stop

build:
	 npm run build

up:
	 bash scripts/boot.sh up

proposer:
	 bash scripts/boot.sh proposer

follower:
	 bash scripts/boot.sh follower

seal:
	 bash scripts/boot.sh seal

follow-once:
	 bash scripts/boot.sh once

tx:
	 bash scripts/boot.sh tx

lookup:
	 bash scripts/boot.sh lookup

status:
	 curl -sS $(FOLLOWER)/sync/status | jq .

receipts:
	 bash scripts/boot.sh rcpt

kidx-all:
	 curl -sS -X POST $(FOLLOWER)/index/kidx/build | jq .

kidx-block:
	 test -n "$(BLOCK)" || (echo "usage: make kidx-block BLOCK=<number>"; exit 1)
	 curl -sS -X POST "$(FOLLOWER)/index/kidx/rebuild-shard?block=$(BLOCK)" | jq .

kidx-hash:
	 test -n "$(HASH)" || (echo "usage: make kidx-hash HASH=<64-hex>"; exit 1)
	 curl -sS -X POST "$(FOLLOWER)/index/kidx/rebuild-shard?hash=$(HASH)" | jq .

hello-now:
	 curl -sS $(PROPOSER)/p2p/hello-now | jq .
	 curl -sS $(FOLLOWER)/p2p/hello-now | jq .

stop:
	 bash scripts/boot.sh stop

PROM=http://127.0.0.1:9090

prom-ok:
	@until curl -sf $(PROM)/-/ready >/dev/null; do sleep 0.2; done && echo "[ok] ready"
	@curl -sS $(PROM)/api/v1/status/flags | jq '{time:.data["storage.tsdb.retention.time"], size:.data["storage.tsdb.retention.size"], lifecycle:.data["web.enable-lifecycle"]}'
	@curl -sS '$(PROM)/api/v1/targets?state=active' \
	  | jq '.data.activeTargets | length as $$n | {count:$$n, ok:[ .[]|select(.health=="up") ]|length, jobs:[ .[]|.labels.job ]}'
	@for j in prometheus node void-node void-follower-v4 void-scheduler; do \
	  printf "up{%s}=" $$j; \
	  curl -sS --get $(PROM)/api/v1/query --data-urlencode "query=up{job=\"$$j\"}" \
	    | jq -r '.data.result[0].value[1]'; \
	done

prom-reload:
	@curl -sS -X POST $(PROM)/-/reload && echo "reloaded"

prom-flags:
	@curl -sS $(PROM)/api/v1/status/flags \
	  | jq '{cfg:.data["config.file"], tsdb:.data["storage.tsdb.path"], time:.data["storage.tsdb.retention.time"], size:.data["storage.tsdb.retention.size"], lifecycle:.data["web.enable-lifecycle"]}'

prom-targets:
	@curl -sS '$(PROM)/api/v1/targets?state=active' \
	  | jq '.data.activeTargets | length as $$n | {count:$$n, targets:[ .[] | {job:.labels.job,url:.scrapeUrl,health:.health} ]}'

prom-backup:
	@sudo tar czf /root/prometheus-config-OK.$$(date +%F-%H%M).tgz /etc/prometheus /etc/systemd/system/prometheus.service.d && \
	echo "backup -> /root/prometheus-config-OK.$$(date +%F-%H%M).tgz"

.PHONY: prom-timer-install
prom-timer-install:
	./ops/systemd/install-root-timer.sh
.PHONY: prom-verify
prom-verify:
	sudo ./ops/prom-verify.sh && curl -fsS -X POST http://127.0.0.1:9090/-/reload && echo reloaded

# ---- friendly help and default goal ----
.PHONY: help
help:
	@echo "Void Ops Targets:"
	@echo "  prom-timer-install   – install/enable root snapshot timer"
	@echo "  prom-snap            – take a Prometheus snapshot now"
	@echo "  prom-prune           – prune snapshots (keeps last 12)"
	@echo "  prom-verify          – promtool verify + reload Prometheus"
	@echo "  prom-ok              – quick Prom ready/targets summary"
	@echo "  prom-reload          – POST /-/reload"
	@echo "  prom-flags           – show key Prom flags"
	@echo "  prom-targets         – list active targets"
	@echo "  prom-backup          – tar /etc/prometheus + unit override"

.DEFAULT_GOAL := help
.PHONY: prom-snap-age
prom-snap-age:
	sudo ./ops/prom-textfile-snap-age.sh
.PHONY: prom-poke
prom-poke:
	sudo systemctl start void-prom-snap-root.service
	sudo ./ops/prom-textfile-snap-age.sh
.PHONY: prom-age
prom-age:
	curl -fsS 127.0.0.1:9090/api/v1/query --data-urlencode 'query=void_ops_prom_snap_age_seconds' | jq -r '.data.result[]?.value[1]'
.PHONY: prom-age-min
prom-age-min:
	curl -fsS 127.0.0.1:9090/api/v1/query --data-urlencode 'query=void:prom_snap_age:minutes' | jq -r '.data.result[]?.value[1]'
	@echo "void_ops_prom_snap_age_seconds 0" | sudo tee /var/lib/node_exporter/textfile_collector/void_prom_snap.prom >/dev/null
	@curl -fsS 127.0.0.1:9100/metrics | grep -E 'void_ops_prom_snap_age_seconds|node_textfile_scrape_error|node_textfile_mtime_seconds' || true
	@echo "void_ops_prom_snap_age_seconds 0" | sudo tee /var/lib/node_exporter/textfile_collector/void_prom_snap.prom >/dev/null
	@curl -fsS 127.0.0.1:9100/metrics | grep -E 'void_ops_prom_snap_age_seconds|node_textfile_scrape_error|node_textfile_mtime_seconds' || true
.PHONY: prom-age-stale prom-age-fresh
prom-age-stale:
	@echo "void_ops_prom_snap_age_seconds 4000" | sudo tee /var/lib/node_exporter/textfile_collector/void_prom_snap.prom >/dev/null
	@curl -fsS 127.0.0.1:9100/metrics | grep -E 'void_ops_prom_snap_age_seconds|node_textfile_scrape_error|node_textfile_mtime_seconds' || true

prom-age-fresh:
	@echo "void_ops_prom_snap_age_seconds 0" | sudo tee /var/lib/node_exporter/textfile_collector/void_prom_snap.prom >/dev/null
	@curl -fsS 127.0.0.1:9100/metrics | grep -E 'void_ops_prom_snap_age_seconds|node_textfile_scrape_error|node_textfile_mtime_seconds' || true
.PHONY: prom-age-show prom-age-wait-3k prom-alerts
prom-age-show:
	@echo "Exporter:" && curl -fsS 127.0.0.1:9100/metrics | grep -E '^void_ops_prom_snap_age_seconds ' || true
	@echo "Prom:" && curl -fsS 127.0.0.1:9090/api/v1/query --data-urlencode 'query=void_ops_prom_snap_age_seconds' \
	  | jq -r '.data.result[]?.value[1] // "∅"'

# Wait until Prom sees >= 3000s (about 50m), useful for testing WARN/CRIT after their 5m for: windows
prom-age-wait-3k:
	@./ops/prom-age-wait.sh 3000

# Show active Prometheus alert states (those defined in /etc/prometheus/alerts/*.yml)
prom-alerts:
	@curl -fsS 127.0.0.1:9090/api/v1/alerts | jq -r '.data.alerts[] | "\(.labels.alertname) \(.state) \(.labels.severity) \(.annotations.summary // "")"'
.PHONY: prom-warn-wait prom-crit-wait
prom-warn-wait:
	@./ops/prom-alert-wait.sh VoidSnapshotStale

prom-crit-wait:
	@./ops/prom-alert-wait.sh VoidSnapshotVeryStale
.PHONY: prom-warn-wait-test prom-crit-wait-test
prom-warn-wait-test:
	@./ops/prom-alert-wait.sh VoidSnapshotStaleTEST
prom-crit-wait-test:
	@./ops/prom-alert-wait.sh VoidSnapshotVeryStaleTEST

prom-test-remove:
	@sudo rm -f /etc/prometheus/alerts/void-snapshot-age-TEST.yml || true

prom-test-reload:
	@curl -fsS -X POST 127.0.0.1:9090/-/reload >/dev/null && echo reloaded
.PHONY: prom-test-install
prom-test-install:
	@tmp="$$(mktemp)"; \
	printf '%s\n' \
'groups:' \
'- name: void-snapshot-age-TEST' \
'  interval: 5s' \
'  rules:' \
'  - alert: VoidSnapshotStaleTEST' \
'    expr: void_ops_prom_snap_age_seconds > 120' \
'    for: 30s' \
'    labels: {severity: warning, system: void}' \
'    annotations: {summary: "TEST WARN", description: "Age >2m (TEST)"}' \
'  - alert: VoidSnapshotVeryStaleTEST' \
'    expr: void_ops_prom_snap_age_seconds > 180' \
'    for: 30s' \
'    labels: {severity: critical, system: void}' \
'    annotations: {summary: "TEST CRIT", description: "Age >3m (TEST)"}' \
	> "$$tmp"; \
	sudo mv "$$tmp" /etc/prometheus/alerts/void-snapshot-age-TEST.yml; \
	sudo promtool check rules /etc/prometheus/alerts/void-snapshot-age-TEST.yml
.PHONY: prom-reload-safe
prom-reload-safe:
	@for i in 1 2 3 4 5; do \
	  if curl -fsS -X POST 127.0.0.1:9090/-/reload >/dev/null; then echo reloaded; exit 0; fi; \
	  echo "reload 500, retry $$i..." && sleep 1; \
	done; \
	echo "reload failed after retries" && exit 1

# Wait until Prom query >= THRESH (default 4000)
.PHONY: prom-wait-val
prom-wait-val:
	@THRESH=$${THRESH:-4000}; \
	URL="http://127.0.0.1:9090/api/v1/query"; \
	while :; do \
	  V="$$(curl -fsS --get "$$URL" --data-urlencode 'query=void_ops_prom_snap_age_seconds' \
	       | jq -r '.data.result[]?.value[1] // "NaN"')" ; \
	  printf "prom void_ops_prom_snap_age_seconds=%s (target>=%s)\n" "$$V" "$$THRESH"; \
	  awk "BEGIN{exit !($$V>=$$THRESH)}" && break; \
	  sleep 1; \
	done

# Wait until the named alert is ABSENT
.PHONY: prom-alert-clear
prom-alert-clear:
	@ALERT=$${ALERT:?usage: make prom-alert-clear ALERT=<Name>}; \
	URL="http://127.0.0.1:9090/api/v1/alerts"; \
	while :; do \
	  CNT="$$(curl -fsS "$$URL" | jq -r --arg A "$$ALERT" '[.data.alerts[]? | select(.labels.alertname==$A)] | length')" ; \
	  echo "$$ALERT active=$$CNT" ; \
	  [ "$$CNT" = "0" ] && break; \
	  sleep 2; \
	done

# Full end-to-end TEST cycle
.PHONY: prom-test-cycle
prom-test-cycle:
	@$(MAKE) prom-test-install
	@$(MAKE) prom-reload-safe
	@echo "interval=$$(curl -fsS 127.0.0.1:9090/api/v1/rules | jq -r '.data.groups[] | select(.name==\"void-snapshot-age-TEST\") | .interval')s"
	@$(MAKE) prom-age-stale
	@$(MAKE) prom-wait-val THRESH=3000
	@$(MAKE) prom-warn-wait-test
	@$(MAKE) prom-crit-wait-test
	@$(MAKE) prom-age-fresh
	@sleep 10
	@$(MAKE) prom-alert-clear ALERT=VoidSnapshotStaleTEST
	@$(MAKE) prom-alert-clear ALERT=VoidSnapshotVeryStaleTEST
	@$(MAKE) prom-test-remove
	@$(MAKE) prom-reload-safe
	@echo "TEST cycle complete"
