# Example only. Do not install from source-green evidence alone.
[Unit]
Description=VOID credential-request PROXY-v2 edge adapter v1
After=network.target void-ai-agent-public-gateway-v1.service
Wants=void-ai-agent-public-gateway-v1.service

[Service]
Type=simple
User=voidcrededge
Group=voidcrededge
WorkingDirectory=/opt/void-node
StateDirectory=void-agent-credential-request-proxy-v2-edge-v1
StateDirectoryMode=0700
UMask=0077
Environment=VOID_AGENT_CREDENTIAL_REQUEST_PROXY_V2_EDGE_PORT=9899
Environment=VOID_AGENT_CREDENTIAL_REQUEST_PROXY_V2_GATEWAY_UPSTREAM=http://127.0.0.1:4114
Environment=VOID_AGENT_CREDENTIAL_REQUEST_PROXY_V2_RATE_STATE_FILE=/var/lib/void-agent-credential-request-proxy-v2-edge-v1/rate-state-v1.json
Environment=VOID_AGENT_CREDENTIAL_REQUEST_PROXY_V2_RATE_WINDOW_MS=60000
Environment=VOID_AGENT_CREDENTIAL_REQUEST_PROXY_V2_MAX_REQUESTS_PER_SOURCE=30
ExecStart=/usr/bin/node /opt/void-node/ops/void-agent-credential-request-proxy-v2-edge-v1.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET
CapabilityBoundingSet=
AmbientCapabilities=
