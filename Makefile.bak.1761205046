.PHONY: dev proposer follower kill node_a node_b proposer_a follower_b

dev:
	@echo "Starting node (dev)…"
	npx tsx src/index.ts

proposer:
	@echo "Starting proposer (single)…"
	npx tsx src/index.ts --role=proposer

follower:
	@echo "Starting follower (single)…"
	npx tsx src/index.ts --role=follower

node_a:
	@echo "Starting node A (http 4100 / p2p 4700, data=data_a)…"
	mkdir -p data_a/segments/00000000
	HTTP_PORT=4100 P2P_PORT=4700 DATA_DIR=data_a KEY_FILE=data_a/.nodekey npx tsx src/index.ts

node_b:
	@echo "Starting node B (http 4101 / p2p 4701, data=data_b, bootstrap->A)…"
	mkdir -p data_b/segments/00000000
	HTTP_PORT=4101 P2P_PORT=4701 DATA_DIR=data_b KEY_FILE=data_b/.nodekey BOOTSTRAP=http://127.0.0.1:4100 npx tsx src/index.ts

proposer_a:
	@echo "Starting A as proposer…"
	mkdir -p data_a/segments/00000000
	HTTP_PORT=4100 P2P_PORT=4700 DATA_DIR=data_a KEY_FILE=data_a/.nodekey npx tsx src/index.ts --role=proposer

follower_b:
	@echo "Starting B as follower (bootstrap->A)…"
	mkdir -p data_b/segments/00000000
	HTTP_PORT=4101 P2P_PORT=4701 DATA_DIR=data_b KEY_FILE=data_b/.nodekey BOOTSTRAP=http://127.0.0.1:4100 npx tsx src/index.ts --role=follower

kill:
	@echo "Killing running node processes…"
	- pkill -f "tsx src/index.ts" || true

check_a:
	@npx tsx scripts/check_store.ts || true

check_b:
	@DATA_DIR=data_b npx tsx scripts/check_store.ts || true

export_a_0_999:
	@FROM=0 TO=999 OUT=export_0_999.ndjson DATA_DIR=data_a npx tsx scripts/export_range.ts

import_b_0_999:
	@IN=export_0_999.ndjson DATA_DIR=data_b npx tsx scripts/import_file.ts



follow_helper:
	@curl -sS -X POST "http://127.0.0.1:4100/follower/start?peer=http://127.0.0.1:4315&intervalMs=2000" | jq .

follow_once:
	@curl -sS -X POST "http://127.0.0.1:4100/follower/once?peer=http://127.0.0.1:4315" | jq .

status:
	@echo "helper health:"; curl -sS "http://127.0.0.1:4315/api/health" | jq .
	@echo "main   health:"; curl -sS "http://127.0.0.1:4100/health" | jq .
	@echo "helper 0..10 :" ; curl -sS "http://127.0.0.1:4315/blocks/range?from=0&to=10" | jq length
	@echo "main   0..10 :" ; curl -sS "http://127.0.0.1:4100/blocks/range?from=0&to=10" | jq length
verify:
	@curl -fsS -4 "http://127.0.0.1:4100/maintenance/verify" \
	| jq '{ok,code,timedOut,summary}'

repair_dry:
	@curl -fsS -4 -X POST "http://127.0.0.1:4100/maintenance/auto-repair?dryRun=1" \
	| jq '{ok,code,timedOut,repair:{stdout,stderr},verify:{ok: .verify.ok, summary: .verify.summary}}'

repair:
	@curl -fsS -4 -X POST "http://127.0.0.1:4100/maintenance/auto-repair" \
	| jq '{ok,code,timedOut,repair:{stdout,stderr},verify:{ok: .verify.ok, summary: .verify.summary}}'

status:
	@echo "helper health:"; curl -fsS -4 "http://127.0.0.1:4315/api/health" | jq .
	@echo "main   health:"; curl -fsS -4 "http://127.0.0.1:4100/health"         | jq .
	@echo "helper 0..10 :" ; curl -fsS -4 "http://127.0.0.1:4315/blocks/range?from=0&to=10" | jq length
	@echo "main   0..10 :" ; curl -fsS -4 "http://127.0.0.1:4100/blocks/range?from=0&to=10" | jq length
