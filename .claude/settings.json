{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "WebFetch",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(rm *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm update)",
      "Bash(npm update *)",
      "Edit(/docs/governance/**)",
      "Edit(/src/security/**)",
      "Edit(/src/chain/**)",
      "Edit(/src/economic/**)",
      "Edit(/src/index.ts)",
      "Edit(/src/node_core.ts)",
      "Edit(/contracts/**)",
      "Edit(/ops/**)",
      "Edit(/.github/workflows/**)"
    ],
    "deny": [
      "WebSearch",
      "mcp__*",
      "Agent",
      "Edit(/CLAUDE.md)",
      "Edit(/AGENTS.md)",
      "Edit(/.claude/**)",
      "Edit(/scripts/prove_merlin_claude_code_advisor_v1.mjs)",
      "Edit(/.github/workflows/void-merlin-claude-code-advisor-v1.yml)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.env)",
      "Read(**/.env*)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/**)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.password-store/**)",
      "Read(//media/**)",
      "Read(//mnt/**)",
      "Read(//run/media/**)",
      "Read(//dev/disk/**)",
      "Read(//dev/mapper/**)",
      "Read(//proc/**/environ)",
      "Read(//proc/**/cmdline)",
      "Read(//etc/shadow)",
      "Read(//root/**)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(su *)",
      "Bash(systemctl *)",
      "Bash(service *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(poweroff *)",
      "Bash(mount *)",
      "Bash(umount *)",
      "Bash(cryptsetup *)",
      "Bash(losetup *)",
      "Bash(modprobe *)",
      "Bash(tailscale *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(socat *)",
      "Bash(docker *)",
      "Bash(podman *)",
      "Bash(kubectl *)",
      "Bash(gh *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git clone *)",
      "Bash(git ls-remote *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git submodule *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote set-url *)",
      "Bash(npm install *)",
      "Bash(npm audit fix)",
      "Bash(npm audit fix *)",
      "Bash(npm publish *)",
      "Bash(pnpm install *)",
      "Bash(pnpm publish *)",
      "Bash(yarn install *)",
      "Bash(yarn publish *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(uv pip install *)",
      "Bash(cargo install *)",
      "Bash(go install *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(dnf *)",
      "Bash(yum *)",
      "Bash(pacman *)",
      "Bash(snap *)",
      "Bash(flatpak *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "denyRead": [
        "~/",
        "/media/**",
        "/mnt/**",
        "/run/media/**",
        "/dev/disk/**",
        "/dev/mapper/**",
        "/dev/sd*",
        "/dev/nvme*",
        "**/*.env",
        "**/.env*"
      ],
      "allowRead": [
        "."
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org"
      ],
      "allowUnixSockets": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false
    },
    "credentials": {
      "files": [
        {
          "path": "~/.claude",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.docker",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.local/share/keyrings",
          "mode": "deny"
        },
        {
          "path": "~/.password-store",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.pypirc",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "**/*.env",
          "mode": "deny"
        },
        {
          "path": "**/.env*",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "OPENROUTER_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GOOGLE_APPLICATION_CREDENTIALS",
          "mode": "deny"
        },
        {
          "name": "SSH_AUTH_SOCK",
          "mode": "deny"
        },
        {
          "name": "AGENT_TOKEN",
          "mode": "deny"
        },
        {
          "name": "VOID_AGENT_TOKEN",
          "mode": "deny"
        },
        {
          "name": "VOID_STEAM_WEB_API_KEY",
          "mode": "deny"
        }
      ]
    }
  }
}
