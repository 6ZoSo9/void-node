{
  "name": "void-node",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "DATA_DIR=data_a HTTP_PORT=4100 P2P_PORT=4700 NODE_PRIVKEY_PATH=$HOME/.secrets/nodeA.key tsx src/index.ts",
    "dev:follower": "DATA_DIR=data_b HTTP_PORT=4101 P2P_PORT=4701 NODE_PRIVKEY_PATH=$HOME/.secrets/nodeB.key tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint:braces": "node -e \"const fs=require(\"fs\");const s=fs.readFileSync(\"src/index.ts\",\"utf8\");let c=0,l=1;for(const ch of s){if(ch===\"\\n\")l++;if(ch===\"{\")c++;else if(ch===\"}\")c--;if(c<0){console.error(`extra } at line ${l}`);process.exit(1)}}if(c!==0){console.error(`brace imbalance ${c}`);process.exit(1)}\"",
    "build:loose": "tsc -p tsconfig.build.json || echo \"[loose build] TS errors ignored for CI\"",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "voidctl": "tsx src/voidctl/index.ts",
    "void:field-trial": "node tools/void-field-trial-v1.mjs",
    "datanet:demo": "node tools/datanet-demo-v1.mjs",
    "datanet:pull": "node tools/datanet-pull-v1.mjs",
    "void:field-report": "node tools/void-field-report-v1.mjs",
    "datanet:field-object:create": "node tools/datanet-field-object-create-v1.mjs",
    "datanet:field-object:pull": "node tools/datanet-field-object-pull-v1.mjs",
    "datanet:field-object:trial": "node tools/datanet-field-object-trial-v1.mjs",
    "datanet:field-object:mirror": "node tools/datanet-field-object-mirror-v1.mjs",
    "datanet:field-object:roundtrip": "node tools/datanet-field-object-roundtrip-v1.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "license": "SEE LICENSE IN LICENSE"
}
