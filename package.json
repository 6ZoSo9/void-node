{
  "name": "void-node",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "DATA_DIR=data_a HTTP_PORT=4100 P2P_PORT=4700 NODE_PRIVKEY_PATH=$HOME/.secrets/nodeA.key tsx src/index.ts",
    "dev:follower": "DATA_DIR=data_b HTTP_PORT=4101 P2P_PORT=4701 NODE_PRIVKEY_PATH=$HOME/.secrets/nodeB.key tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint:braces": "node -e \"const fs=require(\"fs\");const s=fs.readFileSync(\"src/index.ts\",\"utf8\");let c=0,l=1;for(const ch of s){if(ch===\"\\n\")l++;if(ch===\"{\")c++;else if(ch===\"}\")c--;if(c<0){console.error(`extra } at line ${l}`);process.exit(1)}}if(c!==0){console.error(`brace imbalance ${c}`);process.exit(1)}\"",
    "build:loose": "tsc -p tsconfig.build.json || echo \"[loose build] TS errors ignored for CI\"",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "voidctl": "tsx src/voidctl/index.ts",
    "void:field-trial": "node tools/void-field-trial-v1.mjs",
    "datanet:demo": "node tools/datanet-demo-v1.mjs",
    "datanet:pull": "node tools/datanet-pull-v1.mjs",
    "void:field-report": "node tools/void-field-report-v1.mjs",
    "datanet:field-object:create": "node tools/datanet-field-object-create-v1.mjs",
    "datanet:field-object:pull": "node tools/datanet-field-object-pull-v1.mjs",
    "datanet:field-object:trial": "node tools/datanet-field-object-trial-v1.mjs",
    "datanet:field-object:mirror": "node tools/datanet-field-object-mirror-v1.mjs",
    "datanet:field-object:roundtrip": "node tools/datanet-field-object-roundtrip-v1.mjs",
    "datanet:field-replication:run": "node tools/datanet-field-replication-runner-v1.mjs",
    "public-node:serve": "node tools/public-node-safe-serve-v1.mjs",
    "datanet:field-replication:safe-serve-smoke": "bash tools/check_datanet_field_replication_safe_serve_runbook_discovery_runtime_v1.sh",
    "datanet:field-replication:proof-bundle": "node tools/datanet-field-replication-proof-bundle-v1.mjs",
    "datanet:field-replication:proof-bundle:public-summary": "node tools/datanet-field-replication-proof-bundle-public-summary-v1.mjs",
    "datanet:field-replication:public-summary-smoke": "bash tools/check_datanet_field_replication_proof_bundle_public_summary_runtime_v1.sh",
    "datanet:field-replication:real-two-box-closeout-smoke": "bash tools/check_datanet_field_replication_real_two_box_bounded_public_summary_closeout_runtime_v1.sh",
    "participant:onboard": "node tools/void-public-earn-validator-onboarding-v1.mjs",
    "participant:onboard:proof": "node scripts/prove_public_earn_validator_onboarding_v1.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "license": "SEE LICENSE IN LICENSE"
}
