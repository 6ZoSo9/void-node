{
  "name": "void-node",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "cli": "tsx src/cli.ts",
    "make-tx": "tsx src/tx/make_tx.ts",
    "node:a": "HTTP_PORT=4101 P2P_PORT=4701 PUBLIC_HTTP_BASE=\"http://127.0.0.1:4101\" npx tsx src/index.ts",
    "node:b": "HTTP_PORT=4102 P2P_PORT=4702 PUBLIC_HTTP_BASE=\"http://127.0.0.1:4102\" BOOTSTRAP=127.0.0.1:4701 npx tsx src/index.ts",
    "kill": "pkill -f 'tsx src/index.ts' || true",
    "proposer": "tsx src/index.ts --role=proposer",
    "follower": "tsx src/index.ts --role=follower",
    "dev:a": "DATA_DIR=data_a tsx src/index.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "13.2.0",
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "7.0.4",
    "@libp2p/identify": "1.0.21",
    "@libp2p/tcp": "10.1.7",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "libp2p": "1.9.4"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@libp2p/identify": "1.0.21",
    "@chainsafe/libp2p-gossipsub": {
      "@libp2p/identify": "1.0.21"
    }
  }
}
