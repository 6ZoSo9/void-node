{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://void.network/schemas/public-release-channel-v1.schema.json",
  "title": "VOID Public Release Channel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["marker", "schema_version", "channel", "generated_at_utc", "repository", "release_tag", "release", "assets", "verification", "policy"],
  "properties": {
    "marker": {"const": "VOID_PUBLIC_RELEASE_CHANNEL_V1"},
    "schema_version": {"const": 1},
    "channel": {"enum": ["stable", "candidate"]},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "release_tag": {"type": "string", "pattern": "^release-v[0-9A-Za-z][0-9A-Za-z._+-]{0,127}$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "git_commit", "platform", "minimum_node_major", "archive", "archive_sha256", "archive_bytes"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "platform": {"const": "linux-x64"},
        "minimum_node_major": {"const": 22},
        "archive": {"type": "string", "minLength": 1},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "assets": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checksum_algorithm", "github_attestation_required", "attestation_repository", "attestation_subjects"],
      "properties": {
        "checksum_algorithm": {"const": "sha256"},
        "github_attestation_required": {"const": true},
        "attestation_repository": {"type": "string", "minLength": 3},
        "attestation_subjects": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downgrade_allowed_by_default", "service_started_implicitly", "restart_requires_explicit_flag", "health_gate_for_running_service", "rollback_on_health_failure", "guarded_lanes_activated"],
      "properties": {
        "downgrade_allowed_by_default": {"const": false},
        "service_started_implicitly": {"const": false},
        "restart_requires_explicit_flag": {"const": true},
        "health_gate_for_running_service": {"const": true},
        "rollback_on_health_failure": {"const": true},
        "guarded_lanes_activated": {"const": false}
      }
    }
  }
}
