# VOID mainnet bootstrap PLAN env template
# NOTE: This file should NEVER contain real secrets in git. Copy it to a local
#       .env file and fill values there when you're ready.

# --- Core actors (addresses) ---

# Hardware OPS key (deployer + treasury/ops admins)
VOID_MAINNET_ADDR_HARDWARE_OPS_1=

# Hardware CORE key (AdminGate/UpdateGate/ConfigGate owner)
VOID_MAINNET_ADDR_HARDWARE_CORE_1=

# Hardware VALIDATOR key (validator admin + validator0 reward address)
VOID_MAINNET_ADDR_HARDWARE_VALIDATOR_1=

# --- Gate / core contracts (addresses) ---

VOID_MAINNET_ADDR_UPDATEGATE=
VOID_MAINNET_ADDR_ADMINGATE=
VOID_MAINNET_ADDR_CONFIGGATE=
VOID_MAINNET_ADDR_VALIDATORSET=

# --- Tokenomics / treasury contracts (addresses) ---

VOID_MAINNET_ADDR_VOIDTOKEN=
VOID_MAINNET_ADDR_PREMINEVAULT=
VOID_MAINNET_ADDR_TREASURY=
VOID_MAINNET_ADDR_VOIDTREASURY=
VOID_MAINNET_ADDR_OPSTREASURY=
VOID_MAINNET_ADDR_REWARDENGINE=

# --- Validator0 consensus key ---

# Public key for validator0 (BLS/ECDSA hex)
VOID_MAINNET_VALIDATOR0_CONSENSUS_KEY=
