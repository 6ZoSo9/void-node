{
  "schema": "void-tor-capability-parity-v1",
  "marker": "VOID_TOR_CAPABILITY_PARITY_V1",
  "version": 1,
  "status_scope": "source-policy-not-live-runtime",
  "doctrine": "Tor is a first-class policy-selectable VOID transport. Safe agent-visible capabilities target Tor parity; sensitive capabilities require separate review; private operator authority is never inherited from transport reachability.",
  "principles": {
    "tor_is_optional_for_node_survival": true,
    "tor_is_first_class_for_safe_agent_access": true,
    "clearnet_is_not_required_for_onion_workflows": true,
    "transport_does_not_expand_authority": true,
    "onion_identity_does_not_replace_void_node_identity": true,
    "signed_node_to_onion_binding_required": true,
    "generic_proxying_forbidden": true,
    "caller_selected_upstreams_forbidden": true,
    "private_keys_and_operator_routes_forbidden": true
  },
  "stages": [
    {
      "stage": 1,
      "name": "signed-read-only-parity",
      "objective": "Signed discovery, public evidence, and read-only MCP are available through one bounded onion origin.",
      "mutation_authority": false
    },
    {
      "stage": 2,
      "name": "authenticated-agent-commerce",
      "objective": "Authenticated paid-work submission, deterministic quote retrieval, and signed receipt retrieval operate through Tor without generic proxying.",
      "mutation_authority": "bounded-workflow-only"
    },
    {
      "stage": 3,
      "name": "reviewed-network-and-tor-contribution",
      "objective": "Separately reviewed P2P-over-Tor and verified Tor-capacity contribution lanes are introduced without weakening anonymity or core availability.",
      "mutation_authority": "separate-threat-model-required"
    }
  ],
