{
  "marker": "VOID_AGENT_PAID_WORK_SUBMISSION_INTAKE_CONFIG_V1",
  "version": 1,
  "enabled": false,
  "listen_host": "127.0.0.1",
  "listen_port": 4187,
  "request_path": "/__void/agents/paid-work/submissions/v1",
  "health_path": "/__void/agent-paid-work-submission-receiver-v1/health",
